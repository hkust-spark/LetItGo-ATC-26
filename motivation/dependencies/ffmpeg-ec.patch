+static int hevc_luma_dc_block_width(const HEVCSPS *sps)
+{
+    return (sps->width + 7) / 8;
+}
+
+static int hevc_luma_dc_block_height(const HEVCSPS *sps)
+{
+    return (sps->height + 7) / 8;
+}
+
+static int hevc_chroma_dc_block_width(const HEVCSPS *sps)
+{
+    return (sps->width + 15) / 16;
+}
+
+static int hevc_chroma_dc_block_height(const HEVCSPS *sps)
+{
+    return (sps->height + 15) / 16;
+}
+
+static int hevc_packet_loss_dc_block_count(const HEVCSPS *sps)
+{
+    return hevc_luma_dc_block_width(sps) * hevc_luma_dc_block_height(sps) +
+           2 * hevc_chroma_dc_block_width(sps) * hevc_chroma_dc_block_height(sps);
+}
+
+static int hevc_packet_loss_dc_index(const HEVCSPS *sps,
+                                     int component, int block_x, int block_y)
+{
+    const int luma_count = hevc_luma_dc_block_width(sps) * hevc_luma_dc_block_height(sps);
+    const int chroma_width = hevc_chroma_dc_block_width(sps);
+    const int chroma_count = chroma_width * hevc_chroma_dc_block_height(sps);
+
+    if (component == 0)
+        return block_y * hevc_luma_dc_block_width(sps) + block_x;
+    return luma_count + (component - 1) * chroma_count +
+           block_y * chroma_width + block_x;
+}
+
+static int hevc_visible_luma_extent(const HEVCSPS *sps, int luma_start,
+                                    int block_size)
+{
+    const int visible = sps->width - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int hevc_visible_luma_height(const HEVCSPS *sps, int luma_start,
+                                    int block_size)
+{
+    const int visible = sps->height - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int hevc_visible_chroma_extent(const HEVCSPS *sps, int component,
+                                      int luma_start, int block_size)
+{
+    const int shift = sps->hshift[component];
+    const int luma_stop = FFMIN(luma_start + block_size, sps->width);
+    const int chroma_start = luma_start >> shift;
+    const int chroma_stop = (luma_stop + (1 << shift) - 1) >> shift;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int hevc_visible_chroma_height(const HEVCSPS *sps, int component,
+                                      int luma_start, int block_size)
+{
+    const int shift = sps->vshift[component];
+    const int luma_stop = FFMIN(luma_start + block_size, sps->height);
+    const int chroma_start = luma_start >> shift;
+    const int chroma_stop = (luma_stop + (1 << shift) - 1) >> shift;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int hevc_scaled_block_mean(const uint8_t *src, ptrdiff_t stride,
+                                  int width, int height, int bytesperpixel)
+{
+    int64_t sample_sum = 0;
+    int sample_count = width * height;
+
+    if (src == NULL || width <= 0 || height <= 0)
+        return 1024;
+
+    for (int y = 0; y < height; y++) {
+        const uint8_t *row = src + (ptrdiff_t)y * stride;
+        for (int x = 0; x < width; x++) {
+            if (bytesperpixel == 1)
+                sample_sum += row[x];
+            else
+                sample_sum += AV_RN16(row + (ptrdiff_t)x * bytesperpixel);
+        }
+    }
+
+    return (int)((sample_sum * 8 + sample_count / 2) / sample_count);
+}
+
+static int hevc_frame_block_dc(const HEVCSPS *sps, const AVFrame *frame,
+                               int component, int block_x, int block_y)
+{
+    const int bytesperpixel = 1 << sps->pixel_shift;
+
+    if (component == 0) {
+        const int luma_x = block_x * 8;
+        const int luma_y = block_y * 8;
+        const int block_w = hevc_visible_luma_extent(sps, luma_x, 8);
+        const int block_h = hevc_visible_luma_height(sps, luma_y, 8);
+        return hevc_scaled_block_mean(
+            frame->data[0] + (ptrdiff_t)luma_y * frame->linesize[0] +
+            (ptrdiff_t)luma_x * bytesperpixel,
+            frame->linesize[0], block_w, block_h, bytesperpixel);
+    } else {
+        const int luma_x = block_x * 16;
+        const int luma_y = block_y * 16;
+        const int chroma_x = luma_x >> sps->hshift[component];
+        const int chroma_y = luma_y >> sps->vshift[component];
+        const int block_w = hevc_visible_chroma_extent(sps, component, luma_x, 16);
+        const int block_h = hevc_visible_chroma_height(sps, component, luma_y, 16);
+        return hevc_scaled_block_mean(
+            frame->data[component] + (ptrdiff_t)chroma_y * frame->linesize[component] +
+            (ptrdiff_t)chroma_x * bytesperpixel,
+            frame->linesize[component], block_w, block_h, bytesperpixel);
+    }
+}
