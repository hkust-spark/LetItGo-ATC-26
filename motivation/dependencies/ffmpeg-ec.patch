+static int vvc_prepare_guess_dc_storage(VVCFrameContext *fc)
+{
+    const int dc_block_count = vvc_packet_loss_dc_block_count(fc->ps.sps, fc->ps.pps);
+
+    if (dc_block_count <= 0)
+        return 0;
+
+    if (fc->packet_loss_pre_dc_count != dc_block_count) {
+        av_freep(&fc->packet_loss_pre_dc_valid);
+        av_freep(&fc->packet_loss_pre_dc);
+        fc->packet_loss_pre_dc_count = 0;
+    }
+
+    if (!fc->packet_loss_pre_dc_valid) {
+        fc->packet_loss_pre_dc_valid = av_mallocz(dc_block_count);
+        if (!fc->packet_loss_pre_dc_valid)
+            return AVERROR(ENOMEM);
+    }
+    if (!fc->packet_loss_pre_dc) {
+        fc->packet_loss_pre_dc = av_malloc_array(dc_block_count,
+                                                 sizeof(*fc->packet_loss_pre_dc));
+        if (!fc->packet_loss_pre_dc) {
+            av_freep(&fc->packet_loss_pre_dc_valid);
+            return AVERROR(ENOMEM);
+        }
+    }
+    fc->packet_loss_pre_dc_count = dc_block_count;
+    return 0;
+}
