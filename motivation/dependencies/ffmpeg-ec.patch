+static int aom_parse_packet_loss_int64(const char *value, int64_t *parsed)
+{
+    char *end = NULL;
+    long long temporary;
+
+    if (!value || !value[0])
+        return 0;
+
+    temporary = strtoll(value, &end, 10);
+    if (end == value || *end != '\0')
+        return 0;
+
+    *parsed = temporary;
+    return 1;
+}
+
+static void aom_update_packet_loss_range(AV1DecodeContext *ctx, const AVPacket *pkt)
+{
+    int64_t packet_pos = 0;
+    int64_t corrupt_packet_pos = 0;
+    int64_t corrupt_start = 0;
+    int64_t corrupt_end = 0;
+
+    ctx->packet_loss_corrupt_range_valid = 0;
+    ctx->packet_loss_corrupt_start = 0;
+    ctx->packet_loss_corrupt_end = 0;
+    ctx->packet_loss_packet_size = 0;
+
+    if (!pkt || pkt->pos < 0 || !pkt->data)
+        return;
+
+    packet_pos = pkt->pos;
+    if (!aom_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_PACKET_POS"), &corrupt_packet_pos) ||
+        !aom_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_REL_START"), &corrupt_start) ||
+        !aom_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_REL_END"), &corrupt_end)) {
+        return;
+    }
+    if (corrupt_packet_pos != packet_pos ||
+        corrupt_start < 0 || corrupt_end <= corrupt_start ||
+        corrupt_start >= pkt->size) {
+        return;
+    }
+
+    ctx->packet_loss_corrupt_range_valid = 1;
+    ctx->packet_loss_corrupt_start = corrupt_start;
+    ctx->packet_loss_corrupt_end = FFMIN(corrupt_end, pkt->size);
+    ctx->packet_loss_packet_size = pkt->size;
+}
