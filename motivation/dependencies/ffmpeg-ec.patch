+static void vp9_mark_all_damaged_sbs(VP9Context *s)
+{
+    if (s->packet_loss_sb_damage && s->sb_cols && s->sb_rows)
+        memset(s->packet_loss_sb_damage, 1, s->sb_cols * s->sb_rows);
+}
+
+static void vp9_set_error_block_metadata(VP9Context *s, AVFrame *frame)
+{
+    int total_blocks = s->sb_cols * s->sb_rows;
+    int damaged_blocks = 0;
+
+    if (!frame || !s->packet_loss_sb_damage || total_blocks <= 0)
+        return;
+
+    for (int i = 0; i < total_blocks; i++)
+        damaged_blocks += !!s->packet_loss_sb_damage[i];
+
+    if (damaged_blocks > 0) {
+        frame->flags |= AV_FRAME_FLAG_CORRUPT;
+        frame->decode_error_flags |= FF_DECODE_ERROR_DECODE_SLICES |
+                                     FF_DECODE_ERROR_CONCEALMENT_ACTIVE;
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "SB", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", 64, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", 64, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_sb_count", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", 0, 0);
+}
