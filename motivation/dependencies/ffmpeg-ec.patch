+static void vp9_mark_damaged_sbs(VP9Context *s, int start_row, int start_col,
+                                 int tile_row_end, int tile_col_start,
+                                 int tile_col_end)
+{
+    int start_sb_row, start_sb_col, end_sb_row, start_tile_sb_col, end_tile_sb_col;
+
+    if (!s->packet_loss_sb_damage || !s->sb_cols || !s->sb_rows)
+        return;
+
+    start_sb_row = FFMIN(FFMAX(start_row >> 3, 0), s->sb_rows);
+    start_sb_col = FFMIN(FFMAX(start_col >> 3, 0), s->sb_cols);
+    end_sb_row = FFMIN(FFMAX(tile_row_end >> 3, 0), s->sb_rows);
+    start_tile_sb_col = FFMIN(FFMAX(tile_col_start >> 3, 0), s->sb_cols);
+    end_tile_sb_col = FFMIN(FFMAX(tile_col_end >> 3, 0), s->sb_cols);
+
+    for (int sb_row = start_sb_row; sb_row < end_sb_row; sb_row++) {
+        int first_sb_col = sb_row == start_sb_row ? start_sb_col : start_tile_sb_col;
+
+        if (first_sb_col < end_tile_sb_col) {
+            memset(s->packet_loss_sb_damage + sb_row * s->sb_cols + first_sb_col,
+                   1, end_tile_sb_col - first_sb_col);
+        }
+    }
+}
+
+static void vp9_mark_damaged_tile(VP9Context *s, int tile_row_start,
+                                  int tile_row_end, int tile_col_start,
+                                  int tile_col_end)
