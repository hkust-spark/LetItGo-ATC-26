+
+    if (s->packet_loss_guess_mv_valid == NULL ||
+        s->packet_loss_guess_mv_x == NULL ||
+        s->packet_loss_guess_mv_y == NULL ||
+        s->packet_loss_guess_mv_ref == NULL ||
+        mb_x < 0 || mb_y < 0 || mb_x >= s->mb_width || mb_y >= s->mb_height)
+        return;
+
+    if (mb->ref_frame == VP8_FRAME_CURRENT) {
+        s->packet_loss_guess_mv_valid[index] = 0;
+        return;
+    }
+
+    s->packet_loss_guess_mv_valid[index] = 1;
+    s->packet_loss_guess_mv_x[index] = mb->mv.x;
+    s->packet_loss_guess_mv_y[index] = mb->mv.y;
+    s->packet_loss_guess_mv_ref[index] = mb->ref_frame;
