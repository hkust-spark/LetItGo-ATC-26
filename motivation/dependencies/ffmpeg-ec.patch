+static void vvc_set_error_block_metadata_on_frame(VVCFrameContext *fc, AVFrame *frame, int force_full_frame)
+{
+    int total_blocks = 0;
+    int damaged_blocks = 0;
+    int concealed_blocks = 0;
+    int inter_concealed_blocks = 0;
+
+    if (!frame || !fc->ps.sps || !fc->ps.pps)
+        return;
+
+    total_blocks = fc->ps.pps->ctb_count;
+    if (force_full_frame || !fc->tab.ec_status) {
+        damaged_blocks = total_blocks;
+        concealed_blocks = total_blocks;
+    } else {
+        for (int i = 0; i < total_blocks; i++) {
+            const uint8_t status = fc->tab.ec_status[i];
+            if (status & VVC_EC_CTU_DAMAGED)
+                damaged_blocks++;
+            if (status & VVC_EC_CTU_CONCEALED)
+                concealed_blocks++;
+            if (status & VVC_EC_CTU_INTER_CONCEALED)
+                inter_concealed_blocks++;
+        }
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "CTU", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", fc->ps.sps->ctb_size_y, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", fc->ps.sps->ctb_size_y, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", concealed_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", inter_concealed_blocks, 0);
+}
