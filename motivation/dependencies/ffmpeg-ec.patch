+void ff_vvc_record_pre_filter_ctu_dc(VVCFrameContext *fc, int rx, int ry)
+{
+    const VVCSPS *sps = fc->ps.sps;
+    const VVCPPS *pps = fc->ps.pps;
+    const AVFrame *frame = fc->ref ? fc->ref->frame : NULL;
+    const int ctb_size = sps ? sps->ctb_size_y : 0;
+    const int ctb_addr_rs = pps ? ry * pps->ctb_width + rx : -1;
+
+    if (!vvc_guess_dc_telemetry_enabled() ||
+        fc->packet_loss_pre_dc == NULL ||
+        fc->packet_loss_pre_dc_valid == NULL ||
+        sps == NULL || pps == NULL ||
+        frame == NULL || frame->data[0] == NULL ||
+        rx < 0 || ry < 0 || rx >= pps->ctb_width || ry >= pps->ctb_height ||
+        ctb_addr_rs < 0 || ctb_addr_rs >= pps->ctb_count ||
+        (fc->tab.ec_status[ctb_addr_rs] & VVC_EC_CTU_DAMAGED))
+        return;
+
+    for (int block_y = (ry * ctb_size) / 8;
+         block_y < FFMIN(((ry + 1) * ctb_size) / 8, vvc_luma_dc_block_height(pps));
+         block_y++) {
+        for (int block_x = (rx * ctb_size) / 8;
+             block_x < FFMIN(((rx + 1) * ctb_size) / 8, vvc_luma_dc_block_width(pps));
+             block_x++) {
+            const int index = vvc_packet_loss_dc_index(pps, 0, block_x, block_y);
+            fc->packet_loss_pre_dc[index] = vvc_frame_block_dc(sps, pps, frame, 0, block_x, block_y);
+            fc->packet_loss_pre_dc_valid[index] = 1;
+        }
+    }
+
+    for (int component = 1; component < 3; component++) {
+        const int chroma_block_y_start = (ry * ctb_size) / 16;
+        const int chroma_block_x_start = (rx * ctb_size) / 16;
+        const int chroma_block_y_stop = FFMIN(((ry + 1) * ctb_size) / 16,
+                                              vvc_chroma_dc_block_height(pps));
+        const int chroma_block_x_stop = FFMIN(((rx + 1) * ctb_size) / 16,
+                                              vvc_chroma_dc_block_width(pps));
+
+        if (frame->data[component] == NULL)
+            continue;
+
+        for (int block_y = chroma_block_y_start; block_y < chroma_block_y_stop; block_y++) {
+            for (int block_x = chroma_block_x_start; block_x < chroma_block_x_stop; block_x++) {
+                const int index = vvc_packet_loss_dc_index(pps, component, block_x, block_y);
+                fc->packet_loss_pre_dc[index] = vvc_frame_block_dc(
+                    sps, pps, frame, component, block_x, block_y);
+                fc->packet_loss_pre_dc_valid[index] = 1;
+            }
+        }
+    }
+}
