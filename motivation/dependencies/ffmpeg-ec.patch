+static void vp8_record_pre_filter_dc(VP8Context *s, uint8_t *const dst[3],
+                                     int mb_x, int mb_y)
+{
+    if (!vp8_guess_dc_telemetry_enabled() ||
+        s->packet_loss_vp8_pre_dc == NULL ||
+        s->packet_loss_vp8_pre_dc_valid == NULL)
+        return;
+
+    for (int y = 0; y < 2; y++) {
+        const int luma_y = mb_y * 16 + y * 8;
+        const int block_h = vp8_visible_luma_height(s, luma_y, 8);
+        for (int x = 0; x < 2; x++) {
+            const int luma_x = mb_x * 16 + x * 8;
+            const int block_w = vp8_visible_luma_extent(s, luma_x, 8);
+            if (block_w > 0 && block_h > 0) {
+                const int index = vp8_packet_loss_dc_index(
+                    s, 0, mb_x * 2 + x, mb_y * 2 + y);
+                s->packet_loss_vp8_pre_dc[index] = vp8_scaled_block_mean(
+                    dst[0] + (ptrdiff_t)y * 8 * s->linesize + x * 8,
+                    s->linesize, block_w, block_h);
+                s->packet_loss_vp8_pre_dc_valid[index] = 1;
+            }
+        }
+    }
+
+    for (int component = 1; component < 3; component++) {
+        const int luma_x = mb_x * 16;
+        const int luma_y = mb_y * 16;
+        const int block_w = vp8_visible_chroma_extent(s, luma_x, 16);
+        const int block_h = vp8_visible_chroma_height(s, luma_y, 16);
+        if (block_w > 0 && block_h > 0) {
+            const int index = vp8_packet_loss_dc_index(s, component, mb_x, mb_y);
+            s->packet_loss_vp8_pre_dc[index] = vp8_scaled_block_mean(
+                dst[component], s->uvlinesize, block_w, block_h);
+            s->packet_loss_vp8_pre_dc_valid[index] = 1;
+        }
+    }
+}
+
+static int vp8_frame_block_dc(const VP8Context *s, const AVFrame *frame,
+                              int component, int block_x, int block_y)
+{
+    if (component == 0) {
+        const int luma_x = block_x * 8;
+        const int luma_y = block_y * 8;
+        const int block_w = vp8_visible_luma_extent(s, luma_x, 8);
+        const int block_h = vp8_visible_luma_height(s, luma_y, 8);
+        return vp8_scaled_block_mean(
+            frame->data[0] + (ptrdiff_t)luma_y * frame->linesize[0] + luma_x,
+            frame->linesize[0], block_w, block_h);
+    } else {
+        const int luma_x = block_x * 16;
+        const int luma_y = block_y * 16;
+        const int chroma_x = luma_x >> 1;
+        const int chroma_y = luma_y >> 1;
+        const int block_w = vp8_visible_chroma_extent(s, luma_x, 16);
+        const int block_h = vp8_visible_chroma_height(s, luma_y, 16);
+        return vp8_scaled_block_mean(
+            frame->data[component] +
+            (ptrdiff_t)chroma_y * frame->linesize[component] + chroma_x,
+            frame->linesize[component], block_w, block_h);
+    }
+}
+
+static int vp8_emit_guess_dc_component_records(VP8Context *s,
+                                               const AVFrame *frame,
+                                               int component)
+{
+    const int block_width = component == 0 ? (s->avctx->width + 7) / 8
+                                          : (s->avctx->width + 15) / 16;
+    const int block_height = component == 0 ? (s->avctx->height + 7) / 8
+                                           : (s->avctx->height + 15) / 16;
+    const int block_count = block_width * block_height;
+    int16_t *dc = NULL;
+    uint8_t *damaged = NULL;
+    int ret = 0;
+
+    if (block_count <= 0)
+        return 0;
+
+    dc = av_malloc_array(block_count, sizeof(*dc));
+    damaged = av_mallocz(block_count);
+    if (dc == NULL || damaged == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+
+            dc[index] = vp8_frame_block_dc(s, frame, component, block_x, block_y);
+            if (mb_x < s->mb_width && mb_y < s->mb_height)
+                damaged[index] = !!s->packet_loss_mb_damage[mb_y * s->mb_width + mb_x];
+        }
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+            int dist[4] = { 9999, 9999, 9999, 9999 };
+            int boundary_dc[4] = { 1024, 1024, 1024, 1024 };
+            int64_t weight[4];
+            int pre_guess_dc = VP8_PACKET_LOSS_PRE_GUESS_DC_UNAVAILABLE;
+            int pre_index = -1;
+
+            if (!damaged[index])
+                continue;
+
+            for (int x = block_x + 1; x < block_width; x++) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[0] = x - block_x;
+                    boundary_dc[0] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int x = block_x - 1; x >= 0; x--) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[1] = block_x - x;
+                    boundary_dc[1] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y + 1; y < block_height; y++) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[2] = y - block_y;
+                    boundary_dc[2] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y - 1; y >= 0; y--) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[3] = block_y - y;
+                    boundary_dc[3] = dc[neighbor];
+                    break;
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                weight[i] = 256LL * 256LL * 256LL * 16LL / FFMAX(dist[i], 1);
+
+            pre_index = vp8_packet_loss_dc_index(s, component, block_x, block_y);
+            if (s->packet_loss_vp8_pre_dc_valid != NULL &&
+                s->packet_loss_vp8_pre_dc != NULL &&
+                pre_index >= 0 && pre_index < vp8_packet_loss_dc_block_count(s) &&
+                s->packet_loss_vp8_pre_dc_valid[pre_index]) {
+                pre_guess_dc = s->packet_loss_vp8_pre_dc[pre_index];
+            }
+
+            ret = vp8_append_guess_dc_record(
+                s,
+                "%d,%d,%d,%d,%d,%d,%d,%d,%d,%" PRId64 ",%" PRId64
+                ",%" PRId64 ",%" PRId64 ",%d,%d,%d,%d,%d,%d\n",
+                component,
+                block_x,
+                block_y,
+                mb_x,
+                mb_y,
+                dist[0],
+                dist[1],
+                dist[2],
+                dist[3],
+                weight[0],
+                weight[1],
+                weight[2],
+                weight[3],
+                boundary_dc[0],
+                boundary_dc[1],
+                boundary_dc[2],
+                boundary_dc[3],
+                dc[index],
+                pre_guess_dc
+            );
+            if (ret < 0)
+                goto done;
+        }
+    }
+
+done:
+    av_freep(&dc);
+    av_freep(&damaged);
+    return ret;
+}
+
+static int vp8_set_guess_dc_metadata(VP8Context *s, AVFrame *frame)
+{
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vp8_reset_guess_dc_records(s);
+    if (frame != NULL)
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records", NULL, 0);
+
+    if (!vp8_guess_dc_telemetry_enabled() || frame == NULL ||
+        s->packet_loss_mb_damage == NULL ||
+        frame->data[0] == NULL || frame->data[1] == NULL || frame->data[2] == NULL)
+        return 0;
+
+    for (int i = 0; i < s->mb_width * s->mb_height; i++)
+        damaged_blocks += !!s->packet_loss_mb_damage[i];
+    if (damaged_blocks <= 0)
+        return 0;
+
+    for (int component = 0; component < 3; component++) {
+        ret = vp8_emit_guess_dc_component_records(s, frame, component);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (s->packet_loss_guess_dc_records != NULL &&
+        s->packet_loss_guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
+                    s->packet_loss_guess_dc_records, 0);
+    }
+
+    return 0;
+}
+
+enum {
+    VP8_GUESS_MV_UNKNOWN = 0,
+    VP8_GUESS_MV_LISTED  = 1,
+    VP8_GUESS_MV_FIXED   = 2,
+};
+
+static void vp8_guess_mv_add_frontier_cell(uint8_t *state,
+                                           const uint8_t *damaged,
+                                           int *frontier,
+                                           int *frontier_length,
+                                           int mb_width, int mb_height,
+                                           int mb_x, int mb_y)
+{
+    int index;
+
+    if (mb_x < 0 || mb_y < 0 || mb_x >= mb_width || mb_y >= mb_height)
+        return;
+
+    index = mb_y * mb_width + mb_x;
+    if (!damaged[index] || state[index] != VP8_GUESS_MV_UNKNOWN)
+        return;
+
+    state[index] = VP8_GUESS_MV_LISTED;
+    frontier[(*frontier_length)++] = index;
+}
+
+static void vp8_guess_mv_add_frontier_neighbors(uint8_t *state,
+                                                const uint8_t *damaged,
+                                                int *frontier,
+                                                int *frontier_length,
+                                                int mb_width, int mb_height,
+                                                int index)
+{
+    const int mb_x = index % mb_width;
+    const int mb_y = index / mb_width;
+
+    vp8_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x - 1, mb_y);
+    vp8_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x + 1, mb_y);
+    vp8_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y - 1);
+    vp8_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y + 1);
+}
+
+static int vp8_emit_guess_mv_truth_records(VP8Context *s)
+{
+    const int mb_count = s->mb_width * s->mb_height;
+    int ret = 0;
+
+    if (s->packet_loss_guess_mv_valid == NULL ||
+        s->packet_loss_guess_mv_x == NULL ||
+        s->packet_loss_guess_mv_y == NULL ||
+        s->packet_loss_guess_mv_ref == NULL)
+        return 0;
+
+    for (int index = 0; index < mb_count; index++) {
+        const int mb_x = index % s->mb_width;
+        const int mb_y = index / s->mb_width;
+
+        if (!s->packet_loss_guess_mv_valid[index])
+            continue;
+
+        ret = vp8_append_guess_mv_record(
+            s, "%d,%d,%d,%d,%d,4\n",
+            mb_x, mb_y,
+            s->packet_loss_guess_mv_x[index],
+            s->packet_loss_guess_mv_y[index],
+            s->packet_loss_guess_mv_ref[index]);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+static int vp8_emit_guess_mv_bfs_records(VP8Context *s)
+{
+    const int mb_width = s->mb_width;
+    const int mb_height = s->mb_height;
+    const int mb_count = mb_width * mb_height;
+    uint8_t *state = NULL;
+    uint8_t *damaged = NULL;
+    int *mv_x = NULL;
+    int *mv_y = NULL;
+    int *ref_idx = NULL;
+    int *frontier = NULL;
+    int *next_frontier = NULL;
+    int *newly_fixed = NULL;
+    int frontier_length = 0;
+    int ret = 0;
+
+    if (mb_count <= 0 ||
+        s->packet_loss_mb_damage == NULL ||
+        s->packet_loss_guess_mv_valid == NULL ||
+        s->packet_loss_guess_mv_x == NULL ||
+        s->packet_loss_guess_mv_y == NULL ||
+        s->packet_loss_guess_mv_ref == NULL)
+        return 0;
+
+    state = av_mallocz(mb_count);
+    damaged = av_mallocz(mb_count);
+    mv_x = av_malloc_array(mb_count, sizeof(*mv_x));
+    mv_y = av_malloc_array(mb_count, sizeof(*mv_y));
+    ref_idx = av_malloc_array(mb_count, sizeof(*ref_idx));
+    frontier = av_malloc_array(mb_count, sizeof(*frontier));
+    next_frontier = av_malloc_array(mb_count, sizeof(*next_frontier));
+    newly_fixed = av_malloc_array(mb_count, sizeof(*newly_fixed));
+    if (state == NULL || damaged == NULL || mv_x == NULL || mv_y == NULL ||
+        ref_idx == NULL || frontier == NULL || next_frontier == NULL ||
+        newly_fixed == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int index = 0; index < mb_count; index++) {
+        damaged[index] = !!s->packet_loss_mb_damage[index];
+        if (!damaged[index] && s->packet_loss_guess_mv_valid[index]) {
+            state[index] = VP8_GUESS_MV_FIXED;
+            mv_x[index] = s->packet_loss_guess_mv_x[index];
+            mv_y[index] = s->packet_loss_guess_mv_y[index];
+            ref_idx[index] = s->packet_loss_guess_mv_ref[index];
+        }
+    }
+
+    for (int index = 0; index < mb_count; index++) {
+        if (state[index] == VP8_GUESS_MV_FIXED)
+            vp8_guess_mv_add_frontier_neighbors(state, damaged, frontier,
+                                                &frontier_length, mb_width,
+                                                mb_height, index);
+    }
+
+    for (int hop_count = 1; frontier_length > 0; hop_count++) {
+        int next_frontier_length = 0;
+        int newly_fixed_length = 0;
+
+        for (int frontier_index = 0; frontier_index < frontier_length; frontier_index++) {
+            const int index = frontier[frontier_index];
+            const int mb_x = index % mb_width;
+            const int mb_y = index / mb_width;
+            int pred_count = 0;
+            int sum_x = 0;
+            int sum_y = 0;
+            int sum_ref = 0;
+
+#define VP8_ACCUM_FIXED_MV(nx, ny) do {                                       \
+                const int neighbor_x = (nx);                                  \
+                const int neighbor_y = (ny);                                  \
+                if (neighbor_x >= 0 && neighbor_y >= 0 &&                     \
+                    neighbor_x < mb_width && neighbor_y < mb_height) {        \
+                    const int neighbor_index =                                \
+                        neighbor_y * mb_width + neighbor_x;                   \
+                    if (state[neighbor_index] == VP8_GUESS_MV_FIXED) {        \
+                        sum_x += mv_x[neighbor_index];                        \
+                        sum_y += mv_y[neighbor_index];                        \
+                        sum_ref += ref_idx[neighbor_index];                   \
+                        pred_count++;                                         \
+                    }                                                         \
+                }                                                             \
+            } while (0)
+
+            VP8_ACCUM_FIXED_MV(mb_x - 1, mb_y);
+            VP8_ACCUM_FIXED_MV(mb_x + 1, mb_y);
+            VP8_ACCUM_FIXED_MV(mb_x, mb_y - 1);
+            VP8_ACCUM_FIXED_MV(mb_x, mb_y + 1);
+#undef VP8_ACCUM_FIXED_MV
+
+            if (pred_count <= 0) {
+                state[index] = VP8_GUESS_MV_UNKNOWN;
+                continue;
+            }
+
+            mv_x[index] = sum_x / pred_count;
+            mv_y[index] = sum_y / pred_count;
+            ref_idx[index] = sum_ref / pred_count;
+            ret = vp8_append_guess_mv_record(s, "%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                                             mb_x, mb_y, hop_count, 0,
+                                             pred_count, mv_x[index],
+                                             mv_y[index], ref_idx[index], -1);
+            if (ret < 0)
+                goto done;
+
+            newly_fixed[newly_fixed_length++] = index;
+        }
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            state[newly_fixed[i]] = VP8_GUESS_MV_FIXED;
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            vp8_guess_mv_add_frontier_neighbors(state, damaged, next_frontier,
+                                                &next_frontier_length, mb_width,
+                                                mb_height, newly_fixed[i]);
+
+        FFSWAP(int *, frontier, next_frontier);
+        frontier_length = next_frontier_length;
+    }
+
+done:
+    av_freep(&state);
+    av_freep(&damaged);
+    av_freep(&mv_x);
+    av_freep(&mv_y);
+    av_freep(&ref_idx);
+    av_freep(&frontier);
+    av_freep(&next_frontier);
+    av_freep(&newly_fixed);
+    return ret;
+}
+
+static int vp8_set_guess_mv_metadata(VP8Context *s, AVFrame *frame)
+{
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vp8_reset_guess_mv_records(s);
+    if (frame != NULL) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_records", NULL, 0);
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    }
+
+    if (frame == NULL || s->packet_loss_mb_damage == NULL)
+        return 0;
+
+    if (vp8_guess_mv_truth_enabled()) {
+        ret = vp8_emit_guess_mv_truth_records(s);
+        if (ret < 0)
+            return ret;
+        if (s->packet_loss_guess_mv_records != NULL &&
+            s->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records",
+                        s->packet_loss_guess_mv_records, 0);
+        }
+        vp8_reset_guess_mv_records(s);
+    }
+
+    if (vp8_guess_mv_telemetry_enabled()) {
+        for (int i = 0; i < s->mb_width * s->mb_height; i++)
+            damaged_blocks += !!s->packet_loss_mb_damage[i];
+        if (damaged_blocks > 0) {
+            ret = vp8_emit_guess_mv_bfs_records(s);
+            if (ret < 0)
+                return ret;
+            if (s->packet_loss_guess_mv_records != NULL &&
+                s->packet_loss_guess_mv_records_size > 0) {
+                av_dict_set(&frame->metadata, "packet_loss.guess_mv_records",
+                            s->packet_loss_guess_mv_records, 0);
+            }
+        }
+    }
+
+    return 0;
+}
+
+static void vp8_mark_damaged_mbs(VP8Context *s, int start_mb_y,
+                                 int start_mb_x, int row_step)
+{
+    int mark_single_row = row_step <= 0;
+
+    if (!s->packet_loss_mb_damage || start_mb_y < 0 || start_mb_y >= s->mb_height)
+        return;
+
+    row_step = FFMAX(row_step, 1);
+    start_mb_x = av_clip(start_mb_x, 0, s->mb_width);
+
+    for (int mb_y = start_mb_y; mb_y < s->mb_height; mb_y += row_step) {
+        int first_mb_x = mb_y == start_mb_y ? start_mb_x : 0;
+        if (first_mb_x < s->mb_width) {
+            memset(s->packet_loss_mb_damage + mb_y * s->mb_width + first_mb_x,
+                   1, s->mb_width - first_mb_x);
+        }
+        if (mark_single_row)
+            break;
+    }
+}
+
+static void vp8_set_error_block_metadata(VP8Context *s, AVFrame *frame)
+{
+    int total_blocks = s->mb_width * s->mb_height;
+    int damaged_blocks = 0;
+
+    if (!frame || !s->packet_loss_mb_damage || total_blocks <= 0)
+        return;
+
+    for (int i = 0; i < total_blocks; i++)
+        damaged_blocks += !!s->packet_loss_mb_damage[i];
+
+    if (damaged_blocks > 0) {
+        frame->flags |= AV_FRAME_FLAG_CORRUPT;
+        frame->decode_error_flags |= FF_DECODE_ERROR_DECODE_SLICES |
+                                     FF_DECODE_ERROR_CONCEALMENT_ACTIVE;
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "MB", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", 16, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", 16, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_mb_count", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", 0, 0);
+}
