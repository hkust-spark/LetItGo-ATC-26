+static unsigned ec_get_sample(const uint8_t *src, const int ps)
+{
+    return ps ? AV_RN16(src) : *src;
+}
+
+static void ec_set_sample(uint8_t *dst, const int ps, const unsigned v)
+{
+    if (ps)
+        AV_WN16(dst, v);
+    else
+        *dst = v;
+}
+
+static void ec_fill_plane(VVCLocalContext *lc, const int x0, const int y0,
+    const int c_idx)
+{
+    VVCFrameContext *fc = lc->fc;
+    const VVCSPS *sps   = fc->ps.sps;
+    const VVCPPS *pps   = fc->ps.pps;
+    const int hs        = sps->hshift[c_idx];
+    const int vs        = sps->vshift[c_idx];
+    const int ps        = sps->pixel_shift;
+    const int x         = x0 >> hs;
+    const int y         = y0 >> vs;
+    const int x_end     = AV_CEIL_RSHIFT(FFMIN(x0 + sps->ctb_size_y, pps->width),  hs);
+    const int y_end     = AV_CEIL_RSHIFT(FFMIN(y0 + sps->ctb_size_y, pps->height), vs);
+    const int width     = x_end - x;
+    const int height    = y_end - y;
+    const int neutral   = 1 << (sps->bit_depth - 1);
+    const ptrdiff_t stride = fc->frame->linesize[c_idx];
+    uint8_t *dst        = fc->frame->data[c_idx] + y * stride + (x << ps);
+
+    for (int yy = 0; yy < height; yy++) {
+        uint8_t *row = dst + yy * stride;
+
+        for (int xx = 0; xx < width; xx++) {
+            uint8_t *sample = row + (xx << ps);
+            unsigned sum = 0;
+            int count = 0;
+
+            if (x + xx > 0) {
+                sum += ec_get_sample(sample - (1 << ps), ps);
+                count++;
+            }
+            if (y + yy > 0) {
+                sum += ec_get_sample(sample - stride, ps);
+                count++;
+            }
+            ec_set_sample(sample, ps, count ? (sum + (count >> 1)) / count : neutral);
+        }
+    }
+}
+
+static void ec_smooth_plane(VVCLocalContext *lc, const int x0, const int y0,
+    const int c_idx)
+{
+    VVCFrameContext *fc = lc->fc;
+    const VVCSPS *sps   = fc->ps.sps;
+    const VVCPPS *pps   = fc->ps.pps;
+    const int hs        = sps->hshift[c_idx];
+    const int vs        = sps->vshift[c_idx];
+    const int ps        = sps->pixel_shift;
+    const int x         = x0 >> hs;
+    const int y         = y0 >> vs;
+    const int x_end     = AV_CEIL_RSHIFT(FFMIN(x0 + sps->ctb_size_y, pps->width),  hs);
+    const int y_end     = AV_CEIL_RSHIFT(FFMIN(y0 + sps->ctb_size_y, pps->height), vs);
+    const int width     = x_end - x;
+    const int height    = y_end - y;
+    const ptrdiff_t stride = fc->frame->linesize[c_idx];
+    uint8_t *dst        = fc->frame->data[c_idx] + y * stride + (x << ps);
+
+    if (x > 0) {
+        for (int yy = 0; yy < height; yy++) {
+            uint8_t *sample = dst + yy * stride;
+            const unsigned cur = ec_get_sample(sample, ps);
+            const unsigned left = ec_get_sample(sample - (1 << ps), ps);
+
+            ec_set_sample(sample, ps, (3 * cur + left + 2) >> 2);
+        }
+    }
+
+    if (y > 0) {
+        for (int xx = 0; xx < width; xx++) {
+            uint8_t *sample = dst + (xx << ps);
+            const unsigned cur = ec_get_sample(sample, ps);
+            const unsigned top = ec_get_sample(sample - stride, ps);
+
+            ec_set_sample(sample, ps, (3 * cur + top + 2) >> 2);
+        }
+    }
+}
