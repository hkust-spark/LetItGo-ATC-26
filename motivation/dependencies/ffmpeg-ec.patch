+        resized = av_realloc(s->packet_loss_guess_dc_records, new_capacity);
+        if (resized == NULL) {
+            va_end(args_copy);
+            return AVERROR(ENOMEM);
+        }
+        s->packet_loss_guess_dc_records = resized;
+        s->packet_loss_guess_dc_records_capacity = new_capacity;
+    }
+
+    vsnprintf(s->packet_loss_guess_dc_records +
+              s->packet_loss_guess_dc_records_size,
+              s->packet_loss_guess_dc_records_capacity -
+              s->packet_loss_guess_dc_records_size,
