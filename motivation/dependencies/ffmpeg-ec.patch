+
+    if (aom_codec_control(&ctx->decoder, AOMD_GET_SB_SIZE, &sb_size) == AOM_CODEC_OK &&
+        sb_size == AOM_SUPERBLOCK_SIZE_128X128) {
+        return 128;
+    }
+#endif
+    return 64;
+}
+
+static int aom_get_total_superblocks(AV1DecodeContext *ctx,
+                                     const struct aom_image *img,
+                                     int sb_size)
+{
+#ifdef AOM_CTRL_AOMD_GET_TILE_INFO
+    aom_tile_info tile_info;
+
+    memset(&tile_info, 0, sizeof(tile_info));
+    if (aom_codec_control(&ctx->decoder, AOMD_GET_TILE_INFO, &tile_info) == AOM_CODEC_OK &&
+        tile_info.tile_columns > 0 && tile_info.tile_rows > 0) {
+        int total_blocks = 0;
+
+        for (int tile_row = 0; tile_row < tile_info.tile_rows; tile_row++) {
+            for (int tile_col = 0; tile_col < tile_info.tile_columns; tile_col++)
+                total_blocks += tile_info.tile_widths[tile_col] * tile_info.tile_heights[tile_row];
+        }
+        if (total_blocks > 0)
+            return total_blocks;
+    }
+#endif
+
+    return ((img->d_w + sb_size - 1) / sb_size) *
+           ((img->d_h + sb_size - 1) / sb_size);
+}
+
+static int aom_get_damaged_start_superblock(AV1DecodeContext *ctx,
+                                            int total_blocks)
+{
+    int start_block = total_blocks;
+
+    if (ctx->packet_loss_corrupt_range_valid &&
+        ctx->packet_loss_packet_size > 0 && total_blocks > 0) {
+        start_block = (int)(((int64_t)ctx->packet_loss_corrupt_start *
+                             total_blocks) / ctx->packet_loss_packet_size);
+        start_block = av_clip(start_block, 0, total_blocks);
+    }
+
+    return start_block;
+}
+
+static void aom_set_error_block_metadata(AV1DecodeContext *ctx,
+                                         AVFrame *frame,
+                                         const struct aom_image *img)
+{
+    int sb_size = aom_get_superblock_size(ctx);
+    int total_blocks = aom_get_total_superblocks(ctx, img, sb_size);
+    int start_block = aom_get_damaged_start_superblock(ctx, total_blocks);
+    int damaged_blocks = 0;
+
+    if (!frame || total_blocks <= 0)
+        return;
+
+    damaged_blocks = total_blocks - start_block;
+
+    if (damaged_blocks > 0) {
+        frame->flags |= AV_FRAME_FLAG_CORRUPT;
+        frame->decode_error_flags |= FF_DECODE_ERROR_DECODE_SLICES |
+                                     FF_DECODE_ERROR_CONCEALMENT_ACTIVE;
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "SB", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", sb_size, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", sb_size, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_sb_count", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", 0, 0);
+}
