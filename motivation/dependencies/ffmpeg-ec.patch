+static void reset_guess_dc_records(ERContext *s)
+{
+    if (s->guess_dc_records != NULL && s->guess_dc_records_capacity > 0)
+        s->guess_dc_records[0] = '\0';
+    s->guess_dc_records_size = 0;
+}
+
+static void reset_guess_mv_records(ERContext *s)
+{
+    if (s->guess_mv_records != NULL && s->guess_mv_records_capacity > 0)
+        s->guess_mv_records[0] = '\0';
+    s->guess_mv_records_size = 0;
+}
+
+static int append_guess_dc_record(ERContext *s, const char *format, ...)
+{
+    va_list args;
+    va_list args_copy;
+    int required = 0;
+    size_t new_size = 0;
+
+    if (!guess_dc_telemetry_enabled())
+        return 0;
+
+    va_start(args, format);
+    va_copy(args_copy, args);
+    required = vsnprintf(NULL, 0, format, args);
+    va_end(args);
+    if (required < 0) {
+        va_end(args_copy);
+        return AVERROR(EINVAL);
+    }
+
+    new_size = s->guess_dc_records_size + (size_t)required;
+    if (new_size + 1 > s->guess_dc_records_capacity) {
+        size_t new_capacity = s->guess_dc_records_capacity ? s->guess_dc_records_capacity * 2 : 4096;
+        char *resized = NULL;
+        while (new_capacity < new_size + 1)
+            new_capacity *= 2;
+        resized = av_realloc(s->guess_dc_records, new_capacity);
+        if (resized == NULL) {
+            va_end(args_copy);
+            return AVERROR(ENOMEM);
+        }
+        s->guess_dc_records = resized;
+        s->guess_dc_records_capacity = new_capacity;
+    }
+
+    vsnprintf(s->guess_dc_records + s->guess_dc_records_size,
+              s->guess_dc_records_capacity - s->guess_dc_records_size,
+              format,
+              args_copy);
+    va_end(args_copy);
+    s->guess_dc_records_size = new_size;
+    return 0;
+}
