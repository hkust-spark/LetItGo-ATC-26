+static void h264_set_error_block_metadata(H264Context *h)
+{
+#if CONFIG_ERROR_RESILIENCE
+    AVFrame *frame = h->cur_pic_ptr ? h->cur_pic_ptr->f : NULL;
+    int total_blocks = 0;
+    int damaged_blocks = 0;
+    int er_damaged_mb_count = 0;
+    int er_origin_mb_x = -1;
+    int er_origin_mb_y = -1;
+
+    /* Frame threads may copy this picture after ff_thread_finish_setup().
+     * Only attach diagnostics when its metadata is not shared with them. */
+    if (h->avctx->active_thread_type & FF_THREAD_FRAME)
+        return;
+
+    if (!frame || !h->er.error_status_table || h->mb_width <= 0 || h->mb_height <= 0)
+        return;
+
+    total_blocks = h->mb_width * h->mb_height;
+    for (int mb_y = 0; mb_y < h->mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < h->mb_width; mb_x++) {
+            const int mb_xy = mb_x + mb_y * h->er.mb_stride;
+            const int error = h->er.error_status_table[mb_xy];
+            if (h->er.error_status_table[mb_xy] & ER_MB_ERROR)
+                damaged_blocks++;
+            if (error & (ER_MB_ERROR | ER_MV_ERROR)) {
+                er_damaged_mb_count++;
+                if (er_origin_mb_x < 0) {
+                    er_origin_mb_x = mb_x;
+                    er_origin_mb_y = mb_y;
+                }
+            }
+        }
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "MB", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", 16, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", 16, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", -1, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.er_origin_mb_x", er_origin_mb_x, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.er_origin_mb_y", er_origin_mb_y, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.er_damaged_mb_count", er_damaged_mb_count, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_total_mbs",
+                    h->er.recovery_total_mbs, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_decoded_ok_mbs",
+                    h->er.recovery_decoded_ok_mbs, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_mv_guessed_mbs",
+                    h->er.recovery_mv_guessed_mbs, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_spatial_concealed_mbs",
+                    h->er.recovery_spatial_concealed_mbs, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_reference_copied_mbs",
+                    h->er.recovery_reference_copied_mbs, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.recovery_failed_or_unclassified_mbs",
+                    h->er.recovery_failed_or_unclassified_mbs, 0);
+    if (packet_loss_env_enabled("PACKET_LOSS_GUESS_DC_DUMP") &&
+        h->er.guess_dc_records != NULL && h->er.guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
