+enum {
+    HEVC_GUESS_MV_UNKNOWN = 0,
+    HEVC_GUESS_MV_LISTED  = 1,
+    HEVC_GUESS_MV_FIXED   = 2,
+};
+
+static int hevc_guess_mv_from_mvf(const MvField *mvf,
+                                  int *mv_x, int *mv_y, int *ref_idx)
+{
+    if (mvf == NULL)
+        return 0;
+
+    if (mvf->pred_flag & PF_L0) {
+        *mv_x = mvf->mv[0].x;
+        *mv_y = mvf->mv[0].y;
+        *ref_idx = mvf->ref_idx[0];
+        return 1;
+    }
+    if (mvf->pred_flag & PF_L1) {
+        *mv_x = mvf->mv[1].x;
+        *mv_y = mvf->mv[1].y;
+        *ref_idx = mvf->ref_idx[1];
+        return 1;
+    }
+    return 0;
+}
