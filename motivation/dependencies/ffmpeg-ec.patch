+static int aom_luma_dc_block_width(const AVFrame *frame)
+{
+    return (frame->width + 7) / 8;
+}
+
+static int aom_luma_dc_block_height(const AVFrame *frame)
+{
+    return (frame->height + 7) / 8;
+}
+
+static int aom_chroma_dc_block_width(const AVFrame *frame)
+{
+    return (frame->width + 15) / 16;
+}
+
+static int aom_chroma_dc_block_height(const AVFrame *frame)
+{
+    return (frame->height + 15) / 16;
+}
+
+static double aom_frame_component_block_mean(const AVFrame *frame,
+                                             const AVPixFmtDescriptor *desc,
+                                             int component,
+                                             int luma_x_start,
+                                             int luma_y_start,
+                                             int block_size)
+{
+    const AVComponentDescriptor *comp = NULL;
+    int plane = 0;
+    int shift_w = 0;
+    int shift_h = 0;
+    int plane_width = 0;
+    int plane_height = 0;
+    int x_start = 0;
+    int x_stop = 0;
+    int y_start = 0;
+    int y_stop = 0;
+    int sample_depth = 8;
+    int sample_step = 1;
+    int sample_offset = 0;
+    int sample_shift = 0;
+    int sample_count = 0;
+    double sample_sum = 0.0;
+
+    if (!frame || !desc || component < 0 || component >= desc->nb_components)
+        return NAN;
+
+    comp = &desc->comp[component];
+    plane = comp->plane;
+    if (plane < 0 || plane >= AV_NUM_DATA_POINTERS ||
+        frame->data[plane] == NULL || frame->linesize[plane] == 0)
+        return NAN;
+
+    if (component > 0) {
+        shift_w = desc->log2_chroma_w;
+        shift_h = desc->log2_chroma_h;
+    }
+    plane_width = (frame->width + (1 << shift_w) - 1) >> shift_w;
+    plane_height = (frame->height + (1 << shift_h) - 1) >> shift_h;
+    x_start = luma_x_start >> shift_w;
+    x_stop = (FFMIN(luma_x_start + block_size, frame->width) +
+              (1 << shift_w) - 1) >> shift_w;
+    y_start = luma_y_start >> shift_h;
+    y_stop = (FFMIN(luma_y_start + block_size, frame->height) +
+              (1 << shift_h) - 1) >> shift_h;
+    x_stop = FFMIN(x_stop, plane_width);
+    y_stop = FFMIN(y_stop, plane_height);
+    if (x_start < 0 || y_start < 0 || x_stop <= x_start || y_stop <= y_start)
+        return NAN;
+
+    sample_depth = comp->depth;
+    sample_step = comp->step > 0 ? comp->step : (sample_depth + 7) / 8;
+    sample_offset = comp->offset;
+    sample_shift = comp->shift;
+    for (int y = y_start; y < y_stop; y++) {
+        const uint8_t *row = frame->data[plane] + (ptrdiff_t)y * frame->linesize[plane];
+        for (int x = x_start; x < x_stop; x++) {
+            const uint8_t *sample = row + sample_offset + (ptrdiff_t)x * sample_step;
+            uint16_t sample_value = 0;
+
+            if (sample_depth <= 8) {
+                sample_value = sample[0];
+            } else if (desc->flags & AV_PIX_FMT_FLAG_BE) {
+                sample_value = ((uint16_t)sample[0] << 8) | sample[1];
+            } else {
+                sample_value = ((uint16_t)sample[1] << 8) | sample[0];
+            }
+            if (sample_shift > 0)
+                sample_value >>= sample_shift;
+            sample_sum += sample_value;
+            sample_count++;
+        }
+    }
+
+    return sample_count > 0 ? sample_sum / sample_count : NAN;
+}
+
+static int aom_frame_block_dc(const AVFrame *frame,
+                              const AVPixFmtDescriptor *desc,
+                              int component,
+                              int block_x,
+                              int block_y)
+{
+    const int block_size = component == 0 ? 8 : 16;
+    const double mean = aom_frame_component_block_mean(
+        frame, desc, component, block_x * block_size,
+        block_y * block_size, block_size);
+
+    if (isnan(mean))
+        return 0;
+    return (int)(mean * 8.0 + 0.5);
+}
+
+static int aom_emit_guess_dc_component_records(AV1DecodeContext *ctx,
+                                               const AVFrame *frame,
+                                               const AVPixFmtDescriptor *desc,
+                                               int component,
+                                               int sb_size,
+                                               int sb_cols,
+                                               int sb_rows,
+                                               int damaged_start_sb,
+                                               int total_sbs)
+{
+    const int block_width = component == 0 ? aom_luma_dc_block_width(frame)
+                                          : aom_chroma_dc_block_width(frame);
+    const int block_height = component == 0 ? aom_luma_dc_block_height(frame)
+                                           : aom_chroma_dc_block_height(frame);
+    const int block_count = block_width * block_height;
+    int *dc = NULL;
+    uint8_t *damaged = NULL;
+    int ret = 0;
+
+    if (block_count <= 0 || component >= desc->nb_components)
+        return 0;
+
+    dc = av_malloc_array(block_count, sizeof(*dc));
+    damaged = av_mallocz(block_count);
+    if (dc == NULL || damaged == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int luma_x = component == 0 ? block_x * 8 : block_x * 16;
+            const int luma_y = component == 0 ? block_y * 8 : block_y * 16;
+            const int sb_x = luma_x / sb_size;
+            const int sb_y = luma_y / sb_size;
+
+            dc[index] = aom_frame_block_dc(frame, desc, component, block_x, block_y);
+            if (sb_x < sb_cols && sb_y < sb_rows) {
+                const int sb_index = sb_y * sb_cols + sb_x;
+                damaged[index] = sb_index >= damaged_start_sb && sb_index < total_sbs;
+            }
+        }
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+            int dist[4] = { 9999, 9999, 9999, 9999 };
+            int boundary_dc[4] = { 1024, 1024, 1024, 1024 };
+            int64_t weight[4];
+
+            if (!damaged[index])
+                continue;
+
+            for (int x = block_x + 1; x < block_width; x++) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[0] = x - block_x;
+                    boundary_dc[0] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int x = block_x - 1; x >= 0; x--) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[1] = block_x - x;
+                    boundary_dc[1] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y + 1; y < block_height; y++) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[2] = y - block_y;
+                    boundary_dc[2] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y - 1; y >= 0; y--) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[3] = block_y - y;
+                    boundary_dc[3] = dc[neighbor];
+                    break;
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                weight[i] = 256LL * 256LL * 256LL * 16LL / FFMAX(dist[i], 1);
+
+            ret = aom_append_guess_dc_record(
+                ctx,
+                "%d,%d,%d,%d,%d,%d,%d,%d,%d,%" PRId64 ",%" PRId64
+                ",%" PRId64 ",%" PRId64 ",%d,%d,%d,%d,%d,%d\n",
+                component,
+                block_x,
+                block_y,
+                mb_x,
+                mb_y,
+                dist[0],
+                dist[1],
+                dist[2],
+                dist[3],
+                weight[0],
+                weight[1],
+                weight[2],
+                weight[3],
+                boundary_dc[0],
+                boundary_dc[1],
+                boundary_dc[2],
+                boundary_dc[3],
+                dc[index],
+                AOM_PACKET_LOSS_PRE_GUESS_DC_UNAVAILABLE
+            );
+            if (ret < 0)
+                goto done;
+        }
+    }
+
+done:
+    av_freep(&dc);
+    av_freep(&damaged);
+    return ret;
+}
+
+static int aom_set_guess_dc_metadata(AV1DecodeContext *ctx,
+                                     AVFrame *frame,
+                                     const struct aom_image *img)
+{
+    const AVPixFmtDescriptor *desc = NULL;
+    int sb_size = aom_get_superblock_size(ctx);
+    int sb_cols = img ? (img->d_w + sb_size - 1) / sb_size : 0;
+    int sb_rows = img ? (img->d_h + sb_size - 1) / sb_size : 0;
+    int total_sbs = img ? aom_get_total_superblocks(ctx, img, sb_size) : 0;
+    int damaged_start_sb = aom_get_damaged_start_superblock(ctx, total_sbs);
+    int damaged_blocks = total_sbs - damaged_start_sb;
+    int ret = 0;
+
+    aom_reset_guess_dc_records(ctx);
+    if (frame)
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records", NULL, 0);
+
+    if (!aom_guess_dc_telemetry_enabled() || !frame || !img ||
+        total_sbs <= 0 || damaged_blocks <= 0 || frame->data[0] == NULL)
+        return 0;
+
+    desc = av_pix_fmt_desc_get((enum AVPixelFormat)frame->format);
+    if (!desc || desc->nb_components <= 0 || sb_cols <= 0 || sb_rows <= 0)
+        return 0;
+
+    for (int component = 0; component < 3; component++) {
+        ret = aom_emit_guess_dc_component_records(
+            ctx, frame, desc, component, sb_size, sb_cols, sb_rows,
+            damaged_start_sb, total_sbs);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (ctx->packet_loss_guess_dc_records != NULL &&
+        ctx->packet_loss_guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
+                    ctx->packet_loss_guess_dc_records, 0);
+    }
+
+    return 0;
+}
+
+enum {
+    AOM_GUESS_MV_UNKNOWN = 0,
+    AOM_GUESS_MV_LISTED  = 1,
+    AOM_GUESS_MV_FIXED   = 2,
+};
+
+static int aom_guess_mv_from_mi_cell(AV1DecodeContext *ctx,
+                                     int mi_row, int mi_col,
+                                     int *mv_x, int *mv_y, int *ref_idx)
+{
+#ifdef AOM_CTRL_AV1D_GET_MI_INFO
+    AOMPacketLossMiStorage storage;
+    const AOMPacketLossMiPrefix *mi = &storage.prefix;
+
+    memset(&storage, 0, sizeof(storage));
+    if (aom_codec_control(&ctx->decoder, AV1D_GET_MI_INFO,
+                          mi_row, mi_col, storage.raw) != AOM_CODEC_OK)
+        return 0;
+
+    for (int i = 0; i < 2; i++) {
+        if (mi->ref_frame[i] <= AOM_PACKET_LOSS_AV1_INTRA_FRAME ||
+            mi->ref_frame[i] > AOM_PACKET_LOSS_AV1_EXTREF_FRAME ||
+            mi->mv[i].as_int == AOM_PACKET_LOSS_INVALID_MV)
+            continue;
+
+        *mv_x = mi->mv[i].as_mv.col;
+        *mv_y = mi->mv[i].as_mv.row;
+        *ref_idx = mi->ref_frame[i];
+        return 1;
+    }
+#endif
+    return 0;
+}
+
+static int aom_guess_mv_from_mb_cell(AV1DecodeContext *ctx,
+                                     const struct aom_image *img,
+                                     int mb_x, int mb_y,
+                                     int *mv_x, int *mv_y, int *ref_idx)
+{
+    int mi_cols;
+    int mi_rows;
+    int luma_x;
+    int luma_y;
+    int mi_col;
+    int mi_row;
+
+    if (!img || img->d_w <= 0 || img->d_h <= 0)
+        return 0;
+
+    mi_cols = (img->d_w + 3) / 4;
+    mi_rows = (img->d_h + 3) / 4;
+    luma_x = FFMIN(mb_x * 16 + 8, (int)img->d_w - 1);
+    luma_y = FFMIN(mb_y * 16 + 8, (int)img->d_h - 1);
+    mi_col = FFMIN(luma_x >> 2, mi_cols - 1);
+    mi_row = FFMIN(luma_y >> 2, mi_rows - 1);
+    if (mi_col < 0 || mi_row < 0)
+        return 0;
+
+    return aom_guess_mv_from_mi_cell(ctx, mi_row, mi_col,
+                                     mv_x, mv_y, ref_idx);
+}
+
+static int aom_guess_mv_cell_is_damaged(int mb_x, int mb_y,
+                                        int sb_size, int sb_cols,
+                                        int sb_rows, int damaged_start_sb,
+                                        int total_sbs)
+{
+    const int luma_x = mb_x * 16;
+    const int luma_y = mb_y * 16;
+    const int sb_x = luma_x / sb_size;
+    const int sb_y = luma_y / sb_size;
+    int sb_index = 0;
+
+    if (sb_x < 0 || sb_y < 0 || sb_x >= sb_cols || sb_y >= sb_rows)
+        return 0;
+
+    sb_index = sb_y * sb_cols + sb_x;
+    return sb_index >= damaged_start_sb && sb_index < total_sbs;
+}
+
+static void aom_guess_mv_add_frontier_cell(uint8_t *state,
+                                           const uint8_t *damaged,
+                                           int *frontier,
+                                           int *frontier_length,
+                                           int mb_width, int mb_height,
+                                           int mb_x, int mb_y)
+{
+    int index;
+
+    if (mb_x < 0 || mb_y < 0 || mb_x >= mb_width || mb_y >= mb_height)
+        return;
+
+    index = mb_y * mb_width + mb_x;
+    if (!damaged[index] || state[index] != AOM_GUESS_MV_UNKNOWN)
+        return;
+
+    state[index] = AOM_GUESS_MV_LISTED;
+    frontier[(*frontier_length)++] = index;
+}
+
+static void aom_guess_mv_add_frontier_neighbors(uint8_t *state,
+                                                const uint8_t *damaged,
+                                                int *frontier,
+                                                int *frontier_length,
+                                                int mb_width, int mb_height,
+                                                int index)
+{
+    const int mb_x = index % mb_width;
+    const int mb_y = index / mb_width;
+
+    aom_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x - 1, mb_y);
+    aom_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x + 1, mb_y);
+    aom_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y - 1);
+    aom_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y + 1);
+}
+
+static int aom_emit_guess_mv_truth_records(AV1DecodeContext *ctx,
+                                           const struct aom_image *img)
+{
+    int mb_width;
+    int mb_height;
+    int ret = 0;
+
+    if (!img || img->d_w <= 0 || img->d_h <= 0)
+        return 0;
+
+    mb_width = (img->d_w + 15) / 16;
+    mb_height = (img->d_h + 15) / 16;
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            int mv_x = 0;
+            int mv_y = 0;
+            int ref_idx = 0;
+
+            if (!aom_guess_mv_from_mb_cell(ctx, img, mb_x, mb_y,
+                                           &mv_x, &mv_y, &ref_idx))
+                continue;
+
+            ret = aom_append_guess_mv_record(ctx, "%d,%d,%d,%d,%d,8\n",
+                                             mb_x, mb_y, mv_x, mv_y, ref_idx);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return 0;
+}
+
+static int aom_emit_guess_mv_bfs_records(AV1DecodeContext *ctx,
+                                         const struct aom_image *img,
+                                         int sb_size, int sb_cols,
+                                         int sb_rows, int damaged_start_sb,
+                                         int total_sbs)
+{
+    int mb_width;
+    int mb_height;
+    int cell_count;
+    uint8_t *state = NULL;
+    uint8_t *damaged = NULL;
+    int *mv_x = NULL;
+    int *mv_y = NULL;
+    int *ref_idx = NULL;
+    int *frontier = NULL;
+    int *next_frontier = NULL;
+    int *newly_fixed = NULL;
+    int frontier_length = 0;
+    int ret = 0;
+
+    if (!img || img->d_w <= 0 || img->d_h <= 0)
+        return 0;
+
+    mb_width = (img->d_w + 15) / 16;
+    mb_height = (img->d_h + 15) / 16;
+    cell_count = mb_width * mb_height;
+    if (cell_count <= 0)
+        return 0;
+
+    state = av_mallocz(cell_count);
+    damaged = av_mallocz(cell_count);
+    mv_x = av_malloc_array(cell_count, sizeof(*mv_x));
+    mv_y = av_malloc_array(cell_count, sizeof(*mv_y));
+    ref_idx = av_malloc_array(cell_count, sizeof(*ref_idx));
+    frontier = av_malloc_array(cell_count, sizeof(*frontier));
+    next_frontier = av_malloc_array(cell_count, sizeof(*next_frontier));
+    newly_fixed = av_malloc_array(cell_count, sizeof(*newly_fixed));
+    if (state == NULL || damaged == NULL || mv_x == NULL || mv_y == NULL ||
+        ref_idx == NULL || frontier == NULL || next_frontier == NULL ||
+        newly_fixed == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int index = mb_y * mb_width + mb_x;
+
+            damaged[index] = aom_guess_mv_cell_is_damaged(
+                mb_x, mb_y, sb_size, sb_cols, sb_rows,
+                damaged_start_sb, total_sbs);
+            if (!damaged[index] &&
+                aom_guess_mv_from_mb_cell(ctx, img, mb_x, mb_y,
+                                          &mv_x[index], &mv_y[index],
+                                          &ref_idx[index])) {
+                state[index] = AOM_GUESS_MV_FIXED;
+            }
+        }
+    }
+
+    for (int index = 0; index < cell_count; index++) {
+        if (state[index] == AOM_GUESS_MV_FIXED)
+            aom_guess_mv_add_frontier_neighbors(state, damaged, frontier,
+                                                &frontier_length, mb_width,
+                                                mb_height, index);
+    }
+
+    for (int hop_count = 1; frontier_length > 0; hop_count++) {
+        int next_frontier_length = 0;
+        int newly_fixed_length = 0;
+
+        for (int frontier_index = 0; frontier_index < frontier_length; frontier_index++) {
+            const int index = frontier[frontier_index];
+            const int mb_x = index % mb_width;
+            const int mb_y = index / mb_width;
+            int pred_count = 0;
+            int sum_x = 0;
+            int sum_y = 0;
+            int sum_ref = 0;
+
+#define AOM_ACCUM_FIXED_MV(nx, ny) do {                                       \
+                const int neighbor_x = (nx);                                  \
+                const int neighbor_y = (ny);                                  \
+                if (neighbor_x >= 0 && neighbor_y >= 0 &&                     \
+                    neighbor_x < mb_width && neighbor_y < mb_height) {        \
+                    const int neighbor_index =                                \
+                        neighbor_y * mb_width + neighbor_x;                   \
+                    if (state[neighbor_index] == AOM_GUESS_MV_FIXED) {        \
+                        sum_x += mv_x[neighbor_index];                        \
+                        sum_y += mv_y[neighbor_index];                        \
+                        sum_ref += ref_idx[neighbor_index];                   \
+                        pred_count++;                                         \
+                    }                                                         \
+                }                                                             \
+            } while (0)
+
+            AOM_ACCUM_FIXED_MV(mb_x - 1, mb_y);
+            AOM_ACCUM_FIXED_MV(mb_x + 1, mb_y);
+            AOM_ACCUM_FIXED_MV(mb_x, mb_y - 1);
+            AOM_ACCUM_FIXED_MV(mb_x, mb_y + 1);
+#undef AOM_ACCUM_FIXED_MV
+
+            if (pred_count <= 0) {
+                state[index] = AOM_GUESS_MV_UNKNOWN;
+                continue;
+            }
+
+            mv_x[index] = sum_x / pred_count;
+            mv_y[index] = sum_y / pred_count;
+            ref_idx[index] = sum_ref / pred_count;
+            ret = aom_append_guess_mv_record(ctx, "%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                                             mb_x, mb_y, hop_count, 0,
+                                             pred_count, mv_x[index],
+                                             mv_y[index], ref_idx[index], -1);
+            if (ret < 0)
+                goto done;
+
+            newly_fixed[newly_fixed_length++] = index;
+        }
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            state[newly_fixed[i]] = AOM_GUESS_MV_FIXED;
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            aom_guess_mv_add_frontier_neighbors(state, damaged, next_frontier,
+                                                &next_frontier_length, mb_width,
+                                                mb_height, newly_fixed[i]);
+
+        FFSWAP(int *, frontier, next_frontier);
+        frontier_length = next_frontier_length;
+    }
+
+done:
+    av_freep(&state);
+    av_freep(&damaged);
+    av_freep(&mv_x);
+    av_freep(&mv_y);
+    av_freep(&ref_idx);
+    av_freep(&frontier);
+    av_freep(&next_frontier);
+    av_freep(&newly_fixed);
+    return ret;
+}
+
+static int aom_set_guess_mv_metadata(AV1DecodeContext *ctx,
+                                     AVFrame *frame,
+                                     const struct aom_image *img,
+                                     int frame_corrupted)
+{
+    int sb_size = aom_get_superblock_size(ctx);
+    int sb_cols = img ? (img->d_w + sb_size - 1) / sb_size : 0;
+    int sb_rows = img ? (img->d_h + sb_size - 1) / sb_size : 0;
+    int total_sbs = img ? aom_get_total_superblocks(ctx, img, sb_size) : 0;
+    int damaged_start_sb = aom_get_damaged_start_superblock(ctx, total_sbs);
+    int damaged_blocks = total_sbs - damaged_start_sb;
+    int ret = 0;
+
+    aom_reset_guess_mv_records(ctx);
+    if (frame) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_records", NULL, 0);
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    }
+
+    if (!frame || !img || total_sbs <= 0 || sb_cols <= 0 || sb_rows <= 0)
+        return 0;
+
+    if (aom_guess_mv_truth_enabled()) {
+        ret = aom_emit_guess_mv_truth_records(ctx, img);
+        if (ret < 0)
+            return ret;
+        if (ctx->packet_loss_guess_mv_records != NULL &&
+            ctx->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records",
+                        ctx->packet_loss_guess_mv_records, 0);
+        }
+        aom_reset_guess_mv_records(ctx);
+    }
+
+    if (aom_guess_mv_telemetry_enabled() && damaged_blocks > 0 && !frame_corrupted) {
+        ret = aom_emit_guess_mv_bfs_records(
+            ctx, img, sb_size, sb_cols, sb_rows,
+            damaged_start_sb, total_sbs);
+        if (ret < 0)
+            return ret;
+        if (ctx->packet_loss_guess_mv_records != NULL &&
+            ctx->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_records",
+                        ctx->packet_loss_guess_mv_records, 0);
+        }
+    }
+
+    return 0;
+}
 
