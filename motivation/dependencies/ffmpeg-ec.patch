+
+static int vvc_luma_dc_block_width(const VVCPPS *pps)
+{
+    return (pps->width + 7) / 8;
+}
+
+static int vvc_luma_dc_block_height(const VVCPPS *pps)
+{
+    return (pps->height + 7) / 8;
+}
+
+static int vvc_chroma_dc_block_width(const VVCPPS *pps)
+{
+    return (pps->width + 15) / 16;
+}
+
+static int vvc_chroma_dc_block_height(const VVCPPS *pps)
+{
+    return (pps->height + 15) / 16;
+}
+
+static int vvc_packet_loss_dc_block_count(const VVCSPS *sps, const VVCPPS *pps)
+{
+    if (!sps || !pps)
+        return 0;
+    return vvc_luma_dc_block_width(pps) * vvc_luma_dc_block_height(pps) +
+           2 * vvc_chroma_dc_block_width(pps) * vvc_chroma_dc_block_height(pps);
+}
+
+static int vvc_packet_loss_dc_index(const VVCPPS *pps,
+                                    int component, int block_x, int block_y)
+{
+    const int luma_count = vvc_luma_dc_block_width(pps) * vvc_luma_dc_block_height(pps);
+    const int chroma_width = vvc_chroma_dc_block_width(pps);
+    const int chroma_count = chroma_width * vvc_chroma_dc_block_height(pps);
+
+    if (component == 0)
+        return block_y * vvc_luma_dc_block_width(pps) + block_x;
+    return luma_count + (component - 1) * chroma_count +
+           block_y * chroma_width + block_x;
+}
+
+static int vvc_visible_luma_extent(const VVCPPS *pps, int luma_start,
+                                   int block_size)
+{
+    const int visible = pps->width - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vvc_visible_luma_height(const VVCPPS *pps, int luma_start,
+                                   int block_size)
+{
+    const int visible = pps->height - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vvc_visible_chroma_extent(const VVCSPS *sps, const VVCPPS *pps,
+                                     int component, int luma_start,
+                                     int block_size)
+{
+    const int shift = sps->hshift[component];
+    const int luma_stop = FFMIN(luma_start + block_size, pps->width);
+    const int chroma_start = luma_start >> shift;
+    const int chroma_stop = (luma_stop + (1 << shift) - 1) >> shift;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int vvc_visible_chroma_height(const VVCSPS *sps, const VVCPPS *pps,
+                                     int component, int luma_start,
+                                     int block_size)
+{
+    const int shift = sps->vshift[component];
+    const int luma_stop = FFMIN(luma_start + block_size, pps->height);
+    const int chroma_start = luma_start >> shift;
+    const int chroma_stop = (luma_stop + (1 << shift) - 1) >> shift;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int vvc_scaled_block_mean(const uint8_t *src, ptrdiff_t stride,
+                                 int width, int height, int bytesperpixel)
+{
+    int64_t sample_sum = 0;
+    int sample_count = width * height;
+
+    if (src == NULL || width <= 0 || height <= 0)
+        return 1024;
+
+    for (int y = 0; y < height; y++) {
+        const uint8_t *row = src + (ptrdiff_t)y * stride;
+        for (int x = 0; x < width; x++) {
+            if (bytesperpixel == 1)
+                sample_sum += row[x];
+            else
+                sample_sum += AV_RN16(row + (ptrdiff_t)x * bytesperpixel);
+        }
+    }
+
+    return (int)((sample_sum * 8 + sample_count / 2) / sample_count);
+}
+
+static int vvc_frame_block_dc(const VVCSPS *sps, const VVCPPS *pps,
+                              const AVFrame *frame, int component,
+                              int block_x, int block_y)
+{
+    const int bytesperpixel = 1 << sps->pixel_shift;
+
+    if (component == 0) {
+        const int luma_x = block_x * 8;
+        const int luma_y = block_y * 8;
+        const int block_w = vvc_visible_luma_extent(pps, luma_x, 8);
+        const int block_h = vvc_visible_luma_height(pps, luma_y, 8);
+        return vvc_scaled_block_mean(
+            frame->data[0] + (ptrdiff_t)luma_y * frame->linesize[0] +
+            (ptrdiff_t)luma_x * bytesperpixel,
+            frame->linesize[0], block_w, block_h, bytesperpixel);
+    } else {
+        const int luma_x = block_x * 16;
+        const int luma_y = block_y * 16;
+        const int chroma_x = luma_x >> sps->hshift[component];
+        const int chroma_y = luma_y >> sps->vshift[component];
+        const int block_w = vvc_visible_chroma_extent(sps, pps, component, luma_x, 16);
+        const int block_h = vvc_visible_chroma_height(sps, pps, component, luma_y, 16);
+        return vvc_scaled_block_mean(
+            frame->data[component] + (ptrdiff_t)chroma_y * frame->linesize[component] +
+            (ptrdiff_t)chroma_x * bytesperpixel,
+            frame->linesize[component], block_w, block_h, bytesperpixel);
+    }
+}
