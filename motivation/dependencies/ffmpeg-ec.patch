+static int vvc_emit_guess_dc_component_records(VVCFrameContext *fc,
+                                               const AVFrame *frame,
+                                               int component,
+                                               int force_full_frame)
+{
+    const VVCSPS *sps = fc->ps.sps;
+    const VVCPPS *pps = fc->ps.pps;
+    const int block_width = component == 0 ? vvc_luma_dc_block_width(pps)
+                                          : vvc_chroma_dc_block_width(pps);
+    const int block_height = component == 0 ? vvc_luma_dc_block_height(pps)
+                                           : vvc_chroma_dc_block_height(pps);
+    const int block_count = block_width * block_height;
+    int *dc = NULL;
+    uint8_t *damaged = NULL;
+    int ret = 0;
+
+    if (block_count <= 0 || frame->data[component] == NULL)
+        return 0;
+
+    dc = av_malloc_array(block_count, sizeof(*dc));
+    damaged = av_mallocz(block_count);
+    if (dc == NULL || damaged == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int luma_x = component == 0 ? block_x * 8 : block_x * 16;
+            const int luma_y = component == 0 ? block_y * 8 : block_y * 16;
+            const int ctb_x = luma_x >> sps->ctb_log2_size_y;
+            const int ctb_y = luma_y >> sps->ctb_log2_size_y;
+
+            dc[index] = vvc_frame_block_dc(sps, pps, frame, component, block_x, block_y);
+            if (force_full_frame) {
+                damaged[index] = 1;
+            } else if (ctb_x < pps->ctb_width && ctb_y < pps->ctb_height) {
+                const int ctb_addr_rs = ctb_y * pps->ctb_width + ctb_x;
+                damaged[index] = !!(fc->tab.ec_status[ctb_addr_rs] & VVC_EC_CTU_DAMAGED);
+            }
+        }
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+            int dist[4] = { 9999, 9999, 9999, 9999 };
+            int boundary_dc[4] = { 1024, 1024, 1024, 1024 };
+            int64_t weight[4];
+            int pre_guess_dc = VVC_PACKET_LOSS_PRE_GUESS_DC_UNAVAILABLE;
+            int pre_index = -1;
+
+            if (!damaged[index])
+                continue;
+
+            for (int x = block_x + 1; x < block_width; x++) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[0] = x - block_x;
+                    boundary_dc[0] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int x = block_x - 1; x >= 0; x--) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[1] = block_x - x;
+                    boundary_dc[1] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y + 1; y < block_height; y++) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[2] = y - block_y;
+                    boundary_dc[2] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y - 1; y >= 0; y--) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[3] = block_y - y;
+                    boundary_dc[3] = dc[neighbor];
+                    break;
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                weight[i] = 256LL * 256LL * 256LL * 16LL / FFMAX(dist[i], 1);
+
+            pre_index = vvc_packet_loss_dc_index(pps, component, block_x, block_y);
+            if (fc->packet_loss_pre_dc_valid != NULL &&
+                fc->packet_loss_pre_dc != NULL &&
+                pre_index >= 0 && pre_index < fc->packet_loss_pre_dc_count &&
+                fc->packet_loss_pre_dc_valid[pre_index]) {
+                pre_guess_dc = fc->packet_loss_pre_dc[pre_index];
+            }
+
+            ret = vvc_append_guess_dc_record(
+                fc,
+                "%d,%d,%d,%d,%d,%d,%d,%d,%d,%" PRId64 ",%" PRId64
+                ",%" PRId64 ",%" PRId64 ",%d,%d,%d,%d,%d,%d\n",
+                component,
+                block_x,
+                block_y,
+                mb_x,
+                mb_y,
+                dist[0],
+                dist[1],
+                dist[2],
+                dist[3],
+                weight[0],
+                weight[1],
+                weight[2],
+                weight[3],
+                boundary_dc[0],
+                boundary_dc[1],
+                boundary_dc[2],
+                boundary_dc[3],
+                dc[index],
+                pre_guess_dc
+            );
+            if (ret < 0)
+                goto done;
+        }
+    }
+
+done:
+    av_freep(&dc);
+    av_freep(&damaged);
+    return ret;
+}
+
+static int64_t vvc_frame_timestamp(const AVFrame *frame)
+{
+    if (!frame)
+        return AV_NOPTS_VALUE;
+    return frame->best_effort_timestamp != AV_NOPTS_VALUE ?
+           frame->best_effort_timestamp : frame->pts;
+}
+
+static int vvc_frame_matches_output(const AVFrame *output, const AVFrame *source)
+{
+    const int64_t output_ts = vvc_frame_timestamp(output);
+    const int64_t source_ts = vvc_frame_timestamp(source);
+
+    if (!output || !source || !output->buf[0] || !source->buf[0])
+        return 0;
+    if (output->data[0] == source->data[0])
+        return 1;
+    return output_ts != AV_NOPTS_VALUE && output_ts == source_ts;
+}
+
+static int vvc_frame_matches_picture(const VVCFrame *candidate,
+                                     const VVCFrame *source)
+{
+    if (!candidate || !source || !candidate->frame || !source->frame ||
+        !candidate->frame->buf[0] || !source->frame->buf[0])
+        return 0;
+    if (candidate == source)
+        return 1;
+    if (candidate->frame->data[0] == source->frame->data[0])
+        return 1;
+    return candidate->sequence == source->sequence &&
+           candidate->poc == source->poc &&
+           vvc_frame_timestamp(candidate->frame) == vvc_frame_timestamp(source->frame);
+}
+
+static void vvc_copy_guess_dc_records(AVFrame *dst, const AVFrame *src)
+{
+    const AVDictionaryEntry *entry = NULL;
+
+    if (!dst || !src)
+        return;
+
+    entry = av_dict_get(src->metadata, "packet_loss.guess_dc_records", NULL, 0);
+    av_dict_set(&dst->metadata, "packet_loss.guess_dc_records",
+                entry ? entry->value : NULL, 0);
+}
+
+static void vvc_propagate_guess_dc_metadata(VVCContext *s, const VVCFrame *source)
+{
+    const AVDictionaryEntry *entry = NULL;
+
+    if (!s || !source || !source->frame)
+        return;
+
+    entry = av_dict_get(source->frame->metadata,
+                        "packet_loss.guess_dc_records", NULL, 0);
+    if (!entry || !entry->value || entry->value[0] == '\0')
+        return;
+
+    for (int i = 0; i < s->nb_fcs; i++) {
+        VVCFrameContext *other = s->fcs + i;
+
+        for (int j = 0; j < FF_ARRAY_ELEMS(other->DPB); j++) {
+            VVCFrame *candidate = &other->DPB[j];
+
+            if (!vvc_frame_matches_picture(candidate, source))
+                continue;
+            vvc_copy_guess_dc_records(candidate->frame, source->frame);
+            if (candidate->frame_grain && candidate->frame_grain->buf[0])
+                vvc_copy_guess_dc_records(candidate->frame_grain, source->frame);
+        }
+
+        if (vvc_frame_matches_output(other->output_frame, source->frame))
+            vvc_copy_guess_dc_records(other->output_frame, source->frame);
+        else if (vvc_frame_matches_output(other->output_frame, source->frame_grain))
+            vvc_copy_guess_dc_records(other->output_frame, source->frame);
+    }
+}
+
+static int vvc_set_guess_dc_metadata_on_frame(VVCFrameContext *fc,
+                                              AVFrame *frame,
+                                              int force_full_frame)
+{
+    const VVCSPS *sps = fc->ps.sps;
+    const VVCPPS *pps = fc->ps.pps;
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vvc_reset_guess_dc_records(fc);
+    if (frame != NULL)
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records", NULL, 0);
+
+    if (!vvc_guess_dc_telemetry_enabled() || frame == NULL ||
+        sps == NULL || pps == NULL ||
+        (!force_full_frame && fc->tab.ec_status == NULL) ||
+        frame->data[0] == NULL)
+        return 0;
+
+    if (force_full_frame) {
+        damaged_blocks = pps->ctb_count;
+    } else {
+        for (int ctb_addr_rs = 0; ctb_addr_rs < pps->ctb_count; ctb_addr_rs++)
+            damaged_blocks += !!(fc->tab.ec_status[ctb_addr_rs] & VVC_EC_CTU_DAMAGED);
+    }
+    if (damaged_blocks <= 0)
+        return 0;
+
+    for (int component = 0; component < 3; component++) {
+        ret = vvc_emit_guess_dc_component_records(fc, frame, component,
+                                                  force_full_frame);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (fc->packet_loss_guess_dc_records != NULL &&
+        fc->packet_loss_guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
+                    fc->packet_loss_guess_dc_records, 0);
+    }
+
+    return 0;
+}
+
+static int vvc_set_guess_dc_metadata(VVCContext *s, VVCFrameContext *fc)
+{
+    VVCFrame *out = fc->ref;
+    AVFrame *frame = out ? out->frame : NULL;
+    int ret = 0;
+
+    ret = vvc_set_guess_dc_metadata_on_frame(fc, frame, 0);
+    if (ret < 0)
+        return ret;
+
+    if (out && out->frame_grain && out->frame_grain->buf[0] && frame)
+        av_dict_copy(&out->frame_grain->metadata, frame->metadata, 0);
+    if (out)
+        vvc_propagate_guess_dc_metadata(s, out);
+
+    return 0;
+}
+
+enum {
+    VVC_GUESS_MV_UNKNOWN = 0,
+    VVC_GUESS_MV_LISTED  = 1,
+    VVC_GUESS_MV_FIXED   = 2,
+};
+
+static int vvc_guess_mv_from_mvf(const MvField *mvf,
+                                 int *mv_x, int *mv_y, int *ref_idx)
+{
+    if (mvf == NULL)
+        return 0;
+
+    if ((mvf->pred_flag & (PF_IBC & ~PF_L0)) || (mvf->pred_flag & PF_PLT))
+        return 0;
+    if (mvf->pred_flag & PF_L0) {
+        *mv_x = mvf->mv[0].x;
+        *mv_y = mvf->mv[0].y;
+        *ref_idx = mvf->ref_idx[0];
+        return 1;
+    }
+    if (mvf->pred_flag & PF_L1) {
+        *mv_x = mvf->mv[1].x;
+        *mv_y = mvf->mv[1].y;
+        *ref_idx = mvf->ref_idx[1];
+        return 1;
+    }
+    return 0;
+}
+
+static int vvc_guess_mv_sample_index(const VVCPPS *pps, int luma_x, int luma_y)
+{
+    const int sample_x = av_clip(luma_x, 0, pps->width - 1);
+    const int sample_y = av_clip(luma_y, 0, pps->height - 1);
+    const int pu_x = FFMIN(sample_x >> MIN_PU_LOG2, pps->min_pu_width - 1);
+    const int pu_y = FFMIN(sample_y >> MIN_PU_LOG2, pps->min_pu_height - 1);
+
+    return pu_y * pps->min_pu_width + pu_x;
+}
+
+static int vvc_guess_mv_cell_is_damaged(const VVCFrameContext *fc,
+                                        int mb_x, int mb_y,
+                                        int force_full_frame)
+{
+    const VVCSPS *sps = fc->ps.sps;
+    const VVCPPS *pps = fc->ps.pps;
+    const int luma_x = mb_x * 16;
+    const int luma_y = mb_y * 16;
+    const int ctb_x = luma_x >> sps->ctb_log2_size_y;
+    const int ctb_y = luma_y >> sps->ctb_log2_size_y;
+
+    if (force_full_frame)
+        return 1;
+    if (fc->tab.ec_status == NULL ||
+        ctb_x < 0 || ctb_y < 0 ||
+        ctb_x >= pps->ctb_width || ctb_y >= pps->ctb_height)
+        return 0;
+
+    return !!(fc->tab.ec_status[ctb_y * pps->ctb_width + ctb_x] &
+              VVC_EC_CTU_DAMAGED);
+}
+
+static void vvc_guess_mv_add_frontier_cell(uint8_t *state,
+                                           const uint8_t *damaged,
+                                           int *frontier,
+                                           int *frontier_length,
+                                           int mb_width, int mb_height,
+                                           int mb_x, int mb_y)
+{
+    int index;
+
+    if (mb_x < 0 || mb_y < 0 || mb_x >= mb_width || mb_y >= mb_height)
+        return;
+
+    index = mb_y * mb_width + mb_x;
+    if (!damaged[index] || state[index] != VVC_GUESS_MV_UNKNOWN)
+        return;
+
+    state[index] = VVC_GUESS_MV_LISTED;
+    frontier[(*frontier_length)++] = index;
+}
+
+static void vvc_guess_mv_add_frontier_neighbors(uint8_t *state,
+                                                const uint8_t *damaged,
+                                                int *frontier,
+                                                int *frontier_length,
+                                                int mb_width, int mb_height,
+                                                int index)
+{
+    const int mb_x = index % mb_width;
+    const int mb_y = index / mb_width;
+
+    vvc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x - 1, mb_y);
+    vvc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x + 1, mb_y);
+    vvc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y - 1);
+    vvc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y + 1);
+}
+
+static int vvc_emit_guess_mv_truth_records(VVCFrameContext *fc)
+{
+    const VVCPPS *pps = fc->ps.pps;
+    const MvField *tab_mvf = fc->tab.mvf;
+    const int mb_width = (pps->width + 15) / 16;
+    const int mb_height = (pps->height + 15) / 16;
+    int ret = 0;
+
+    if (tab_mvf == NULL)
+        return 0;
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int sample_x = FFMIN(mb_x * 16 + 8, pps->width - 1);
+            const int sample_y = FFMIN(mb_y * 16 + 8, pps->height - 1);
+            const int pu_index = vvc_guess_mv_sample_index(pps, sample_x, sample_y);
+            int mv_x = 0;
+            int mv_y = 0;
+            int ref_idx = 0;
+
+            if (!vvc_guess_mv_from_mvf(&tab_mvf[pu_index], &mv_x, &mv_y, &ref_idx))
+                continue;
+
+            ret = vvc_append_guess_mv_record(fc, "%d,%d,%d,%d,%d,4\n",
+                                             mb_x, mb_y, mv_x, mv_y, ref_idx);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return 0;
+}
+
+static int vvc_emit_guess_mv_bfs_records(VVCFrameContext *fc,
+                                         int force_full_frame)
+{
+    const VVCPPS *pps = fc->ps.pps;
+    const MvField *tab_mvf = fc->tab.mvf;
+    const int mb_width = (pps->width + 15) / 16;
+    const int mb_height = (pps->height + 15) / 16;
+    const int cell_count = mb_width * mb_height;
+    uint8_t *state = NULL;
+    uint8_t *damaged = NULL;
+    int *mv_x = NULL;
+    int *mv_y = NULL;
+    int *ref_idx = NULL;
+    int *frontier = NULL;
+    int *next_frontier = NULL;
+    int *newly_fixed = NULL;
+    int frontier_length = 0;
+    int ret = 0;
+
+    if (tab_mvf == NULL || cell_count <= 0)
+        return 0;
+
+    state = av_mallocz(cell_count);
+    damaged = av_mallocz(cell_count);
+    mv_x = av_malloc_array(cell_count, sizeof(*mv_x));
+    mv_y = av_malloc_array(cell_count, sizeof(*mv_y));
+    ref_idx = av_malloc_array(cell_count, sizeof(*ref_idx));
+    frontier = av_malloc_array(cell_count, sizeof(*frontier));
+    next_frontier = av_malloc_array(cell_count, sizeof(*next_frontier));
+    newly_fixed = av_malloc_array(cell_count, sizeof(*newly_fixed));
+    if (state == NULL || damaged == NULL || mv_x == NULL || mv_y == NULL ||
+        ref_idx == NULL || frontier == NULL || next_frontier == NULL ||
+        newly_fixed == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int index = mb_y * mb_width + mb_x;
+            const int sample_x = FFMIN(mb_x * 16 + 8, pps->width - 1);
+            const int sample_y = FFMIN(mb_y * 16 + 8, pps->height - 1);
+            const int pu_index = vvc_guess_mv_sample_index(pps, sample_x, sample_y);
+
+            damaged[index] = vvc_guess_mv_cell_is_damaged(fc, mb_x, mb_y,
+                                                          force_full_frame);
+            if (!damaged[index] &&
+                vvc_guess_mv_from_mvf(&tab_mvf[pu_index],
+                                      &mv_x[index], &mv_y[index], &ref_idx[index])) {
+                state[index] = VVC_GUESS_MV_FIXED;
+            }
+        }
+    }
+
+    for (int index = 0; index < cell_count; index++) {
+        if (state[index] == VVC_GUESS_MV_FIXED)
+            vvc_guess_mv_add_frontier_neighbors(state, damaged, frontier,
+                                                &frontier_length, mb_width,
+                                                mb_height, index);
+    }
+
+    for (int hop_count = 1; frontier_length > 0; hop_count++) {
+        int next_frontier_length = 0;
+        int newly_fixed_length = 0;
+
+        for (int frontier_index = 0; frontier_index < frontier_length; frontier_index++) {
+            const int index = frontier[frontier_index];
+            const int mb_x = index % mb_width;
+            const int mb_y = index / mb_width;
+            int pred_count = 0;
+            int sum_x = 0;
+            int sum_y = 0;
+            int sum_ref = 0;
+
+#define VVC_ACCUM_FIXED_MV(nx, ny) do {                                       \
+                const int neighbor_x = (nx);                                  \
+                const int neighbor_y = (ny);                                  \
+                if (neighbor_x >= 0 && neighbor_y >= 0 &&                     \
+                    neighbor_x < mb_width && neighbor_y < mb_height) {        \
+                    const int neighbor_index =                                \
+                        neighbor_y * mb_width + neighbor_x;                   \
+                    if (state[neighbor_index] == VVC_GUESS_MV_FIXED) {        \
+                        sum_x += mv_x[neighbor_index];                        \
+                        sum_y += mv_y[neighbor_index];                        \
+                        sum_ref += ref_idx[neighbor_index];                   \
+                        pred_count++;                                         \
+                    }                                                         \
+                }                                                             \
+            } while (0)
+
+            VVC_ACCUM_FIXED_MV(mb_x - 1, mb_y);
+            VVC_ACCUM_FIXED_MV(mb_x + 1, mb_y);
+            VVC_ACCUM_FIXED_MV(mb_x, mb_y - 1);
+            VVC_ACCUM_FIXED_MV(mb_x, mb_y + 1);
+#undef VVC_ACCUM_FIXED_MV
+
+            if (pred_count <= 0) {
+                state[index] = VVC_GUESS_MV_UNKNOWN;
+                continue;
+            }
+
+            mv_x[index] = sum_x / pred_count;
+            mv_y[index] = sum_y / pred_count;
+            ref_idx[index] = sum_ref / pred_count;
+            ret = vvc_append_guess_mv_record(fc, "%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                                             mb_x, mb_y, hop_count, 0,
+                                             pred_count, mv_x[index],
+                                             mv_y[index], ref_idx[index], -1);
+            if (ret < 0)
+                goto done;
+
+            newly_fixed[newly_fixed_length++] = index;
+        }
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            state[newly_fixed[i]] = VVC_GUESS_MV_FIXED;
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            vvc_guess_mv_add_frontier_neighbors(state, damaged, next_frontier,
+                                                &next_frontier_length, mb_width,
+                                                mb_height, newly_fixed[i]);
+
+        FFSWAP(int *, frontier, next_frontier);
+        frontier_length = next_frontier_length;
+    }
+
+done:
+    av_freep(&state);
+    av_freep(&damaged);
+    av_freep(&mv_x);
+    av_freep(&mv_y);
+    av_freep(&ref_idx);
+    av_freep(&frontier);
+    av_freep(&next_frontier);
+    av_freep(&newly_fixed);
+    return ret;
+}
+
+static int vvc_set_guess_mv_metadata_on_frame(VVCFrameContext *fc,
+                                              AVFrame *frame,
+                                              int force_full_frame)
+{
+    const VVCSPS *sps = fc->ps.sps;
+    const VVCPPS *pps = fc->ps.pps;
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vvc_reset_guess_mv_records(fc);
+    if (frame != NULL) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_records", NULL, 0);
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    }
+
+    if (frame == NULL || sps == NULL || pps == NULL ||
+        (!force_full_frame && fc->tab.ec_status == NULL) ||
+        fc->tab.mvf == NULL)
+        return 0;
+
+    if (vvc_guess_mv_truth_enabled()) {
+        ret = vvc_emit_guess_mv_truth_records(fc);
+        if (ret < 0)
+            return ret;
+        if (fc->packet_loss_guess_mv_records != NULL &&
+            fc->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records",
+                        fc->packet_loss_guess_mv_records, 0);
+        }
+        vvc_reset_guess_mv_records(fc);
+    }
+
+    if (vvc_guess_mv_telemetry_enabled()) {
+        if (force_full_frame) {
+            damaged_blocks = pps->ctb_count;
+        } else {
+            for (int ctb_addr_rs = 0; ctb_addr_rs < pps->ctb_count; ctb_addr_rs++)
+                damaged_blocks += !!(fc->tab.ec_status[ctb_addr_rs] &
+                                     VVC_EC_CTU_DAMAGED);
+        }
+        if (damaged_blocks > 0) {
+            ret = vvc_emit_guess_mv_bfs_records(fc, force_full_frame);
+            if (ret < 0)
+                return ret;
+            if (fc->packet_loss_guess_mv_records != NULL &&
+                fc->packet_loss_guess_mv_records_size > 0) {
+                av_dict_set(&frame->metadata, "packet_loss.guess_mv_records",
+                            fc->packet_loss_guess_mv_records, 0);
+            }
+        }
+    }
+
+    return 0;
+}
+
+static void vvc_copy_guess_mv_records(AVFrame *dst, const AVFrame *src)
+{
+    const AVDictionaryEntry *entry = NULL;
+
+    if (!dst || !src)
+        return;
+
+    entry = av_dict_get(src->metadata, "packet_loss.guess_mv_records", NULL, 0);
+    av_dict_set(&dst->metadata, "packet_loss.guess_mv_records",
+                entry ? entry->value : NULL, 0);
+    entry = av_dict_get(src->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    av_dict_set(&dst->metadata, "packet_loss.guess_mv_truth_records",
+                entry ? entry->value : NULL, 0);
+}
+
+static void vvc_propagate_guess_mv_metadata(VVCContext *s, const VVCFrame *source)
+{
+    const AVDictionaryEntry *records = NULL;
+    const AVDictionaryEntry *truth = NULL;
+
+    if (!s || !source || !source->frame)
+        return;
+
+    records = av_dict_get(source->frame->metadata,
+                          "packet_loss.guess_mv_records", NULL, 0);
+    truth = av_dict_get(source->frame->metadata,
+                        "packet_loss.guess_mv_truth_records", NULL, 0);
+    if ((!records || !records->value || records->value[0] == '\0') &&
+        (!truth || !truth->value || truth->value[0] == '\0'))
+        return;
+
+    for (int i = 0; i < s->nb_fcs; i++) {
+        VVCFrameContext *other = s->fcs + i;
+
+        for (int j = 0; j < FF_ARRAY_ELEMS(other->DPB); j++) {
+            VVCFrame *candidate = &other->DPB[j];
+
+            if (!vvc_frame_matches_picture(candidate, source))
+                continue;
+            vvc_copy_guess_mv_records(candidate->frame, source->frame);
+            if (candidate->frame_grain && candidate->frame_grain->buf[0])
+                vvc_copy_guess_mv_records(candidate->frame_grain, source->frame);
+        }
+
+        if (vvc_frame_matches_output(other->output_frame, source->frame))
+            vvc_copy_guess_mv_records(other->output_frame, source->frame);
+        else if (vvc_frame_matches_output(other->output_frame, source->frame_grain))
+            vvc_copy_guess_mv_records(other->output_frame, source->frame);
+    }
+}
+
