+static int vp8_packet_loss_dc_block_count(const VP8Context *s)
+{
+    return s->mb_width * s->mb_height * 6;
+}
+
+static int vp8_packet_loss_dc_index(const VP8Context *s,
+                                    int component, int block_x, int block_y)
+{
+    const int mb_count = s->mb_width * s->mb_height;
+
+    if (component == 0)
+        return block_y * (s->mb_width * 2) + block_x;
+    return (3 + component) * mb_count + block_y * s->mb_width + block_x;
+}
+
+static int vp8_scaled_block_mean(const uint8_t *src, ptrdiff_t stride,
+                                 int width, int height)
+{
+    int sum = 0;
+    int count = width * height;
+
+    if (src == NULL || width <= 0 || height <= 0)
+        return 1024;
+
+    for (int y = 0; y < height; y++)
+        for (int x = 0; x < width; x++)
+            sum += src[(ptrdiff_t)y * stride + x];
+
+    return (sum * 8 + count / 2) / count;
+}
+
+static int vp8_visible_luma_extent(const VP8Context *s, int luma_start,
+                                   int block_size)
+{
+    const int visible = s->avctx->width - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vp8_visible_luma_height(const VP8Context *s, int luma_start,
+                                   int block_size)
+{
+    const int visible = s->avctx->height - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vp8_visible_chroma_extent(const VP8Context *s, int luma_start,
+                                     int block_size)
+{
+    const int luma_stop = FFMIN(luma_start + block_size, s->avctx->width);
+    const int chroma_start = luma_start >> 1;
+    const int chroma_stop = (luma_stop + 1) >> 1;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int vp8_visible_chroma_height(const VP8Context *s, int luma_start,
+                                     int block_size)
+{
+    const int luma_stop = FFMIN(luma_start + block_size, s->avctx->height);
+    const int chroma_start = luma_start >> 1;
+    const int chroma_stop = (luma_stop + 1) >> 1;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
