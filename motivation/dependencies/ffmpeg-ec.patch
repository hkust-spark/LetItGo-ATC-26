+static int hevc_emit_guess_dc_component_records(HEVCLayerContext *l,
+                                                const HEVCPPS *pps,
+                                                const AVFrame *frame,
+                                                int component)
+{
+    const HEVCSPS *sps = pps->sps;
+    const int block_width = component == 0 ? hevc_luma_dc_block_width(sps)
+                                          : hevc_chroma_dc_block_width(sps);
+    const int block_height = component == 0 ? hevc_luma_dc_block_height(sps)
+                                           : hevc_chroma_dc_block_height(sps);
+    const int block_count = block_width * block_height;
+    int *dc = NULL;
+    uint8_t *damaged = NULL;
+    int ret = 0;
+
+    if (block_count <= 0 || frame->data[component] == NULL)
+        return 0;
+
+    dc = av_malloc_array(block_count, sizeof(*dc));
+    damaged = av_mallocz(block_count);
+    if (dc == NULL || damaged == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int luma_x = component == 0 ? block_x * 8 : block_x * 16;
+            const int luma_y = component == 0 ? block_y * 8 : block_y * 16;
+            const int ctb_x = luma_x >> sps->log2_ctb_size;
+            const int ctb_y = luma_y >> sps->log2_ctb_size;
+
+            dc[index] = hevc_frame_block_dc(sps, frame, component, block_x, block_y);
+            if (ctb_x < sps->ctb_width && ctb_y < sps->ctb_height) {
+                const int ctb_addr_rs = ctb_y * sps->ctb_width + ctb_x;
+                damaged[index] = l->tab_slice_address[ctb_addr_rs] < 0;
+            }
+        }
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+            int dist[4] = { 9999, 9999, 9999, 9999 };
+            int boundary_dc[4] = { 1024, 1024, 1024, 1024 };
+            int64_t weight[4];
+            int pre_guess_dc = HEVC_PACKET_LOSS_PRE_GUESS_DC_UNAVAILABLE;
+            int pre_index = -1;
+
+            if (!damaged[index])
+                continue;
+
+            for (int x = block_x + 1; x < block_width; x++) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[0] = x - block_x;
+                    boundary_dc[0] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int x = block_x - 1; x >= 0; x--) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[1] = block_x - x;
+                    boundary_dc[1] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y + 1; y < block_height; y++) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[2] = y - block_y;
+                    boundary_dc[2] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y - 1; y >= 0; y--) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[3] = block_y - y;
+                    boundary_dc[3] = dc[neighbor];
+                    break;
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                weight[i] = 256LL * 256LL * 256LL * 16LL / FFMAX(dist[i], 1);
+
+            pre_index = hevc_packet_loss_dc_index(sps, component, block_x, block_y);
+            if (l->packet_loss_pre_dc_valid != NULL &&
+                l->packet_loss_pre_dc != NULL &&
+                pre_index >= 0 && pre_index < hevc_packet_loss_dc_block_count(sps) &&
+                l->packet_loss_pre_dc_valid[pre_index]) {
+                pre_guess_dc = l->packet_loss_pre_dc[pre_index];
+            }
+
+            ret = hevc_append_guess_dc_record(
+                l,
+                "%d,%d,%d,%d,%d,%d,%d,%d,%d,%" PRId64 ",%" PRId64
+                ",%" PRId64 ",%" PRId64 ",%d,%d,%d,%d,%d,%d\n",
+                component,
+                block_x,
+                block_y,
+                mb_x,
+                mb_y,
+                dist[0],
+                dist[1],
+                dist[2],
+                dist[3],
+                weight[0],
+                weight[1],
+                weight[2],
+                weight[3],
+                boundary_dc[0],
+                boundary_dc[1],
+                boundary_dc[2],
+                boundary_dc[3],
+                dc[index],
+                pre_guess_dc
+            );
+            if (ret < 0)
+                goto done;
+        }
+    }
+
+done:
+    av_freep(&dc);
+    av_freep(&damaged);
+    return ret;
+}
+
+static int hevc_set_guess_dc_metadata(HEVCLayerContext *l)
+{
+    HEVCFrame *out = l->cur_frame;
+    AVFrame *frame = out ? out->f : NULL;
+    const HEVCPPS *pps = out ? out->pps : NULL;
+    const HEVCSPS *sps = pps ? pps->sps : NULL;
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    hevc_reset_guess_dc_records(l);
+    if (frame != NULL)
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records", NULL, 0);
+
+    if (!hevc_guess_dc_telemetry_enabled() || frame == NULL ||
+        pps == NULL || sps == NULL || l->tab_slice_address == NULL ||
+        frame->data[0] == NULL)
+        return 0;
+
+    for (int ctb_addr_ts = 0; ctb_addr_ts < sps->ctb_width * sps->ctb_height; ctb_addr_ts++) {
+        const int ctb_addr_rs = pps->ctb_addr_ts_to_rs[ctb_addr_ts];
+        damaged_blocks += l->tab_slice_address[ctb_addr_rs] < 0;
+    }
+    if (damaged_blocks <= 0)
+        return 0;
+
+    for (int component = 0; component < 3; component++) {
+        ret = hevc_emit_guess_dc_component_records(l, pps, frame, component);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (l->packet_loss_guess_dc_records != NULL &&
+        l->packet_loss_guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
+                    l->packet_loss_guess_dc_records, 0);
+    }
+
+    if (out->frame_grain && out->frame_grain->buf[0])
+        av_dict_copy(&out->frame_grain->metadata, frame->metadata, 0);
+
+    return 0;
+}
