+
+static int vp8_append_guess_dc_record(VP8Context *s, const char *format, ...)
+{
+    va_list args;
+    va_list args_copy;
+    int required = 0;
+    size_t new_size = 0;
+
+    if (!vp8_guess_dc_telemetry_enabled())
+        return 0;
+
+    va_start(args, format);
+    va_copy(args_copy, args);
+    required = vsnprintf(NULL, 0, format, args);
+    va_end(args);
+    if (required < 0) {
+        va_end(args_copy);
+        return AVERROR(EINVAL);
+    }
+
+    new_size = s->packet_loss_guess_dc_records_size + (size_t)required;
+    if (new_size + 1 > s->packet_loss_guess_dc_records_capacity) {
+        size_t new_capacity = s->packet_loss_guess_dc_records_capacity ?
+                              s->packet_loss_guess_dc_records_capacity * 2 : 4096;
+        char *resized = NULL;
+
+        while (new_capacity < new_size + 1)
