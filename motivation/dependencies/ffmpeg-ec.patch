+static int ec_ref_available(const VVCLocalContext *lc, const int lx, const int ref_idx)
+{
+    const SliceContext *sc = lc->sc;
+
+    return sc->rpl && ref_idx >= 0 && ref_idx < sc->sh.r->num_ref_idx_active[lx] &&
+           sc->rpl[lx].refs[ref_idx].ref &&
+           sc->rpl[lx].refs[ref_idx].ref->frame->buf[0];
+}
+
+static int ec_mvf_valid(const VVCLocalContext *lc, const MvField *mvf)
+{
+    if (!mvf->pred_flag || (mvf->pred_flag & ~PF_BI))
+        return 0;
+
+    for (int lx = L0; lx <= L1; lx++) {
+        const PredFlag mask = 1 << lx;
+
+        if ((mvf->pred_flag & mask) && !ec_ref_available(lc, lx, mvf->ref_idx[lx]))
+            return 0;
+    }
+    return 1;
+}
+
+static int ec_mvf_from_neighbour(const VVCLocalContext *lc, MvField *mvf,
+    const int x, const int y)
+{
+    const VVCFrameContext *fc = lc->fc;
+    const VVCPPS *pps         = fc->ps.pps;
+
+    if (x < 0 || y < 0 || x >= pps->width || y >= pps->height)
+        return 0;
+
+    *mvf = *ff_vvc_get_mvf(fc, x, y);
+    return ec_mvf_valid(lc, mvf);
+}
+
+static int ec_guess_mvf(const VVCLocalContext *lc, MvField *mvf,
+    const int x0, const int y0, const int width, const int height)
+{
+    const VVCFrameContext *fc = lc->fc;
+    const AVCodecContext *avctx = fc->log_ctx;
+
+    if (IS_I(lc->sc->sh.r) || !(avctx->error_concealment & FF_EC_GUESS_MVS))
+        return 0;
+
+    if (ec_mvf_from_neighbour(lc, mvf, x0 - 1, y0 + (height >> 1)))
+        return 1;
+    if (ec_mvf_from_neighbour(lc, mvf, x0 + (width >> 1), y0 - 1))
+        return 1;
+
+    memset(mvf, 0, sizeof(*mvf));
+    for (int lx = L0; lx <= L1; lx++) {
+        if (ec_ref_available(lc, lx, 0)) {
+            mvf->pred_flag  = 1 << lx;
+            mvf->ref_idx[lx] = 0;
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+static void ec_set_pred_mode(VVCLocalContext *lc, CodingUnit *cu,
+    const PredMode pred_mode)
+{
+    VVCFrameContext *fc = lc->fc;
+    const H266RawSPS *rsps = fc->ps.sps->r;
+
+    cu->pred_mode = pred_mode;
+    set_cb_tab(lc, fc->tab.cpm[LUMA], pred_mode);
+    if (rsps->sps_chroma_format_idc && cu->tree_type == SINGLE_TREE)
+        set_cb_tab(lc, fc->tab.cpm[CHROMA], pred_mode);
+}
+
+static int ec_add_concealed_cu(VVCLocalContext *lc, const int x0, const int y0,
+    const int width, const int height)
+{
+    VVCFrameContext *fc = lc->fc;
+    CodingUnit *cu;
+    MvField mvf;
+    int ret;
+
+    cu = add_cu(lc, x0, y0, width, height, 0, SINGLE_TREE);
+    if (!cu)
+        return AVERROR(ENOMEM);
+
+    lc->parse.is_cu_qp_delta_coded = 0;
+    lc->parse.cu_qg_top_left_x = x0;
+    lc->parse.cu_qg_top_left_y = y0;
+    lc->parse.is_cu_chroma_qp_offset_coded = 0;
+    memset(lc->parse.chroma_qp_offset, 0, sizeof(lc->parse.chroma_qp_offset));
+
+    cu->coded_flag = 0;
+    set_cb_tab(lc, fc->tab.imf, 0);
+
+    if (ec_guess_mvf(lc, &mvf, x0, y0, width, height)) {
+        MotionInfo *mi = &cu->pu.mi;
+
+        ec_set_pred_mode(lc, cu, MODE_INTER);
+        cu->skip_flag = 1;
+        mi->pred_flag = mvf.pred_flag;
+        mi->hpel_if_idx = mvf.hpel_if_idx;
+        mi->bcw_idx = mvf.bcw_idx;
+        mi->motion_model_idc = MOTION_TRANSLATION;
+        mi->num_sb_x = mi->num_sb_y = 1;
+        for (int lx = L0; lx <= L1; lx++) {
+            const PredFlag mask = 1 << lx;
+
+            if (mvf.pred_flag & mask) {
+                mi->ref_idx[lx] = mvf.ref_idx[lx];
+                mi->mv[lx][0] = mvf.mv[lx];
+            }
+        }
+        ff_vvc_store_mvf(lc, &mvf);
+        fc->tab.ec_status[(y0 >> fc->ps.sps->ctb_log2_size_y) * fc->ps.pps->ctb_width +
+                          (x0 >> fc->ps.sps->ctb_log2_size_y)] |= VVC_EC_CTU_INTER_CONCEALED;
+    } else {
+        ec_set_pred_mode(lc, cu, MODE_INTRA);
+        cu->intra_pred_mode_y = INTRA_DC;
+        cu->intra_pred_mode_c = INTRA_DC;
+        set_cb_tab(lc, fc->tab.ipm, cu->intra_pred_mode_y);
+        ff_vvc_set_intra_mvf(lc, false, PF_INTRA, false);
+    }
+
+    ret = skipped_transform_tree_unit(lc);
+    if (ret < 0)
+        return ret;
+
+    set_cu_tabs(lc, cu);
+    return 0;
+}
+
+static int ec_largest_block(const int pos, const int end, const int max_size,
+    const int min_size)
+{
+    const int remaining = end - pos;
+
+    for (int size = max_size; size >= min_size; size >>= 1) {
+        if (size <= remaining && !(pos & (size - 1)))
+            return size;
+    }
+    return remaining;
+}
+
+int ff_vvc_conceal_coding_tree_unit(VVCLocalContext *lc,
+    const int ctu_idx, const int rs, const int rx, const int ry)
+{
+    VVCFrameContext *fc         = lc->fc;
+    const VVCSPS *sps           = fc->ps.sps;
+    const VVCPPS *pps           = fc->ps.pps;
+    const int x_ctb             = rx << sps->ctb_log2_size_y;
+    const int y_ctb             = ry << sps->ctb_log2_size_y;
+    const int x_end             = FFMIN(x_ctb + sps->ctb_size_y, pps->width);
+    const int y_end             = FFMIN(y_ctb + sps->ctb_size_y, pps->height);
+    const int ctb_size          = sps->ctb_size_y * sps->ctb_size_y;
+    EntryPoint *ep              = lc->ep;
+    int ret;
+
+    ff_vvc_ctu_free_cus(fc->tab.cus + rs);
+    memset(fc->tab.ctus + rs, 0, sizeof(*fc->tab.ctus));
+
+    fc->tab.ec_status[rs] |= VVC_EC_CTU_CONCEALED;
+
+    if (rx == pps->ctb_to_col_bd[rx]) {
+        ep->num_hmvp = 0;
+        ep->num_hmvp_ibc = 0;
+        ep->is_first_qg = ry == pps->ctb_to_row_bd[ry] || !ctu_idx;
+    }
+
+    lc->coeffs = fc->tab.coeffs + rs * ctb_size * VVC_MAX_SAMPLE_ARRAYS;
+    lc->cu     = NULL;
+    memset(&lc->parse, 0, sizeof(lc->parse));
+
+    deblock_params(lc, rx, ry);
+    memset(&CTB(fc->tab.sao, rx, ry), 0, sizeof(*fc->tab.sao));
+    memset(&CTB(fc->tab.alf, rx, ry), 0, sizeof(*fc->tab.alf));
+
+    for (int y = y_ctb; y < y_end;) {
+        const int height = ec_largest_block(y, y_end, sps->ctb_size_y, sps->min_cb_size_y);
+
+        for (int x = x_ctb; x < x_end;) {
+            const int width = ec_largest_block(x, x_end, sps->ctb_size_y, sps->min_cb_size_y);
+
+            ret = ec_add_concealed_cu(lc, x, y, width, height);
+            if (ret < 0)
+                return ret;
+
+            x += width;
+        }
+        y += height;
+    }
+
+    ctu_get_pred(lc, rs);
+    return 0;
+}
