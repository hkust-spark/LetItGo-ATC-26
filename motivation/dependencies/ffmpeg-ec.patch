+static void aom_reset_guess_dc_records(AV1DecodeContext *ctx)
+{
+    if (ctx->packet_loss_guess_dc_records != NULL &&
+        ctx->packet_loss_guess_dc_records_capacity > 0)
+        ctx->packet_loss_guess_dc_records[0] = '\0';
+    ctx->packet_loss_guess_dc_records_size = 0;
+}
+
+static int aom_append_guess_dc_record(AV1DecodeContext *ctx,
+                                      const char *format, ...)
+{
+    va_list args;
+    va_list args_copy;
+    int required = 0;
+    size_t new_size = 0;
+
+    if (!aom_guess_dc_telemetry_enabled())
+        return 0;
+
+    va_start(args, format);
+    va_copy(args_copy, args);
+    required = vsnprintf(NULL, 0, format, args);
+    va_end(args);
+    if (required < 0) {
+        va_end(args_copy);
+        return AVERROR(EINVAL);
+    }
+
+    new_size = ctx->packet_loss_guess_dc_records_size + (size_t)required;
+    if (new_size + 1 > ctx->packet_loss_guess_dc_records_capacity) {
+        size_t new_capacity = ctx->packet_loss_guess_dc_records_capacity ?
+                              ctx->packet_loss_guess_dc_records_capacity * 2 : 4096;
+        char *resized = NULL;
+
+        while (new_capacity < new_size + 1)
+            new_capacity *= 2;
+        resized = av_realloc(ctx->packet_loss_guess_dc_records, new_capacity);
+        if (resized == NULL) {
+            va_end(args_copy);
+            return AVERROR(ENOMEM);
+        }
+        ctx->packet_loss_guess_dc_records = resized;
+        ctx->packet_loss_guess_dc_records_capacity = new_capacity;
+    }
+
+    vsnprintf(ctx->packet_loss_guess_dc_records +
+              ctx->packet_loss_guess_dc_records_size,
+              ctx->packet_loss_guess_dc_records_capacity -
+              ctx->packet_loss_guess_dc_records_size,
+              format, args_copy);
+    va_end(args_copy);
+    ctx->packet_loss_guess_dc_records_size = new_size;
+    return 0;
+}
