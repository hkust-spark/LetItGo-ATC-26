+static int hevc_guess_mv_sample_index(const HEVCSPS *sps, int luma_x, int luma_y)
+{
+    const int sample_x = av_clip(luma_x, 0, sps->width - 1);
+    const int sample_y = av_clip(luma_y, 0, sps->height - 1);
+    const int pu_x = FFMIN(sample_x >> sps->log2_min_pu_size,
+                           sps->min_pu_width - 1);
+    const int pu_y = FFMIN(sample_y >> sps->log2_min_pu_size,
+                           sps->min_pu_height - 1);
+
+    return pu_y * sps->min_pu_width + pu_x;
+}
+
+static int hevc_guess_mv_cell_is_damaged(const HEVCLayerContext *l,
+                                         const HEVCSPS *sps,
+                                         int mb_x, int mb_y)
+{
+    const int luma_x = mb_x * 16;
+    const int luma_y = mb_y * 16;
+    const int ctb_x = luma_x >> sps->log2_ctb_size;
+    const int ctb_y = luma_y >> sps->log2_ctb_size;
+
+    if (l->tab_slice_address == NULL ||
+        ctb_x < 0 || ctb_y < 0 ||
+        ctb_x >= sps->ctb_width || ctb_y >= sps->ctb_height)
+        return 0;
+
+    return l->tab_slice_address[ctb_y * sps->ctb_width + ctb_x] < 0;
+}
+
+static void hevc_guess_mv_add_frontier_cell(uint8_t *state,
+                                            const uint8_t *damaged,
+                                            int *frontier,
+                                            int *frontier_length,
+                                            int mb_width, int mb_height,
+                                            int mb_x, int mb_y)
+{
+    int index;
+
+    if (mb_x < 0 || mb_y < 0 || mb_x >= mb_width || mb_y >= mb_height)
+        return;
+
+    index = mb_y * mb_width + mb_x;
+    if (!damaged[index] || state[index] != HEVC_GUESS_MV_UNKNOWN)
+        return;
+
+    state[index] = HEVC_GUESS_MV_LISTED;
+    frontier[(*frontier_length)++] = index;
+}
+
+static void hevc_guess_mv_add_frontier_neighbors(uint8_t *state,
+                                                 const uint8_t *damaged,
+                                                 int *frontier,
+                                                 int *frontier_length,
+                                                 int mb_width, int mb_height,
+                                                 int index)
+{
+    const int mb_x = index % mb_width;
+    const int mb_y = index / mb_width;
+
+    hevc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                    mb_width, mb_height, mb_x - 1, mb_y);
+    hevc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                    mb_width, mb_height, mb_x + 1, mb_y);
+    hevc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                    mb_width, mb_height, mb_x, mb_y - 1);
+    hevc_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                    mb_width, mb_height, mb_x, mb_y + 1);
+}
+
+static int hevc_emit_guess_mv_truth_records(HEVCLayerContext *l,
+                                            const HEVCSPS *sps)
+{
+    HEVCFrame *out = l->cur_frame;
+    const MvField *tab_mvf = out ? out->tab_mvf : NULL;
+    const int mb_width = (sps->width + 15) / 16;
+    const int mb_height = (sps->height + 15) / 16;
+    int ret = 0;
+
+    if (tab_mvf == NULL)
+        return 0;
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int sample_x = FFMIN(mb_x * 16 + 8, sps->width - 1);
+            const int sample_y = FFMIN(mb_y * 16 + 8, sps->height - 1);
+            const int pu_index = hevc_guess_mv_sample_index(sps, sample_x, sample_y);
+            int mv_x = 0;
+            int mv_y = 0;
+            int ref_idx = 0;
+
+            if (!hevc_guess_mv_from_mvf(&tab_mvf[pu_index], &mv_x, &mv_y, &ref_idx))
+                continue;
+
+            ret = hevc_append_guess_mv_record(l, "%d,%d,%d,%d,%d,4\n",
+                                              mb_x, mb_y, mv_x, mv_y, ref_idx);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return 0;
+}
+
+static int hevc_emit_guess_mv_bfs_records(HEVCLayerContext *l,
+                                          const HEVCSPS *sps)
+{
+    HEVCFrame *out = l->cur_frame;
+    const MvField *tab_mvf = out ? out->tab_mvf : NULL;
+    const int mb_width = (sps->width + 15) / 16;
+    const int mb_height = (sps->height + 15) / 16;
+    const int cell_count = mb_width * mb_height;
+    uint8_t *state = NULL;
+    uint8_t *damaged = NULL;
+    int *mv_x = NULL;
+    int *mv_y = NULL;
+    int *ref_idx = NULL;
+    int *frontier = NULL;
+    int *next_frontier = NULL;
+    int *newly_fixed = NULL;
+    int frontier_length = 0;
+    int ret = 0;
+
+    if (tab_mvf == NULL || cell_count <= 0)
+        return 0;
+
+    state = av_mallocz(cell_count);
+    damaged = av_mallocz(cell_count);
+    mv_x = av_malloc_array(cell_count, sizeof(*mv_x));
+    mv_y = av_malloc_array(cell_count, sizeof(*mv_y));
+    ref_idx = av_malloc_array(cell_count, sizeof(*ref_idx));
+    frontier = av_malloc_array(cell_count, sizeof(*frontier));
+    next_frontier = av_malloc_array(cell_count, sizeof(*next_frontier));
+    newly_fixed = av_malloc_array(cell_count, sizeof(*newly_fixed));
+    if (state == NULL || damaged == NULL || mv_x == NULL || mv_y == NULL ||
+        ref_idx == NULL || frontier == NULL || next_frontier == NULL ||
+        newly_fixed == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int index = mb_y * mb_width + mb_x;
+            const int sample_x = FFMIN(mb_x * 16 + 8, sps->width - 1);
+            const int sample_y = FFMIN(mb_y * 16 + 8, sps->height - 1);
+            const int pu_index = hevc_guess_mv_sample_index(sps, sample_x, sample_y);
+
+            damaged[index] = hevc_guess_mv_cell_is_damaged(l, sps, mb_x, mb_y);
+            if (!damaged[index] &&
+                hevc_guess_mv_from_mvf(&tab_mvf[pu_index],
+                                       &mv_x[index], &mv_y[index], &ref_idx[index])) {
+                state[index] = HEVC_GUESS_MV_FIXED;
+            }
+        }
+    }
+
+    for (int index = 0; index < cell_count; index++) {
+        if (state[index] == HEVC_GUESS_MV_FIXED)
+            hevc_guess_mv_add_frontier_neighbors(state, damaged, frontier,
+                                                 &frontier_length, mb_width,
+                                                 mb_height, index);
+    }
+
+    for (int hop_count = 1; frontier_length > 0; hop_count++) {
+        int next_frontier_length = 0;
+        int newly_fixed_length = 0;
+
+        for (int frontier_index = 0; frontier_index < frontier_length; frontier_index++) {
+            const int index = frontier[frontier_index];
+            const int mb_x = index % mb_width;
+            const int mb_y = index / mb_width;
+            int pred_count = 0;
+            int sum_x = 0;
+            int sum_y = 0;
+            int sum_ref = 0;
+
+#define HEVC_ACCUM_FIXED_MV(nx, ny) do {                                      \
+                const int neighbor_x = (nx);                                  \
+                const int neighbor_y = (ny);                                  \
+                if (neighbor_x >= 0 && neighbor_y >= 0 &&                     \
+                    neighbor_x < mb_width && neighbor_y < mb_height) {        \
+                    const int neighbor_index =                                \
+                        neighbor_y * mb_width + neighbor_x;                   \
+                    if (state[neighbor_index] == HEVC_GUESS_MV_FIXED) {       \
+                        sum_x += mv_x[neighbor_index];                        \
+                        sum_y += mv_y[neighbor_index];                        \
+                        sum_ref += ref_idx[neighbor_index];                   \
+                        pred_count++;                                         \
+                    }                                                         \
+                }                                                             \
+            } while (0)
+
+            HEVC_ACCUM_FIXED_MV(mb_x - 1, mb_y);
+            HEVC_ACCUM_FIXED_MV(mb_x + 1, mb_y);
+            HEVC_ACCUM_FIXED_MV(mb_x, mb_y - 1);
+            HEVC_ACCUM_FIXED_MV(mb_x, mb_y + 1);
+#undef HEVC_ACCUM_FIXED_MV
+
+            if (pred_count <= 0) {
+                state[index] = HEVC_GUESS_MV_UNKNOWN;
+                continue;
+            }
+
+            mv_x[index] = sum_x / pred_count;
+            mv_y[index] = sum_y / pred_count;
+            ref_idx[index] = sum_ref / pred_count;
+            ret = hevc_append_guess_mv_record(l, "%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                                              mb_x, mb_y, hop_count, 0,
+                                              pred_count, mv_x[index],
+                                              mv_y[index], ref_idx[index], -1);
+            if (ret < 0)
+                goto done;
+
+            newly_fixed[newly_fixed_length++] = index;
+        }
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            state[newly_fixed[i]] = HEVC_GUESS_MV_FIXED;
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            hevc_guess_mv_add_frontier_neighbors(state, damaged, next_frontier,
+                                                 &next_frontier_length, mb_width,
+                                                 mb_height, newly_fixed[i]);
+
+        FFSWAP(int *, frontier, next_frontier);
+        frontier_length = next_frontier_length;
+    }
+
+done:
+    av_freep(&state);
+    av_freep(&damaged);
+    av_freep(&mv_x);
+    av_freep(&mv_y);
+    av_freep(&ref_idx);
+    av_freep(&frontier);
+    av_freep(&next_frontier);
+    av_freep(&newly_fixed);
+    return ret;
+}
+
+static int hevc_set_guess_mv_metadata(HEVCLayerContext *l)
+{
+    HEVCFrame *out = l->cur_frame;
+    AVFrame *frame = out ? out->f : NULL;
+    const HEVCPPS *pps = out ? out->pps : NULL;
+    const HEVCSPS *sps = pps ? pps->sps : NULL;
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    hevc_reset_guess_mv_records(l);
+    if (frame != NULL) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_records", NULL, 0);
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    }
+
+    if (frame == NULL || pps == NULL || sps == NULL || l->tab_slice_address == NULL)
+        return 0;
+
+    if (hevc_guess_mv_truth_enabled()) {
+        ret = hevc_emit_guess_mv_truth_records(l, sps);
+        if (ret < 0)
+            return ret;
+        if (l->packet_loss_guess_mv_records != NULL &&
+            l->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records",
+                        l->packet_loss_guess_mv_records, 0);
+        }
+        hevc_reset_guess_mv_records(l);
+    }
+
+    if (hevc_guess_mv_telemetry_enabled()) {
+        for (int ctb_addr_ts = 0; ctb_addr_ts < sps->ctb_width * sps->ctb_height; ctb_addr_ts++) {
+            const int ctb_addr_rs = pps->ctb_addr_ts_to_rs[ctb_addr_ts];
+            damaged_blocks += l->tab_slice_address[ctb_addr_rs] < 0;
+        }
+        if (damaged_blocks > 0) {
+            ret = hevc_emit_guess_mv_bfs_records(l, sps);
+            if (ret < 0)
+                return ret;
+            if (l->packet_loss_guess_mv_records != NULL &&
+                l->packet_loss_guess_mv_records_size > 0) {
+                av_dict_set(&frame->metadata, "packet_loss.guess_mv_records",
+                            l->packet_loss_guess_mv_records, 0);
+            }
+        }
+    }
+
+    if (out->frame_grain && out->frame_grain->buf[0])
+        av_dict_copy(&out->frame_grain->metadata, frame->metadata, 0);
+
+    return 0;
+}
+
+static void hevc_set_error_block_metadata(HEVCLayerContext *l)
+{
+    HEVCFrame *out = l->cur_frame;
+    AVFrame *frame = out ? out->f : NULL;
+    const HEVCPPS *pps = out ? out->pps : NULL;
+    const HEVCSPS *sps = pps ? pps->sps : NULL;
+    int total_blocks;
+    int damaged_blocks = 0;
+    int ctb_size;
+
+    if (!frame || !pps || !sps || !l->tab_slice_address)
+        return;
+
+    total_blocks = sps->ctb_width * sps->ctb_height;
+    ctb_size = 1 << sps->log2_ctb_size;
+
+    for (int ctb_addr_ts = 0; ctb_addr_ts < total_blocks; ctb_addr_ts++) {
+        const int ctb_addr_rs = pps->ctb_addr_ts_to_rs[ctb_addr_ts];
+        if (l->tab_slice_address[ctb_addr_rs] < 0)
+            damaged_blocks++;
+    }
+
+    if (damaged_blocks > 0) {
+        out->flags |= HEVC_FRAME_FLAG_CORRUPT;
+        frame->flags |= AV_FRAME_FLAG_CORRUPT;
+        frame->decode_error_flags |= FF_DECODE_ERROR_DECODE_SLICES |
+                                     FF_DECODE_ERROR_CONCEALMENT_ACTIVE;
+    }
+
+    av_dict_set(&frame->metadata, "packet_loss.error_unit", "CTB", 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_width", ctb_size, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_unit_height", ctb_size, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_total_blocks", total_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_damaged_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_ctb_count", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_concealed_blocks", damaged_blocks, 0);
+    av_dict_set_int(&frame->metadata, "packet_loss.error_inter_concealed_blocks", 0, 0);
+
+    if (out->frame_grain && out->frame_grain->buf[0])
+        av_dict_copy(&out->frame_grain->metadata, frame->metadata, 0);
+}
 
