+static void hevc_record_pre_filter_ctb_dc(const HEVCLayerContext *l,
+                                          const HEVCSPS *sps,
+                                          int x_ctb, int y_ctb)
+{
+    const AVFrame *frame = l->cur_frame ? l->cur_frame->f : NULL;
+    const int ctb_size = 1 << sps->log2_ctb_size;
+
+    if (!hevc_guess_dc_telemetry_enabled() ||
+        l->packet_loss_pre_dc == NULL ||
+        l->packet_loss_pre_dc_valid == NULL ||
+        frame == NULL || frame->data[0] == NULL)
+        return;
+
+    for (int block_y = y_ctb / 8;
+         block_y < FFMIN((y_ctb + ctb_size) / 8, hevc_luma_dc_block_height(sps));
+         block_y++) {
+        for (int block_x = x_ctb / 8;
+             block_x < FFMIN((x_ctb + ctb_size) / 8, hevc_luma_dc_block_width(sps));
+             block_x++) {
+            const int index = hevc_packet_loss_dc_index(sps, 0, block_x, block_y);
+            l->packet_loss_pre_dc[index] = hevc_frame_block_dc(sps, frame, 0, block_x, block_y);
+            l->packet_loss_pre_dc_valid[index] = 1;
+        }
+    }
+
+    for (int component = 1; component < 3; component++) {
+        const int chroma_block_y_start = y_ctb / 16;
+        const int chroma_block_x_start = x_ctb / 16;
+        const int chroma_block_y_stop = FFMIN((y_ctb + ctb_size) / 16,
+                                              hevc_chroma_dc_block_height(sps));
+        const int chroma_block_x_stop = FFMIN((x_ctb + ctb_size) / 16,
+                                              hevc_chroma_dc_block_width(sps));
+
+        if (frame->data[component] == NULL)
+            continue;
+
+        for (int block_y = chroma_block_y_start; block_y < chroma_block_y_stop; block_y++) {
+            for (int block_x = chroma_block_x_start; block_x < chroma_block_x_stop; block_x++) {
+                const int index = hevc_packet_loss_dc_index(sps, component, block_x, block_y);
+                l->packet_loss_pre_dc[index] = hevc_frame_block_dc(
+                    sps, frame, component, block_x, block_y);
+                l->packet_loss_pre_dc_valid[index] = 1;
+            }
+        }
+    }
+}
