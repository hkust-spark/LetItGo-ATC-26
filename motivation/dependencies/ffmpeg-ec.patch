+static int vp9_visible_width(const VP9Context *s)
+{
+    const AVFrame *frame = s->s.frames[CUR_FRAME].tf.f;
+    return frame != NULL && frame->width > 0 ? frame->width : s->w;
+}
+
+static int vp9_visible_height(const VP9Context *s)
+{
+    const AVFrame *frame = s->s.frames[CUR_FRAME].tf.f;
+    return frame != NULL && frame->height > 0 ? frame->height : s->h;
+}
+
+static int vp9_luma_dc_block_width(const VP9Context *s)
+{
+    return (vp9_visible_width(s) + 7) / 8;
+}
+
+static int vp9_luma_dc_block_height(const VP9Context *s)
+{
+    return (vp9_visible_height(s) + 7) / 8;
+}
+
+static int vp9_chroma_dc_block_width(const VP9Context *s)
+{
+    return (vp9_visible_width(s) + 15) / 16;
+}
+
+static int vp9_chroma_dc_block_height(const VP9Context *s)
+{
+    return (vp9_visible_height(s) + 15) / 16;
+}
+
+static int vp9_packet_loss_dc_block_count(const VP9Context *s)
+{
+    return vp9_luma_dc_block_width(s) * vp9_luma_dc_block_height(s) +
+           2 * vp9_chroma_dc_block_width(s) * vp9_chroma_dc_block_height(s);
+}
+
+static int vp9_packet_loss_dc_index(const VP9Context *s,
+                                    int component, int block_x, int block_y)
+{
+    const int luma_count = vp9_luma_dc_block_width(s) * vp9_luma_dc_block_height(s);
+    const int chroma_width = vp9_chroma_dc_block_width(s);
+    const int chroma_count = chroma_width * vp9_chroma_dc_block_height(s);
+
+    if (component == 0)
+        return block_y * vp9_luma_dc_block_width(s) + block_x;
+    return luma_count + (component - 1) * chroma_count +
+           block_y * chroma_width + block_x;
+}
+
+static int vp9_visible_luma_extent(const VP9Context *s, int luma_start,
+                                   int block_size)
+{
+    const int visible = vp9_visible_width(s) - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vp9_visible_luma_height(const VP9Context *s, int luma_start,
+                                   int block_size)
+{
+    const int visible = vp9_visible_height(s) - luma_start;
+    if (visible <= 0)
+        return 0;
+    return FFMIN(block_size, visible);
+}
+
+static int vp9_visible_chroma_extent(const VP9Context *s, int luma_start,
+                                     int block_size)
+{
+    const int luma_stop = FFMIN(luma_start + block_size, vp9_visible_width(s));
+    const int chroma_start = luma_start >> s->ss_h;
+    const int chroma_stop = (luma_stop + (1 << s->ss_h) - 1) >> s->ss_h;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int vp9_visible_chroma_height(const VP9Context *s, int luma_start,
+                                     int block_size)
+{
+    const int luma_stop = FFMIN(luma_start + block_size, vp9_visible_height(s));
+    const int chroma_start = luma_start >> s->ss_v;
+    const int chroma_stop = (luma_stop + (1 << s->ss_v) - 1) >> s->ss_v;
+    return FFMAX(chroma_stop - chroma_start, 0);
+}
+
+static int vp9_scaled_block_mean(const uint8_t *src, ptrdiff_t stride,
+                                 int width, int height, int bytesperpixel)
+{
+    int64_t sample_sum = 0;
+    int sample_count = width * height;
+
+    if (src == NULL || width <= 0 || height <= 0)
+        return 1024;
+
+    for (int y = 0; y < height; y++) {
+        const uint8_t *row = src + (ptrdiff_t)y * stride;
+        for (int x = 0; x < width; x++) {
+            if (bytesperpixel == 1)
+                sample_sum += row[x];
+            else
+                sample_sum += AV_RN16(row + (ptrdiff_t)x * bytesperpixel);
+        }
+    }
+
+    return (int)((sample_sum * 8 + sample_count / 2) / sample_count);
+}
+
+static int vp9_frame_block_dc(const VP9Context *s, const AVFrame *frame,
+                              int component, int block_x, int block_y)
+{
+    if (component == 0) {
+        const int luma_x = block_x * 8;
+        const int luma_y = block_y * 8;
+        const int block_w = vp9_visible_luma_extent(s, luma_x, 8);
+        const int block_h = vp9_visible_luma_height(s, luma_y, 8);
+        return vp9_scaled_block_mean(
+            frame->data[0] + (ptrdiff_t)luma_y * frame->linesize[0] +
+            (ptrdiff_t)luma_x * s->bytesperpixel,
+            frame->linesize[0], block_w, block_h, s->bytesperpixel);
+    } else {
+        const int luma_x = block_x * 16;
+        const int luma_y = block_y * 16;
+        const int chroma_x = luma_x >> s->ss_h;
+        const int chroma_y = luma_y >> s->ss_v;
+        const int block_w = vp9_visible_chroma_extent(s, luma_x, 16);
+        const int block_h = vp9_visible_chroma_height(s, luma_y, 16);
+        return vp9_scaled_block_mean(
+            frame->data[component] + (ptrdiff_t)chroma_y * frame->linesize[component] +
+            (ptrdiff_t)chroma_x * s->bytesperpixel,
+            frame->linesize[component], block_w, block_h, s->bytesperpixel);
+    }
+}
+
+static void vp9_reset_guess_dc_records(VP9Context *s)
+{
+    if (s->packet_loss_guess_dc_records != NULL &&
+        s->packet_loss_guess_dc_records_capacity > 0)
+        s->packet_loss_guess_dc_records[0] = '\0';
+    s->packet_loss_guess_dc_records_size = 0;
+}
+
+static int vp9_append_guess_dc_record(VP9Context *s, const char *format, ...)
+{
+    va_list args;
+    va_list args_copy;
+    int required = 0;
+    size_t new_size = 0;
+
+    if (!vp9_guess_dc_telemetry_enabled())
+        return 0;
+
+    va_start(args, format);
+    va_copy(args_copy, args);
+    required = vsnprintf(NULL, 0, format, args);
+    va_end(args);
+    if (required < 0) {
+        va_end(args_copy);
+        return AVERROR(EINVAL);
+    }
+
+    new_size = s->packet_loss_guess_dc_records_size + (size_t)required;
+    if (new_size + 1 > s->packet_loss_guess_dc_records_capacity) {
+        size_t new_capacity = s->packet_loss_guess_dc_records_capacity ?
+                              s->packet_loss_guess_dc_records_capacity * 2 : 4096;
+        char *resized = NULL;
+
+        while (new_capacity < new_size + 1)
+            new_capacity *= 2;
+        resized = av_realloc(s->packet_loss_guess_dc_records, new_capacity);
+        if (resized == NULL) {
+            va_end(args_copy);
+            return AVERROR(ENOMEM);
+        }
+        s->packet_loss_guess_dc_records = resized;
+        s->packet_loss_guess_dc_records_capacity = new_capacity;
+    }
+
+    vsnprintf(s->packet_loss_guess_dc_records +
+              s->packet_loss_guess_dc_records_size,
+              s->packet_loss_guess_dc_records_capacity -
+              s->packet_loss_guess_dc_records_size,
+              format, args_copy);
+    va_end(args_copy);
+    s->packet_loss_guess_dc_records_size = new_size;
+    return 0;
+}
+
+static void vp9_record_pre_filter_sb_dc(VP9Context *s, const AVFrame *frame,
+                                        int row, int col)
+{
+    if (!vp9_guess_dc_telemetry_enabled() ||
+        s->packet_loss_pre_dc == NULL ||
+        s->packet_loss_pre_dc_valid == NULL ||
+        frame == NULL || frame->data[0] == NULL ||
+        frame->data[1] == NULL || frame->data[2] == NULL)
+        return;
+
+    for (int block_y = row; block_y < FFMIN(row + 8, vp9_luma_dc_block_height(s)); block_y++) {
+        for (int block_x = col; block_x < FFMIN(col + 8, vp9_luma_dc_block_width(s)); block_x++) {
+            const int index = vp9_packet_loss_dc_index(s, 0, block_x, block_y);
+            s->packet_loss_pre_dc[index] = vp9_frame_block_dc(s, frame, 0, block_x, block_y);
+            s->packet_loss_pre_dc_valid[index] = 1;
+        }
+    }
+
+    for (int component = 1; component < 3; component++) {
+        const int chroma_block_y_start = row / 2;
+        const int chroma_block_x_start = col / 2;
+        const int chroma_block_y_stop = FFMIN(chroma_block_y_start + 4,
+                                              vp9_chroma_dc_block_height(s));
+        const int chroma_block_x_stop = FFMIN(chroma_block_x_start + 4,
+                                              vp9_chroma_dc_block_width(s));
+
+        for (int block_y = chroma_block_y_start; block_y < chroma_block_y_stop; block_y++) {
+            for (int block_x = chroma_block_x_start; block_x < chroma_block_x_stop; block_x++) {
+                const int index = vp9_packet_loss_dc_index(s, component, block_x, block_y);
+                s->packet_loss_pre_dc[index] = vp9_frame_block_dc(
+                    s, frame, component, block_x, block_y);
+                s->packet_loss_pre_dc_valid[index] = 1;
+            }
+        }
+    }
+}
+
+static int vp9_emit_guess_dc_component_records(VP9Context *s,
+                                               const AVFrame *frame,
+                                               int component)
+{
+    const int block_width = component == 0 ? vp9_luma_dc_block_width(s)
+                                          : vp9_chroma_dc_block_width(s);
+    const int block_height = component == 0 ? vp9_luma_dc_block_height(s)
+                                           : vp9_chroma_dc_block_height(s);
+    const int block_count = block_width * block_height;
+    int *dc = NULL;
+    uint8_t *damaged = NULL;
+    int ret = 0;
+
+    if (block_count <= 0)
+        return 0;
+
+    dc = av_malloc_array(block_count, sizeof(*dc));
+    damaged = av_mallocz(block_count);
+    if (dc == NULL || damaged == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int sb_x = component == 0 ? block_x / 8 : block_x / 4;
+            const int sb_y = component == 0 ? block_y / 8 : block_y / 4;
+
+            dc[index] = vp9_frame_block_dc(s, frame, component, block_x, block_y);
+            if (sb_x < s->sb_cols && sb_y < s->sb_rows)
+                damaged[index] = !!s->packet_loss_sb_damage[sb_y * s->sb_cols + sb_x];
+        }
+    }
+
+    for (int block_y = 0; block_y < block_height; block_y++) {
+        for (int block_x = 0; block_x < block_width; block_x++) {
+            const int index = block_y * block_width + block_x;
+            const int mb_x = component == 0 ? block_x / 2 : block_x;
+            const int mb_y = component == 0 ? block_y / 2 : block_y;
+            int dist[4] = { 9999, 9999, 9999, 9999 };
+            int boundary_dc[4] = { 1024, 1024, 1024, 1024 };
+            int64_t weight[4];
+            int pre_guess_dc = VP9_PACKET_LOSS_PRE_GUESS_DC_UNAVAILABLE;
+            int pre_index = -1;
+
+            if (!damaged[index])
+                continue;
+
+            for (int x = block_x + 1; x < block_width; x++) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[0] = x - block_x;
+                    boundary_dc[0] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int x = block_x - 1; x >= 0; x--) {
+                const int neighbor = block_y * block_width + x;
+                if (!damaged[neighbor]) {
+                    dist[1] = block_x - x;
+                    boundary_dc[1] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y + 1; y < block_height; y++) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[2] = y - block_y;
+                    boundary_dc[2] = dc[neighbor];
+                    break;
+                }
+            }
+            for (int y = block_y - 1; y >= 0; y--) {
+                const int neighbor = y * block_width + block_x;
+                if (!damaged[neighbor]) {
+                    dist[3] = block_y - y;
+                    boundary_dc[3] = dc[neighbor];
+                    break;
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                weight[i] = 256LL * 256LL * 256LL * 16LL / FFMAX(dist[i], 1);
+
+            pre_index = vp9_packet_loss_dc_index(s, component, block_x, block_y);
+            if (s->packet_loss_pre_dc_valid != NULL &&
+                s->packet_loss_pre_dc != NULL &&
+                pre_index >= 0 && pre_index < vp9_packet_loss_dc_block_count(s) &&
+                s->packet_loss_pre_dc_valid[pre_index]) {
+                pre_guess_dc = s->packet_loss_pre_dc[pre_index];
+            }
+
+            ret = vp9_append_guess_dc_record(
+                s,
+                "%d,%d,%d,%d,%d,%d,%d,%d,%d,%" PRId64 ",%" PRId64
+                ",%" PRId64 ",%" PRId64 ",%d,%d,%d,%d,%d,%d\n",
+                component,
+                block_x,
+                block_y,
+                mb_x,
+                mb_y,
+                dist[0],
+                dist[1],
+                dist[2],
+                dist[3],
+                weight[0],
+                weight[1],
+                weight[2],
+                weight[3],
+                boundary_dc[0],
+                boundary_dc[1],
+                boundary_dc[2],
+                boundary_dc[3],
+                dc[index],
+                pre_guess_dc
+            );
+            if (ret < 0)
+                goto done;
+        }
+    }
+
+done:
+    av_freep(&dc);
+    av_freep(&damaged);
+    return ret;
+}
+
+static int vp9_set_guess_dc_metadata(VP9Context *s, AVFrame *frame)
+{
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vp9_reset_guess_dc_records(s);
+    if (frame != NULL)
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records", NULL, 0);
+
+    if (!vp9_guess_dc_telemetry_enabled() || frame == NULL ||
+        s->packet_loss_sb_damage == NULL ||
+        frame->data[0] == NULL || frame->data[1] == NULL || frame->data[2] == NULL)
+        return 0;
+
+    for (int i = 0; i < s->sb_cols * s->sb_rows; i++)
+        damaged_blocks += !!s->packet_loss_sb_damage[i];
+    if (damaged_blocks <= 0)
+        return 0;
+
+    for (int component = 0; component < 3; component++) {
+        ret = vp9_emit_guess_dc_component_records(s, frame, component);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (s->packet_loss_guess_dc_records != NULL &&
+        s->packet_loss_guess_dc_records_size > 0) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_dc_records",
+                    s->packet_loss_guess_dc_records, 0);
+    }
+
+    return 0;
+}
+
+static void vp9_reset_guess_mv_records(VP9Context *s)
+{
+    if (s->packet_loss_guess_mv_records != NULL &&
+        s->packet_loss_guess_mv_records_capacity > 0)
+        s->packet_loss_guess_mv_records[0] = '\0';
+    s->packet_loss_guess_mv_records_size = 0;
+}
+
+static int vp9_append_guess_mv_record(VP9Context *s, const char *format, ...)
+{
+    va_list args;
+    va_list args_copy;
+    int required = 0;
+    size_t new_size = 0;
+
+    if (!vp9_guess_mv_telemetry_enabled() && !vp9_guess_mv_truth_enabled())
+        return 0;
+
+    va_start(args, format);
+    va_copy(args_copy, args);
+    required = vsnprintf(NULL, 0, format, args);
+    va_end(args);
+    if (required < 0) {
+        va_end(args_copy);
+        return AVERROR(EINVAL);
+    }
+
+    new_size = s->packet_loss_guess_mv_records_size + (size_t)required;
+    if (new_size + 1 > s->packet_loss_guess_mv_records_capacity) {
+        size_t new_capacity = s->packet_loss_guess_mv_records_capacity ?
+                              s->packet_loss_guess_mv_records_capacity * 2 : 4096;
+        char *resized = NULL;
+
+        while (new_capacity < new_size + 1)
+            new_capacity *= 2;
+        resized = av_realloc(s->packet_loss_guess_mv_records, new_capacity);
+        if (resized == NULL) {
+            va_end(args_copy);
+            return AVERROR(ENOMEM);
+        }
+        s->packet_loss_guess_mv_records = resized;
+        s->packet_loss_guess_mv_records_capacity = new_capacity;
+    }
+
+    vsnprintf(s->packet_loss_guess_mv_records +
+              s->packet_loss_guess_mv_records_size,
+              s->packet_loss_guess_mv_records_capacity -
+              s->packet_loss_guess_mv_records_size,
+              format, args_copy);
+    va_end(args_copy);
+    s->packet_loss_guess_mv_records_size = new_size;
+    return 0;
+}
+
+enum {
+    VP9_GUESS_MV_UNKNOWN = 0,
+    VP9_GUESS_MV_LISTED  = 1,
+    VP9_GUESS_MV_FIXED   = 2,
+};
+
+static int vp9_guess_mv_from_frame_cell(const VP9Context *s,
+                                        const VP9Frame *vp9_frame,
+                                        int mb_x, int mb_y,
+                                        int *mv_x, int *mv_y, int *ref_idx)
+{
+    const int block_col = FFMIN(mb_x * 2 + 1, (int)s->cols - 1);
+    const int block_row = FFMIN(mb_y * 2 + 1, (int)s->rows - 1);
+    const VP9mvrefPair *mv = NULL;
+
+    if (vp9_frame == NULL || vp9_frame->mv == NULL ||
+        s->cols <= 0 || s->rows <= 0 ||
+        block_col < 0 || block_row < 0)
+        return 0;
+
+    mv = &vp9_frame->mv[block_row * s->sb_cols * 8 + block_col];
+    if (mv->ref[0] >= 0) {
+        *mv_x = mv->mv[0].x;
+        *mv_y = mv->mv[0].y;
+        *ref_idx = mv->ref[0];
+        return 1;
+    }
+    if (mv->ref[1] >= 0) {
+        *mv_x = mv->mv[1].x;
+        *mv_y = mv->mv[1].y;
+        *ref_idx = mv->ref[1];
+        return 1;
+    }
+    return 0;
+}
+
+static int vp9_guess_mv_cell_is_damaged(const VP9Context *s, int mb_x, int mb_y)
+{
+    const int luma_x = mb_x * 16;
+    const int luma_y = mb_y * 16;
+    const int sb_x = luma_x >> 6;
+    const int sb_y = luma_y >> 6;
+
+    if (s->packet_loss_sb_damage == NULL ||
+        sb_x < 0 || sb_y < 0 ||
+        sb_x >= s->sb_cols || sb_y >= s->sb_rows)
+        return 0;
+
+    return !!s->packet_loss_sb_damage[sb_y * s->sb_cols + sb_x];
+}
+
+static void vp9_guess_mv_add_frontier_cell(uint8_t *state,
+                                           const uint8_t *damaged,
+                                           int *frontier,
+                                           int *frontier_length,
+                                           int mb_width, int mb_height,
+                                           int mb_x, int mb_y)
+{
+    int index;
+
+    if (mb_x < 0 || mb_y < 0 || mb_x >= mb_width || mb_y >= mb_height)
+        return;
+
+    index = mb_y * mb_width + mb_x;
+    if (!damaged[index] || state[index] != VP9_GUESS_MV_UNKNOWN)
+        return;
+
+    state[index] = VP9_GUESS_MV_LISTED;
+    frontier[(*frontier_length)++] = index;
+}
+
+static void vp9_guess_mv_add_frontier_neighbors(uint8_t *state,
+                                                const uint8_t *damaged,
+                                                int *frontier,
+                                                int *frontier_length,
+                                                int mb_width, int mb_height,
+                                                int index)
+{
+    const int mb_x = index % mb_width;
+    const int mb_y = index / mb_width;
+
+    vp9_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x - 1, mb_y);
+    vp9_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x + 1, mb_y);
+    vp9_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y - 1);
+    vp9_guess_mv_add_frontier_cell(state, damaged, frontier, frontier_length,
+                                   mb_width, mb_height, mb_x, mb_y + 1);
+}
+
+static int vp9_emit_guess_mv_truth_records(VP9Context *s)
+{
+    const VP9Frame *vp9_frame = &s->s.frames[CUR_FRAME];
+    const int mb_width = (vp9_visible_width(s) + 15) / 16;
+    const int mb_height = (vp9_visible_height(s) + 15) / 16;
+    int ret = 0;
+
+    if (vp9_frame->mv == NULL)
+        return 0;
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            int mv_x = 0;
+            int mv_y = 0;
+            int ref_idx = 0;
+
+            if (!vp9_guess_mv_from_frame_cell(s, vp9_frame, mb_x, mb_y,
+                                              &mv_x, &mv_y, &ref_idx))
+                continue;
+
+            ret = vp9_append_guess_mv_record(s, "%d,%d,%d,%d,%d,8\n",
+                                             mb_x, mb_y, mv_x, mv_y, ref_idx);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return 0;
+}
+
+static int vp9_emit_guess_mv_bfs_records(VP9Context *s)
+{
+    const VP9Frame *vp9_frame = &s->s.frames[CUR_FRAME];
+    const int mb_width = (vp9_visible_width(s) + 15) / 16;
+    const int mb_height = (vp9_visible_height(s) + 15) / 16;
+    const int cell_count = mb_width * mb_height;
+    uint8_t *state = NULL;
+    uint8_t *damaged = NULL;
+    int *mv_x = NULL;
+    int *mv_y = NULL;
+    int *ref_idx = NULL;
+    int *frontier = NULL;
+    int *next_frontier = NULL;
+    int *newly_fixed = NULL;
+    int frontier_length = 0;
+    int ret = 0;
+
+    if (vp9_frame->mv == NULL || cell_count <= 0)
+        return 0;
+
+    state = av_mallocz(cell_count);
+    damaged = av_mallocz(cell_count);
+    mv_x = av_malloc_array(cell_count, sizeof(*mv_x));
+    mv_y = av_malloc_array(cell_count, sizeof(*mv_y));
+    ref_idx = av_malloc_array(cell_count, sizeof(*ref_idx));
+    frontier = av_malloc_array(cell_count, sizeof(*frontier));
+    next_frontier = av_malloc_array(cell_count, sizeof(*next_frontier));
+    newly_fixed = av_malloc_array(cell_count, sizeof(*newly_fixed));
+    if (state == NULL || damaged == NULL || mv_x == NULL || mv_y == NULL ||
+        ref_idx == NULL || frontier == NULL || next_frontier == NULL ||
+        newly_fixed == NULL) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+
+    for (int mb_y = 0; mb_y < mb_height; mb_y++) {
+        for (int mb_x = 0; mb_x < mb_width; mb_x++) {
+            const int index = mb_y * mb_width + mb_x;
+
+            damaged[index] = vp9_guess_mv_cell_is_damaged(s, mb_x, mb_y);
+            if (!damaged[index] &&
+                vp9_guess_mv_from_frame_cell(s, vp9_frame, mb_x, mb_y,
+                                             &mv_x[index], &mv_y[index],
+                                             &ref_idx[index])) {
+                state[index] = VP9_GUESS_MV_FIXED;
+            }
+        }
+    }
+
+    for (int index = 0; index < cell_count; index++) {
+        if (state[index] == VP9_GUESS_MV_FIXED)
+            vp9_guess_mv_add_frontier_neighbors(state, damaged, frontier,
+                                                &frontier_length, mb_width,
+                                                mb_height, index);
+    }
+
+    for (int hop_count = 1; frontier_length > 0; hop_count++) {
+        int next_frontier_length = 0;
+        int newly_fixed_length = 0;
+
+        for (int frontier_index = 0; frontier_index < frontier_length; frontier_index++) {
+            const int index = frontier[frontier_index];
+            const int mb_x = index % mb_width;
+            const int mb_y = index / mb_width;
+            int pred_count = 0;
+            int sum_x = 0;
+            int sum_y = 0;
+            int sum_ref = 0;
+
+#define VP9_ACCUM_FIXED_MV(nx, ny) do {                                       \
+                const int neighbor_x = (nx);                                  \
+                const int neighbor_y = (ny);                                  \
+                if (neighbor_x >= 0 && neighbor_y >= 0 &&                     \
+                    neighbor_x < mb_width && neighbor_y < mb_height) {        \
+                    const int neighbor_index =                                \
+                        neighbor_y * mb_width + neighbor_x;                   \
+                    if (state[neighbor_index] == VP9_GUESS_MV_FIXED) {        \
+                        sum_x += mv_x[neighbor_index];                        \
+                        sum_y += mv_y[neighbor_index];                        \
+                        sum_ref += ref_idx[neighbor_index];                   \
+                        pred_count++;                                         \
+                    }                                                         \
+                }                                                             \
+            } while (0)
+
+            VP9_ACCUM_FIXED_MV(mb_x - 1, mb_y);
+            VP9_ACCUM_FIXED_MV(mb_x + 1, mb_y);
+            VP9_ACCUM_FIXED_MV(mb_x, mb_y - 1);
+            VP9_ACCUM_FIXED_MV(mb_x, mb_y + 1);
+#undef VP9_ACCUM_FIXED_MV
+
+            if (pred_count <= 0) {
+                state[index] = VP9_GUESS_MV_UNKNOWN;
+                continue;
+            }
+
+            mv_x[index] = sum_x / pred_count;
+            mv_y[index] = sum_y / pred_count;
+            ref_idx[index] = sum_ref / pred_count;
+            ret = vp9_append_guess_mv_record(s, "%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                                             mb_x, mb_y, hop_count, 0,
+                                             pred_count, mv_x[index],
+                                             mv_y[index], ref_idx[index], -1);
+            if (ret < 0)
+                goto done;
+
+            newly_fixed[newly_fixed_length++] = index;
+        }
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            state[newly_fixed[i]] = VP9_GUESS_MV_FIXED;
+
+        for (int i = 0; i < newly_fixed_length; i++)
+            vp9_guess_mv_add_frontier_neighbors(state, damaged, next_frontier,
+                                                &next_frontier_length, mb_width,
+                                                mb_height, newly_fixed[i]);
+
+        FFSWAP(int *, frontier, next_frontier);
+        frontier_length = next_frontier_length;
+    }
+
+done:
+    av_freep(&state);
+    av_freep(&damaged);
+    av_freep(&mv_x);
+    av_freep(&mv_y);
+    av_freep(&ref_idx);
+    av_freep(&frontier);
+    av_freep(&next_frontier);
+    av_freep(&newly_fixed);
+    return ret;
+}
+
+static int vp9_set_guess_mv_metadata(VP9Context *s, AVFrame *frame)
+{
+    int damaged_blocks = 0;
+    int ret = 0;
+
+    vp9_reset_guess_mv_records(s);
+    if (frame != NULL) {
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_records", NULL, 0);
+        av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records", NULL, 0);
+    }
+
+    if (frame == NULL || s->packet_loss_sb_damage == NULL)
+        return 0;
+
+    if (vp9_guess_mv_truth_enabled()) {
+        ret = vp9_emit_guess_mv_truth_records(s);
+        if (ret < 0)
+            return ret;
+        if (s->packet_loss_guess_mv_records != NULL &&
+            s->packet_loss_guess_mv_records_size > 0) {
+            av_dict_set(&frame->metadata, "packet_loss.guess_mv_truth_records",
+                        s->packet_loss_guess_mv_records, 0);
+        }
+        vp9_reset_guess_mv_records(s);
+    }
+
+    if (vp9_guess_mv_telemetry_enabled()) {
+        for (int i = 0; i < s->sb_cols * s->sb_rows; i++)
+            damaged_blocks += !!s->packet_loss_sb_damage[i];
+        if (damaged_blocks > 0) {
+            ret = vp9_emit_guess_mv_bfs_records(s);
+            if (ret < 0)
+                return ret;
+            if (s->packet_loss_guess_mv_records != NULL &&
+                s->packet_loss_guess_mv_records_size > 0) {
+                av_dict_set(&frame->metadata, "packet_loss.guess_mv_records",
+                            s->packet_loss_guess_mv_records, 0);
+            }
+        }
+    }
+
+    return 0;
+}
+
+static int vp9_parse_packet_loss_int64(const char *value, int64_t *parsed)
+{
+    char *end = NULL;
+    long long temporary;
+
+    if (!value || !value[0])
+        return 0;
+
+    temporary = strtoll(value, &end, 10);
+    if (end == value || *end != '\0')
+        return 0;
+
+    *parsed = temporary;
+    return 1;
+}
+
+static void vp9_update_packet_loss_range(VP9Context *s, const AVPacket *pkt)
+{
+    int64_t packet_pos = 0;
+    int64_t corrupt_packet_pos = 0;
+    int64_t corrupt_start = 0;
+    int64_t corrupt_end = 0;
+
+    s->packet_loss_packet_base = NULL;
+    s->packet_loss_corrupt_start = 0;
+    s->packet_loss_corrupt_end = 0;
+    s->packet_loss_corrupt_range_valid = 0;
+
+    if (!pkt || pkt->pos < 0 || !pkt->data)
+        return;
+
+    packet_pos = pkt->pos;
+    if (!vp9_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_PACKET_POS"), &corrupt_packet_pos) ||
+        !vp9_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_REL_START"), &corrupt_start) ||
+        !vp9_parse_packet_loss_int64(getenv("PACKET_LOSS_CORRUPT_REL_END"), &corrupt_end)) {
+        return;
+    }
+    if (corrupt_packet_pos != packet_pos ||
+        corrupt_start < 0 || corrupt_end <= corrupt_start ||
+        corrupt_start >= pkt->size) {
+        return;
+    }
+
+    s->packet_loss_packet_base = pkt->data;
+    s->packet_loss_corrupt_start = corrupt_start;
+    s->packet_loss_corrupt_end = FFMIN(corrupt_end, pkt->size);
+    s->packet_loss_corrupt_range_valid = 1;
+}
+
+static int vp9_packet_loss_reaches_sb(VP9Context *s, const VPXRangeCoder *c)
+{
+    int64_t consumed;
+
+    if (!s->packet_loss_corrupt_range_valid || !s->packet_loss_packet_base || !c)
+        return 0;
+
+    consumed = c->buffer - s->packet_loss_packet_base;
+    return consumed >= s->packet_loss_corrupt_start;
 }
 
