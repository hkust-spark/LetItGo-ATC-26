+static inline uint32_t av1_ec_mix32(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x7feb352dU;
+  value ^= value >> 15;
+  value *= 0x846ca68bU;
+  value ^= value >> 16;
+  return value;
+}
+
+static int av1_ec_pending_output_strength(const AV1Decoder *pbi,
+                                          uint32_t seed) {
+  const int position_q8 =
+      pbi->ec_pending_pkt_size
+          ? (int)AOMMIN((size_t)255,
+                        (pbi->ec_pending_zero_run_start * 255) /
+                            pbi->ec_pending_pkt_size)
+          : 0;
+  const int inverse_q8 = 255 - position_q8;
+  const int length_boost =
+      (int)AOMMIN((size_t)8, pbi->ec_pending_zero_run_length / 256);
+  const int curve_boost = (inverse_q8 * 8 + 127) / 255;
+  const int tail_boost = (position_q8 * 8 + 127) / 255;
+  const int hash_boost = (int)(av1_ec_mix32(seed) & 3);
+  return clamp(12 + curve_boost + tail_boost + length_boost + hash_boost, 14,
+               36);
+}
+
+static inline int av1_ec_output_degrade_pixel(int value, int neutral,
+                                              int max_value, int x, int y,
+                                              int plane, uint32_t seed,
+                                              int strength) {
+  strength = clamp(strength, 1, 48);
+  value = ((64 - strength) * value + strength * neutral + 32) >> 6;
+  if (plane == 0) {
+    const uint32_t hash =
+        av1_ec_mix32(seed ^ (uint32_t)(x * 0x1f123bb5U) ^
+                     (uint32_t)(y * 0x5f356495U));
+    if ((int)((hash >> 4) & 15) < AOMMIN(12, 2 + (strength >> 2))) {
+      value += (int)(hash & 3) - 1;
+    }
+  }
+  return clamp(value, 0, max_value);
+}
+
+static void av1_ec_apply_pending_plane_damage(YV12_BUFFER_CONFIG *const dst,
+                                              int plane, int x0, int y0,
+                                              int x1, int y1, uint32_t seed,
+                                              int strength) {
+  const int is_uv = plane > 0;
+  const int width = x1 - x0;
+  const int height = y1 - y0;
+  if (width <= 0 || height <= 0) return;
+
+  const int left = x0 > 0;
+  const int right = x1 < dst->crop_widths[is_uv];
+  const int top = y0 > 0;
+  const int bottom = y1 < dst->crop_heights[is_uv];
+
+  if (dst->flags & YV12_FLAG_HIGHBITDEPTH) {
+    const int bd = dst->bit_depth ? (int)dst->bit_depth : 8;
+    const int neutral = 1 << (bd - 1);
+    const int max_value = (1 << bd) - 1;
+    uint16_t *const base = CONVERT_TO_SHORTPTR(dst->buffers[plane]);
+    const uint16_t *const top_row =
+        top ? base + (y0 - 1) * dst->strides[is_uv] + x0 : NULL;
+    const uint16_t *const bottom_row =
+        bottom ? base + y1 * dst->strides[is_uv] + x0 : NULL;
+    for (int y = 0; y < height; ++y) {
+      uint16_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+      for (int x = 0; x < width; ++x) {
+        int sum = 0;
+        int weight = 0;
+        if (left) {
+          const int w = width - x;
+          sum += row[-1] * w;
+          weight += w;
+        }
+        if (right) {
+          const int w = x + 1;
+          sum += row[width] * w;
+          weight += w;
+        }
+        if (top) {
+          const int w = height - y;
+          sum += top_row[x] * w;
+          weight += w;
+        }
+        if (bottom) {
+          const int w = y + 1;
+          sum += bottom_row[x] * w;
+          weight += w;
+        }
+        const int predicted = weight > 0 ? (sum + (weight >> 1)) / weight
+                                         : neutral;
+        row[x] = (uint16_t)av1_ec_output_degrade_pixel(
+            predicted, neutral, max_value, x, y, plane, seed, strength);
+      }
+    }
+  } else {
+    uint8_t *const base = dst->buffers[plane];
+    const uint8_t *const top_row =
+        top ? base + (y0 - 1) * dst->strides[is_uv] + x0 : NULL;
+    const uint8_t *const bottom_row =
+        bottom ? base + y1 * dst->strides[is_uv] + x0 : NULL;
+    for (int y = 0; y < height; ++y) {
+      uint8_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+      for (int x = 0; x < width; ++x) {
+        int sum = 0;
+        int weight = 0;
+        if (left) {
+          const int w = width - x;
+          sum += row[-1] * w;
+          weight += w;
+        }
+        if (right) {
+          const int w = x + 1;
+          sum += row[width] * w;
+          weight += w;
+        }
+        if (top) {
+          const int w = height - y;
+          sum += top_row[x] * w;
+          weight += w;
+        }
+        if (bottom) {
+          const int w = y + 1;
+          sum += bottom_row[x] * w;
+          weight += w;
+        }
+        const int predicted = weight > 0 ? (sum + (weight >> 1)) / weight
+                                         : 128;
+        row[x] = (uint8_t)av1_ec_output_degrade_pixel(predicted, 128, 255, x,
+                                                      y, plane, seed,
+                                                      strength);
+      }
+    }
+  }
+}
+
+static void av1_ec_apply_pending_output_damage(AV1Decoder *pbi,
+                                               YV12_BUFFER_CONFIG *const dst) {
+  if (!pbi->error_concealment_enabled || !pbi->ec_pending_output_damage ||
+      dst == NULL) {
+    return;
+  }
+
+  AV1_COMMON *const cm = &pbi->common;
+  const int mib_size = cm->seq_params->mib_size;
+  const int sb_px = mib_size * MI_SIZE;
+  const int sb_cols =
+      AOMMAX(1, (cm->mi_params.mi_cols + mib_size - 1) / mib_size);
+  const int sb_rows =
+      AOMMAX(1, (cm->mi_params.mi_rows + mib_size - 1) / mib_size);
+  const int pending_mi_row =
+      clamp(pbi->ec_pending_mi_row, 0, cm->mi_params.mi_rows - 1);
+  const int pending_mi_col =
+      clamp(pbi->ec_pending_mi_col, 0, cm->mi_params.mi_cols - 1);
+  const int start_sb_row = clamp(pending_mi_row / mib_size, 0, sb_rows - 1);
+  const int start_sb_col = clamp(pending_mi_col / mib_size, 0, sb_cols - 1);
+  const uint32_t base_seed = av1_ec_mix32(
+      (uint32_t)pbi->ec_pending_zero_run_start ^
+      (uint32_t)(pbi->ec_pending_zero_run_length << 7) ^
+      (uint32_t)(pending_mi_row * 257 + pending_mi_col * 17));
+  const int sub_x = (int)(((base_seed >> 0) & 7) * sb_px) >> 5;
+  const int sub_y = (int)(((base_seed >> 3) & 3) * sb_px) >> 5;
+  const int start_x =
+      clamp(start_sb_col * sb_px + sub_x, 0, dst->y_crop_width);
+  const int start_y =
+      clamp(start_sb_row * sb_px + sub_y, 0, dst->y_crop_height);
+  if (start_x >= dst->y_crop_width || start_y >= dst->y_crop_height) {
+    pbi->ec_pending_output_damage = 0;
+    return;
+  }
+
+  const int num_planes = av1_num_planes(cm);
+  const int max_rows = AOMMAX(1, sb_rows - start_sb_row);
+  const int position_q8 =
+      pbi->ec_pending_pkt_size
+          ? (int)AOMMIN((size_t)255,
+                        (pbi->ec_pending_zero_run_start * 255) /
+                            pbi->ec_pending_pkt_size)
+          : 0;
+  const int inverse_q8 = 255 - position_q8;
+  const int span_q8 = 128 + ((inverse_q8 * 24 + 127) / 255);
+  const int row_span =
+      clamp(1 + (((max_rows - 1) * span_q8 + 127) / 255), 1, max_rows);
+  int damaged_rows = 0;
+  for (int sb_row = start_sb_row;
+       sb_row < AOMMIN(sb_rows, start_sb_row + row_span); ++sb_row) {
+    const int row_index = sb_row - start_sb_row;
+    const int row_x0 =
+        row_index == 0
+            ? start_x
+            : (int)((av1_ec_mix32(base_seed ^ (uint32_t)row_index) & 3) *
+                    sb_px) >>
+                  6;
+    const int row_y0 =
+        row_index == 0 ? start_y : clamp(sb_row * sb_px, 0, dst->y_crop_height);
+    const int row_y1 =
+        clamp((sb_row + 1) * sb_px, 0, dst->y_crop_height);
+    if (row_x0 >= dst->y_crop_width || row_y1 <= row_y0) continue;
+
+    const uint32_t row_seed = av1_ec_mix32(base_seed ^ (uint32_t)(row_index *
+                                                                  0x9e3779b9U));
+    const int strength =
+        AOMMIN(36, av1_ec_pending_output_strength(pbi, row_seed) +
+                       AOMMIN(row_index, 3));
+    for (int plane = 0; plane < num_planes; ++plane) {
+      const int ss_x = plane > 0 ? dst->subsampling_x : 0;
+      const int ss_y = plane > 0 ? dst->subsampling_y : 0;
+      const int is_uv = plane > 0;
+      const int plane_x0 = row_x0 >> ss_x;
+      const int plane_y0 = row_y0 >> ss_y;
+      const int plane_x1 = dst->crop_widths[is_uv];
+      const int plane_y1 =
+          AOMMIN((row_y1 + (1 << ss_y) - 1) >> ss_y,
+                 dst->crop_heights[is_uv]);
+      av1_ec_apply_pending_plane_damage(dst, plane, plane_x0, plane_y0,
+                                        plane_x1, plane_y1, row_seed,
+                                        strength);
+    }
+    ++damaged_rows;
+  }
+
+  dst->corrupted = 1;
+  pbi->ec_pending_output_damage = 0;
+  pbi->ec_path_directional_fill += damaged_rows;
+  pbi->ec_path_edge_fill += damaged_rows;
+}
+
+static int av1_ec_should_output_hidden_frame(const AV1Decoder *pbi) {
