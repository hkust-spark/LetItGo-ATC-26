+#define AV1_EC_MAX_MV_CANDIDATES 32
+#define AV1_EC_FORCED_ZERO_RUN_MIN 1024
+
+enum {
+  AV1_EC_PATH_NEIGHBOR_MV = 0,
+  AV1_EC_PATH_ZERO_MV = 1,
+  AV1_EC_PATH_GLOBAL_MV = 2,
+  AV1_EC_PATH_PREV_MV = 3,
+};
+
+typedef struct AV1EcMvCandidate {
+  const YV12_BUFFER_CONFIG *ref;
+  MV_REFERENCE_FRAME ref_frame;
+  MV mv;
+  int path;
+  unsigned int penalty;
+} AV1EcMvCandidate;
+
+static inline int av1_ec_mv_px(int mv_q3) {
+  return GET_MV_RAWPEL(mv_q3);
+}
+
+static inline unsigned int av1_ec_absdiff(int a, int b) {
+  return a > b ? (unsigned int)(a - b) : (unsigned int)(b - a);
+}
+
+static const MB_MODE_INFO *av1_ec_get_mi(const AV1_COMMON *const cm,
+                                         int mi_row, int mi_col) {
+  const CommonModeInfoParams *const mi_params = &cm->mi_params;
+  if (mi_row < 0 || mi_col < 0 || mi_row >= mi_params->mi_rows ||
+      mi_col >= mi_params->mi_cols) {
+    return NULL;
+  }
+  return mi_params->mi_grid_base[get_mi_grid_idx(mi_params, mi_row, mi_col)];
+}
+
+static const MB_MODE_INFO *av1_ec_get_known_mi(const AV1Decoder *pbi,
+                                               int mi_row, int mi_col) {
+  if (pbi->ec_mi_status != NULL &&
+      !av1_ec_status_is_known(av1_ec_mi_status_at(pbi, mi_row, mi_col))) {
+    return NULL;
+  }
+  return av1_ec_get_mi(&pbi->common, mi_row, mi_col);
+}
+
+static int av1_ec_add_mv_candidate(const AV1_COMMON *const cm,
+                                   AV1EcMvCandidate *candidates, int count,
+                                   MV_REFERENCE_FRAME ref_frame, MV mv,
+                                   int path, unsigned int penalty) {
+  if (count >= AV1_EC_MAX_MV_CANDIDATES) return count;
+  if (ref_frame <= INTRA_FRAME || ref_frame > ALTREF_FRAME) return count;
+
+  const YV12_BUFFER_CONFIG *const ref = av1_ec_get_ref_frame(cm, ref_frame);
+  if (ref == NULL) return count;
+
+  const int mv_row_px = av1_ec_mv_px(mv.row);
+  const int mv_col_px = av1_ec_mv_px(mv.col);
+  for (int i = 0; i < count; ++i) {
+    if (candidates[i].ref_frame == ref_frame &&
+        av1_ec_mv_px(candidates[i].mv.row) == mv_row_px &&
+        av1_ec_mv_px(candidates[i].mv.col) == mv_col_px) {
+      if (penalty < candidates[i].penalty) {
+        candidates[i].penalty = penalty;
+        candidates[i].path = path;
+      }
+      return count;
+    }
+  }
+
+  candidates[count].ref = ref;
+  candidates[count].ref_frame = ref_frame;
+  candidates[count].mv = mv;
+  candidates[count].path = path;
+  candidates[count].penalty = penalty;
+  return count + 1;
+}
+
+static int av1_ec_add_neighbor_mvs(const AV1Decoder *pbi,
+                                   AV1EcMvCandidate *candidates, int count,
+                                   int mi_row, int mi_col) {
+  const AV1_COMMON *const cm = &pbi->common;
+  const int step = cm->seq_params->mib_size;
+  static const int kOffsets[][3] = {
+    { 0, -1, 0 },    // left
+    { -1, 0, 0 },    // above
+    { -1, -1, 4 },   // above-left
+    { -1, 1, 6 },    // above-right
+    { 0, 1, 16 },    // right, if already known
+    { 1, 0, 16 },    // below, if already known
+  };
+
+  for (size_t i = 0; i < sizeof(kOffsets) / sizeof(kOffsets[0]); ++i) {
+    const int ref_mi_row = mi_row + kOffsets[i][0] * step;
+    const int ref_mi_col = mi_col + kOffsets[i][1] * step;
+    const MB_MODE_INFO *const mbmi =
+        av1_ec_get_known_mi(pbi, ref_mi_row, ref_mi_col);
+    if (mbmi == NULL || !is_inter_block(mbmi)) continue;
+
+    for (int ref = 0; ref < 2; ++ref) {
+      if (mbmi->ref_frame[ref] <= INTRA_FRAME) continue;
+      count = av1_ec_add_mv_candidate(cm, candidates, count,
+                                      mbmi->ref_frame[ref],
+                                      mbmi->mv[ref].as_mv,
+                                      AV1_EC_PATH_NEIGHBOR_MV,
+                                      (unsigned int)kOffsets[i][2]);
+    }
+  }
+
+  return count;
+}
+
+static int av1_ec_add_mvs_from_ref_buffer(const AV1_COMMON *const cm,
+                                          const RefCntBuffer *const ref_buf,
+                                          AV1EcMvCandidate *candidates,
+                                          int count, int mi_row, int mi_col,
+                                          unsigned int base_penalty) {
+  if (ref_buf == NULL || ref_buf->mvs == NULL || ref_buf->buf.corrupted)
+    return count;
+  if (ref_buf->mi_rows != cm->mi_params.mi_rows ||
+      ref_buf->mi_cols != cm->mi_params.mi_cols) {
+    return count;
+  }
+
+  const int mvs_cols = ROUND_POWER_OF_TWO(ref_buf->mi_cols, 1);
+  const int mvs_rows = ROUND_POWER_OF_TWO(ref_buf->mi_rows, 1);
+  const int mv_row = mi_row >> 1;
+  const int mv_col = mi_col >> 1;
+  static const int kOffsets[][3] = {
+    { 0, 0, 0 },    { 0, -1, 8 },  { -1, 0, 8 }, { 0, 1, 16 },
+    { 1, 0, 16 },   { -1, -1, 20 }, { -1, 1, 24 }, { 1, -1, 24 },
+  };
+
+  for (size_t i = 0; i < sizeof(kOffsets) / sizeof(kOffsets[0]); ++i) {
+    const int row = mv_row + kOffsets[i][0];
+    const int col = mv_col + kOffsets[i][1];
+    if (row < 0 || col < 0 || row >= mvs_rows || col >= mvs_cols) continue;
+
+    const MV_REF *const mv_ref = &ref_buf->mvs[row * mvs_cols + col];
+    if (mv_ref->ref_frame <= INTRA_FRAME || mv_ref->ref_frame > ALTREF_FRAME)
+      continue;
+
+    count = av1_ec_add_mv_candidate(cm, candidates, count, mv_ref->ref_frame,
+                                    mv_ref->mv.as_mv, AV1_EC_PATH_PREV_MV,
+                                    base_penalty +
+                                        (unsigned int)kOffsets[i][2]);
+  }
+
+  return count;
+}
+
+static int av1_ec_add_previous_mvs(const AV1_COMMON *const cm,
+                                   AV1EcMvCandidate *candidates, int count,
+                                   int mi_row, int mi_col) {
+  const RefCntBuffer *const last_buf = get_ref_frame_buf(cm, LAST_FRAME);
+  count = av1_ec_add_mvs_from_ref_buffer(cm, last_buf, candidates, count,
+                                         mi_row, mi_col, 8);
+  if (cm->prev_frame != last_buf) {
+    count = av1_ec_add_mvs_from_ref_buffer(cm, cm->prev_frame, candidates,
+                                           count, mi_row, mi_col, 16);
+  }
+  return count;
+}
+
+static int av1_ec_add_mean_mvs(const AV1_COMMON *const cm,
+                               AV1EcMvCandidate *candidates, int count,
+                               int initial_count) {
+  for (int ref_frame = LAST_FRAME; ref_frame <= ALTREF_FRAME; ++ref_frame) {
+    int sum_row = 0;
+    int sum_col = 0;
+    int samples = 0;
+    for (int i = 0; i < initial_count; ++i) {
+      if (candidates[i].ref_frame != ref_frame ||
+          candidates[i].path == AV1_EC_PATH_ZERO_MV ||
+          candidates[i].path == AV1_EC_PATH_GLOBAL_MV) {
+        continue;
+      }
+      sum_row += candidates[i].mv.row;
+      sum_col += candidates[i].mv.col;
+      ++samples;
+    }
+    if (samples < 2) continue;
+
+    MV mv;
+    mv.row = (int16_t)clamp((sum_row + samples / 2) / samples, MV_LOW + 1,
+                            MV_UPP - 1);
+    mv.col = (int16_t)clamp((sum_col + samples / 2) / samples, MV_LOW + 1,
+                            MV_UPP - 1);
+    count = av1_ec_add_mv_candidate(cm, candidates, count,
+                                    (MV_REFERENCE_FRAME)ref_frame, mv,
+                                    AV1_EC_PATH_NEIGHBOR_MV, 6);
+  }
+  return count;
+}
+
+static int av1_ec_add_default_mvs(const AV1_COMMON *const cm,
+                                  AV1EcMvCandidate *candidates, int count,
+                                  int mi_row, int mi_col) {
+  static const MV_REFERENCE_FRAME kRefs[] = {
+    LAST_FRAME,   GOLDEN_FRAME, ALTREF_FRAME, LAST2_FRAME,
+    LAST3_FRAME,  BWDREF_FRAME, ALTREF2_FRAME,
+  };
+
+  for (size_t i = 0; i < sizeof(kRefs) / sizeof(kRefs[0]); ++i) {
+    const MV_REFERENCE_FRAME ref_frame = kRefs[i];
+    MV zero_mv = kZeroMv;
+    count = av1_ec_add_mv_candidate(cm, candidates, count, ref_frame, zero_mv,
+                                    AV1_EC_PATH_ZERO_MV, 64);
+
+    if (cm->global_motion[ref_frame].wmtype != IDENTITY) {
+      const int_mv gm_mv = gm_get_motion_vector(
+          &cm->global_motion[ref_frame], cm->features.allow_high_precision_mv,
+          cm->seq_params->sb_size, mi_col, mi_row,
+          cm->features.cur_frame_force_integer_mv);
+      count = av1_ec_add_mv_candidate(cm, candidates, count, ref_frame,
+                                      gm_mv.as_mv, AV1_EC_PATH_GLOBAL_MV, 16);
+    }
+  }
+
+  return count;
+}
+
+static uint64_t av1_ec_score_candidate(const AV1Decoder *pbi,
+                                       const YV12_BUFFER_CONFIG *const dst,
+                                       const AV1EcMvCandidate *const cand,
+                                       int mi_row, int mi_col, int mi_width,
+                                       int mi_height, int x0, int y0, int x1,
+                                       int y1) {
+  const int width = x1 - x0;
+  const int height = y1 - y0;
+  if (width <= 0 || height <= 0) return UINT64_MAX;
+
+  const int left_known =
+      x0 > 0 &&
+      av1_ec_region_has_known_mi(pbi, mi_row, mi_col - 1, 1, mi_height);
+  const int right_known =
+      x1 < dst->y_crop_width &&
+      av1_ec_region_has_known_mi(pbi, mi_row, mi_col + mi_width, 1, mi_height);
+  const int top_known =
+      y0 > 0 &&
+      av1_ec_region_has_known_mi(pbi, mi_row - 1, mi_col, mi_width, 1);
+  const int bottom_known =
+      y1 < dst->y_crop_height &&
+      av1_ec_region_has_known_mi(pbi, mi_row + mi_height, mi_col, mi_width, 1);
+
+  const int mv_col = av1_ec_mv_px(cand->mv.col);
+  const int mv_row = av1_ec_mv_px(cand->mv.row);
+  const int ref_w = cand->ref->y_crop_width;
+  const int ref_h = cand->ref->y_crop_height;
+  uint64_t cost = cand->penalty;
+  unsigned int samples = 0;
+
+  if (dst->flags & YV12_FLAG_HIGHBITDEPTH) {
+    const uint16_t *const dst_base = CONVERT_TO_SHORTPTR(dst->y_buffer);
+    const uint16_t *const ref_base = CONVERT_TO_SHORTPTR(cand->ref->y_buffer);
+    if (left_known) {
+      for (int y = 0; y < height; ++y) {
+        const int src_y = clamp(y0 + y + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + mv_col, 0, ref_w - 1);
+        const uint16_t dst_px = dst_base[(y0 + y) * dst->y_stride + x0 - 1];
+        const uint16_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (right_known) {
+      for (int y = 0; y < height; ++y) {
+        const int src_y = clamp(y0 + y + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x1 - 1 + mv_col, 0, ref_w - 1);
+        const uint16_t dst_px = dst_base[(y0 + y) * dst->y_stride + x1];
+        const uint16_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (top_known) {
+      for (int x = 0; x < width; ++x) {
+        const int src_y = clamp(y0 + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + x + mv_col, 0, ref_w - 1);
+        const uint16_t dst_px = dst_base[(y0 - 1) * dst->y_stride + x0 + x];
+        const uint16_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (bottom_known) {
+      for (int x = 0; x < width; ++x) {
+        const int src_y = clamp(y1 - 1 + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + x + mv_col, 0, ref_w - 1);
+        const uint16_t dst_px = dst_base[y1 * dst->y_stride + x0 + x];
+        const uint16_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+  } else {
+    const uint8_t *const dst_base = dst->y_buffer;
+    const uint8_t *const ref_base = cand->ref->y_buffer;
+    if (left_known) {
+      for (int y = 0; y < height; ++y) {
+        const int src_y = clamp(y0 + y + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + mv_col, 0, ref_w - 1);
+        const uint8_t dst_px = dst_base[(y0 + y) * dst->y_stride + x0 - 1];
+        const uint8_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (right_known) {
+      for (int y = 0; y < height; ++y) {
+        const int src_y = clamp(y0 + y + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x1 - 1 + mv_col, 0, ref_w - 1);
+        const uint8_t dst_px = dst_base[(y0 + y) * dst->y_stride + x1];
+        const uint8_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (top_known) {
+      for (int x = 0; x < width; ++x) {
+        const int src_y = clamp(y0 + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + x + mv_col, 0, ref_w - 1);
+        const uint8_t dst_px = dst_base[(y0 - 1) * dst->y_stride + x0 + x];
+        const uint8_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+    if (bottom_known) {
+      for (int x = 0; x < width; ++x) {
+        const int src_y = clamp(y1 - 1 + mv_row, 0, ref_h - 1);
+        const int src_x = clamp(x0 + x + mv_col, 0, ref_w - 1);
+        const uint8_t dst_px = dst_base[y1 * dst->y_stride + x0 + x];
+        const uint8_t ref_px = ref_base[src_y * cand->ref->y_stride + src_x];
+        cost += av1_ec_absdiff(dst_px, ref_px);
+        ++samples;
+      }
+    }
+  }
+
+  return samples ? cost : cand->penalty;
+}
+
+static void av1_ec_fill_plane(YV12_BUFFER_CONFIG *const dst, int plane,
+                              int x0, int y0, int x1, int y1) {
+  const int is_uv = plane > 0;
+  const int width = x1 - x0;
+  const int height = y1 - y0;
+  if (width <= 0 || height <= 0) return;
+
+  if (dst->flags & YV12_FLAG_HIGHBITDEPTH) {
+    const int bd = dst->bit_depth ? (int)dst->bit_depth : 8;
+    const int neutral = 1 << (bd - 1);
+    uint16_t *const base = CONVERT_TO_SHORTPTR(dst->buffers[plane]);
+    for (int y = 0; y < height; ++y) {
+      aom_memset16(base + (y0 + y) * dst->strides[is_uv] + x0, neutral, width);
+    }
+  } else {
+    uint8_t *const base = dst->buffers[plane];
+    for (int y = 0; y < height; ++y) {
+      memset(base + (y0 + y) * dst->strides[is_uv] + x0, 128, width);
+    }
+  }
+}
+
+typedef struct AV1EcBoundaryAvailability {
+  int left;
+  int right;
+  int top;
+  int bottom;
+} AV1EcBoundaryAvailability;
+
+static AV1EcBoundaryAvailability av1_ec_get_boundary_availability(
+    const AV1Decoder *pbi, const YV12_BUFFER_CONFIG *const dst, int plane,
+    int mi_row, int mi_col, int mi_width, int mi_height, int x0, int y0,
+    int x1, int y1) {
+  const int is_uv = plane > 0;
+  AV1EcBoundaryAvailability avail = { 0, 0, 0, 0 };
+  avail.left =
+      x0 > 0 &&
+      av1_ec_region_has_known_mi(pbi, mi_row, mi_col - 1, 1, mi_height);
+  avail.right =
+      x1 < dst->crop_widths[is_uv] &&
+      av1_ec_region_has_known_mi(pbi, mi_row, mi_col + mi_width, 1, mi_height);
+  avail.top =
+      y0 > 0 &&
+      av1_ec_region_has_known_mi(pbi, mi_row - 1, mi_col, mi_width, 1);
+  avail.bottom =
+      y1 < dst->crop_heights[is_uv] &&
+      av1_ec_region_has_known_mi(pbi, mi_row + mi_height, mi_col, mi_width, 1);
+  return avail;
+}
+
+static inline int av1_ec_has_boundary(AV1EcBoundaryAvailability avail) {
+  return avail.left || avail.right || avail.top || avail.bottom;
+}
+
+static inline int av1_ec_iabs(int value) {
+  return value < 0 ? -value : value;
+}
+
+static inline uint32_t av1_ec_mix32(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x7feb352dU;
+  value ^= value >> 15;
+  value *= 0x846ca68bU;
+  value ^= value >> 16;
+  return value;
+}
+
+static int av1_ec_region_strength(const AV1Decoder *pbi, int mi_row,
+                                  int mi_col) {
+  const int position_q8 =
+      pbi->ec_pkt_size
+          ? (int)AOMMIN((size_t)255,
+                        (pbi->ec_zero_run_start * 255) / pbi->ec_pkt_size)
+          : 0;
+  const int inverse_q8 = 255 - position_q8;
+  const int length_boost =
+      (int)AOMMIN((size_t)8, pbi->ec_zero_run_length / 256);
+  const uint32_t seed = av1_ec_mix32((uint32_t)pbi->ec_zero_run_start ^
+                                    (uint32_t)(mi_row * 257 + mi_col * 17));
+  const int curve_boost = (inverse_q8 * 4 + 127) / 255;
+  const int tail_boost = (position_q8 * 8 + 127) / 255;
+  const int hash_boost = (int)(seed & 3);
+  return clamp(10 + curve_boost + tail_boost + length_boost + hash_boost, 12,
+               32);
+}
+
+static void av1_ec_get_directional_weights(const AV1EcMvCandidate *best,
+                                           int ss_x, int ss_y,
+                                           int *left_weight,
+                                           int *right_weight,
+                                           int *top_weight,
+                                           int *bottom_weight) {
+  *left_weight = 3;
+  *right_weight = 3;
+  *top_weight = 3;
+  *bottom_weight = 3;
+
+  if (best == NULL) {
+    *left_weight = 4;
+    *top_weight = 4;
+    return;
+  }
+
+  const int mv_col = av1_ec_mv_px(best->mv.col) / (1 << ss_x);
+  const int mv_row = av1_ec_mv_px(best->mv.row) / (1 << ss_y);
+  const int abs_col = av1_ec_iabs(mv_col);
+  const int abs_row = av1_ec_iabs(mv_row);
+  if (abs_col >= abs_row) {
+    if (mv_col >= 0)
+      *left_weight = 6;
+    else
+      *right_weight = 6;
+  } else {
+    if (mv_row >= 0)
+      *top_weight = 6;
+    else
+      *bottom_weight = 6;
+  }
+}
+
+static inline int av1_ec_degrade_pixel(int value, int neutral, int max_value,
+                                       int x, int y, int plane, int mi_row,
+                                       int mi_col, uint32_t seed,
+                                       int strength) {
+  strength = clamp(strength, 1, 48);
+  value = ((64 - strength) * value + strength * neutral + 32) >> 6;
+  if (plane == 0) {
+    const uint32_t hash =
+        av1_ec_mix32(seed ^ (uint32_t)(x * 0x1f123bb5U) ^
+                     (uint32_t)(y * 0x5f356495U) ^
+                     (uint32_t)(mi_row * 257 + mi_col * 17));
+    if ((int)((hash >> 4) & 15) < AOMMIN(12, 2 + (strength >> 2))) {
+      value += (int)(hash & 3) - 1;
+    }
+  }
+  return clamp(value, 0, max_value);
+}
+
+static void av1_ec_directional_fill_plane(
+    const AV1Decoder *pbi, YV12_BUFFER_CONFIG *const dst, int plane, int mi_row,
+    int mi_col, int mi_width, int mi_height, int x0, int y0, int x1, int y1,
+    const AV1EcMvCandidate *best) {
+  const int is_uv = plane > 0;
+  const int width = x1 - x0;
+  const int height = y1 - y0;
+  if (width <= 0 || height <= 0) return;
+
+  const AV1EcBoundaryAvailability avail = av1_ec_get_boundary_availability(
+      pbi, dst, plane, mi_row, mi_col, mi_width, mi_height, x0, y0, x1, y1);
+  if (!av1_ec_has_boundary(avail)) {
+    av1_ec_fill_plane(dst, plane, x0, y0, x1, y1);
+    return;
+  }
+
+  int left_base = 0;
+  int right_base = 0;
+  int top_base = 0;
+  int bottom_base = 0;
+  const int ss_x = plane > 0 ? dst->subsampling_x : 0;
+  const int ss_y = plane > 0 ? dst->subsampling_y : 0;
+  const int use_ref = best != NULL && best->ref != NULL;
+  const int mv_col = use_ref ? av1_ec_mv_px(best->mv.col) / (1 << ss_x) : 0;
+  const int mv_row = use_ref ? av1_ec_mv_px(best->mv.row) / (1 << ss_y) : 0;
+  av1_ec_get_directional_weights(best, ss_x, ss_y, &left_base, &right_base,
+                                 &top_base, &bottom_base);
+  const uint32_t seed =
+      av1_ec_mix32((uint32_t)pbi->ec_zero_run_start ^
+                   (uint32_t)(pbi->ec_zero_run_length << 7) ^
+                   (uint32_t)(mi_row * 257 + mi_col * 17));
+  const int strength = av1_ec_region_strength(pbi, mi_row, mi_col);
+
+  if (dst->flags & YV12_FLAG_HIGHBITDEPTH) {
+    const int bd = dst->bit_depth ? (int)dst->bit_depth : 8;
+    const int neutral = 1 << (bd - 1);
+    const int max_value = (1 << bd) - 1;
+    uint16_t *const base = CONVERT_TO_SHORTPTR(dst->buffers[plane]);
+    const uint16_t *const top =
+        avail.top ? base + (y0 - 1) * dst->strides[is_uv] + x0 : NULL;
+    const uint16_t *const bottom =
+        avail.bottom ? base + y1 * dst->strides[is_uv] + x0 : NULL;
+    const uint16_t *const ref_base =
+        use_ref ? CONVERT_TO_SHORTPTR(best->ref->buffers[plane]) : NULL;
+    const int ref_width = use_ref ? best->ref->crop_widths[is_uv] : 0;
+    const int ref_height = use_ref ? best->ref->crop_heights[is_uv] : 0;
+    const int ref_stride = use_ref ? best->ref->strides[is_uv] : 0;
+    for (int y = 0; y < height; ++y) {
+      uint16_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+      for (int x = 0; x < width; ++x) {
+        int sum = 0;
+        int weight = 0;
+        if (avail.left) {
+          const int w = left_base * (width - x);
+          sum += row[-1] * w;
+          weight += w;
+        }
+        if (avail.right) {
+          const int w = right_base * (x + 1);
+          sum += row[width] * w;
+          weight += w;
+        }
+        if (avail.top) {
+          const int w = top_base * (height - y);
+          sum += top[x] * w;
+          weight += w;
+        }
+        if (avail.bottom) {
+          const int w = bottom_base * (y + 1);
+          sum += bottom[x] * w;
+          weight += w;
+        }
+        int predicted = weight > 0 ? (sum + (weight >> 1)) / weight : neutral;
+        if (use_ref) {
+          const int ref_x = clamp(x0 + x + mv_col, 0, ref_width - 1);
+          const int ref_y = clamp(y0 + y + mv_row, 0, ref_height - 1);
+          const int ref_px = ref_base[ref_y * ref_stride + ref_x];
+          predicted =
+              weight > 0 ? (predicted + ref_px * 3 + 2) >> 2 : ref_px;
+        }
+        row[x] = (uint16_t)av1_ec_degrade_pixel(
+            predicted, neutral, max_value, x, y, plane, mi_row, mi_col, seed,
+            strength);
+      }
+    }
+  } else {
+    uint8_t *const base = dst->buffers[plane];
+    const uint8_t *const top =
+        avail.top ? base + (y0 - 1) * dst->strides[is_uv] + x0 : NULL;
+    const uint8_t *const bottom =
+        avail.bottom ? base + y1 * dst->strides[is_uv] + x0 : NULL;
+    const uint8_t *const ref_base = use_ref ? best->ref->buffers[plane] : NULL;
+    const int ref_width = use_ref ? best->ref->crop_widths[is_uv] : 0;
+    const int ref_height = use_ref ? best->ref->crop_heights[is_uv] : 0;
+    const int ref_stride = use_ref ? best->ref->strides[is_uv] : 0;
+    for (int y = 0; y < height; ++y) {
+      uint8_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+      for (int x = 0; x < width; ++x) {
+        int sum = 0;
+        int weight = 0;
+        if (avail.left) {
+          const int w = left_base * (width - x);
+          sum += row[-1] * w;
+          weight += w;
+        }
+        if (avail.right) {
+          const int w = right_base * (x + 1);
+          sum += row[width] * w;
+          weight += w;
+        }
+        if (avail.top) {
+          const int w = top_base * (height - y);
+          sum += top[x] * w;
+          weight += w;
+        }
+        if (avail.bottom) {
+          const int w = bottom_base * (y + 1);
+          sum += bottom[x] * w;
+          weight += w;
+        }
+        int predicted = weight > 0 ? (sum + (weight >> 1)) / weight : 128;
+        if (use_ref) {
+          const int ref_x = clamp(x0 + x + mv_col, 0, ref_width - 1);
+          const int ref_y = clamp(y0 + y + mv_row, 0, ref_height - 1);
+          const int ref_px = ref_base[ref_y * ref_stride + ref_x];
+          predicted =
+              weight > 0 ? (predicted + ref_px * 3 + 2) >> 2 : ref_px;
+        }
+        row[x] = (uint8_t)av1_ec_degrade_pixel(predicted, 128, 255, x, y,
+                                               plane, mi_row, mi_col, seed,
+                                               strength);
+      }
+    }
+  }
+}
+
+static void av1_ec_blend_plane_boundaries(const AV1Decoder *pbi,
+                                          YV12_BUFFER_CONFIG *const dst,
+                                          int plane, int mi_row, int mi_col,
+                                          int mi_width, int mi_height, int x0,
+                                          int y0, int x1, int y1) {
+  const int is_uv = plane > 0;
+  const int width = x1 - x0;
+  const int height = y1 - y0;
+  if (width <= 0 || height <= 0) return;
+
+  const AV1EcBoundaryAvailability avail = av1_ec_get_boundary_availability(
+      pbi, dst, plane, mi_row, mi_col, mi_width, mi_height, x0, y0, x1, y1);
+
+  if (dst->flags & YV12_FLAG_HIGHBITDEPTH) {
+    uint16_t *const base = CONVERT_TO_SHORTPTR(dst->buffers[plane]);
+    if (avail.left) {
+      for (int y = 0; y < height; ++y) {
+        uint16_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+        row[0] = (uint16_t)((3 * row[0] + row[-1] + 2) >> 2);
+      }
+    }
+    if (avail.right) {
+      for (int y = 0; y < height; ++y) {
+        uint16_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+        row[width - 1] =
+            (uint16_t)((3 * row[width - 1] + row[width] + 2) >> 2);
+      }
+    }
+    if (avail.top) {
+      uint16_t *const row = base + y0 * dst->strides[is_uv] + x0;
+      const uint16_t *const top = row - dst->strides[is_uv];
+      for (int x = 0; x < width; ++x) {
+        row[x] = (uint16_t)((3 * row[x] + top[x] + 2) >> 2);
+      }
+    }
+    if (avail.bottom) {
+      uint16_t *const row = base + (y1 - 1) * dst->strides[is_uv] + x0;
+      const uint16_t *const bottom = row + dst->strides[is_uv];
+      for (int x = 0; x < width; ++x) {
+        row[x] = (uint16_t)((3 * row[x] + bottom[x] + 2) >> 2);
+      }
+    }
+  } else {
+    uint8_t *const base = dst->buffers[plane];
+    if (avail.left) {
+      for (int y = 0; y < height; ++y) {
+        uint8_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+        row[0] = (uint8_t)((3 * row[0] + row[-1] + 2) >> 2);
+      }
+    }
+    if (avail.right) {
+      for (int y = 0; y < height; ++y) {
+        uint8_t *const row = base + (y0 + y) * dst->strides[is_uv] + x0;
+        row[width - 1] = (uint8_t)((3 * row[width - 1] + row[width] + 2) >> 2);
+      }
+    }
+    if (avail.top) {
+      uint8_t *const row = base + y0 * dst->strides[is_uv] + x0;
+      const uint8_t *const top = row - dst->strides[is_uv];
+      for (int x = 0; x < width; ++x) {
+        row[x] = (uint8_t)((3 * row[x] + top[x] + 2) >> 2);
+      }
+    }
+    if (avail.bottom) {
+      uint8_t *const row = base + (y1 - 1) * dst->strides[is_uv] + x0;
+      const uint8_t *const bottom = row + dst->strides[is_uv];
+      for (int x = 0; x < width; ++x) {
+        row[x] = (uint8_t)((3 * row[x] + bottom[x] + 2) >> 2);
+      }
+    }
+  }
+}
+
+static const AV1EcMvCandidate *av1_ec_pick_mv_candidate(
+    const AV1Decoder *pbi, AV1EcMvCandidate *candidates, int count, int mi_row,
+    int mi_col, int mi_width, int mi_height, int x0, int y0, int x1, int y1) {
+  const AV1_COMMON *const cm = &pbi->common;
+  if (cm->cur_frame == NULL || count <= 0) return NULL;
+
+  const YV12_BUFFER_CONFIG *const dst = &cm->cur_frame->buf;
+  const AV1EcMvCandidate *best = NULL;
+  uint64_t best_cost = UINT64_MAX;
+  for (int i = 0; i < count; ++i) {
+    const uint64_t cost = av1_ec_score_candidate(
+        pbi, dst, &candidates[i], mi_row, mi_col, mi_width, mi_height, x0, y0,
+        x1, y1);
+    if (cost < best_cost) {
+      best_cost = cost;
+      best = &candidates[i];
+    }
+  }
+  return best;
+}
+
+static BLOCK_SIZE av1_ec_get_region_bsize(int width, int height) {
+  for (int bsize = BLOCK_4X4; bsize < BLOCK_SIZES_ALL; ++bsize) {
+    if (block_size_wide[bsize] == width &&
+        block_size_high[bsize] == height) {
+      return (BLOCK_SIZE)bsize;
+    }
+  }
+  return BLOCK_INVALID;
+}
+
+static MB_MODE_INFO *av1_ec_store_concealed_mbmi(
+    AV1Decoder *pbi, DecoderCodingBlock *dcb, int mi_row, int mi_col,
+    BLOCK_SIZE bsize, const AV1EcMvCandidate *best) {
+  if (dcb == NULL || bsize == BLOCK_INVALID) return NULL;
+
+  AV1_COMMON *const cm = &pbi->common;
+  const int mi_width = mi_size_wide[bsize];
+  const int mi_height = mi_size_high[bsize];
+  const int x_mis = AOMMIN(mi_width, cm->mi_params.mi_cols - mi_col);
+  const int y_mis = AOMMIN(mi_height, cm->mi_params.mi_rows - mi_row);
+  if (x_mis <= 0 || y_mis <= 0) return NULL;
+
+  const int grid_idx = get_mi_grid_idx(&cm->mi_params, mi_row, mi_col);
+  MB_MODE_INFO *const base_mbmi = cm->mi_params.mi_grid_base[grid_idx];
+  if (base_mbmi == NULL) return NULL;
+
+  av1_zero(*base_mbmi);
+  MACROBLOCKD *const xd = &dcb->xd;
+  set_offsets(cm, xd, bsize, mi_row, mi_col, mi_width, mi_height, x_mis,
+              y_mis);
+
+  MB_MODE_INFO *const mbmi = xd->mi[0];
+  mbmi->bsize = bsize;
+  mbmi->partition = PARTITION_NONE;
+  mbmi->current_qindex = xd->current_base_qindex;
+  mbmi->skip_txfm = 1;
+  mbmi->tx_size = max_txsize_rect_lookup[bsize];
+  memset(mbmi->inter_tx_size, mbmi->tx_size, sizeof(mbmi->inter_tx_size));
+  mbmi->interinter_comp.type = COMPOUND_AVERAGE;
+  mbmi->motion_mode = SIMPLE_TRANSLATION;
+
+  if (best != NULL) {
+    mbmi->mode = NEWMV;
+    mbmi->ref_frame[0] = best->ref_frame;
+    mbmi->ref_frame[1] = NONE_FRAME;
+    mbmi->mv[0].as_mv = best->mv;
+    mbmi->mv[1].as_int = 0;
+    set_default_interp_filters(mbmi, cm->features.interp_filter);
+    if (cm->cur_frame != NULL && cm->cur_frame->mvs != NULL) {
+      av1_copy_frame_mvs(cm, mbmi, mi_row, mi_col, x_mis, y_mis);
+    }
+  } else {
+    mbmi->mode = DC_PRED;
+    mbmi->uv_mode = UV_DC_PRED;
+    mbmi->ref_frame[0] = INTRA_FRAME;
+    mbmi->ref_frame[1] = NONE_FRAME;
+    mbmi->mv[0].as_int = 0;
+    mbmi->mv[1].as_int = 0;
+  }
+
+  av1_reset_entropy_context(xd, bsize, av1_num_planes(cm));
+  return mbmi;
+}
+
+static void av1_ec_copy_or_fill_region(AV1Decoder *pbi, DecoderCodingBlock *dcb,
+                                       int mi_row, int mi_col, int x, int y,
+                                       int width, int height,
+                                       int use_reference) {
+  AV1_COMMON *const cm = &pbi->common;
+  if (cm->cur_frame == NULL) return;
+
+  YV12_BUFFER_CONFIG *const dst = &cm->cur_frame->buf;
+  const int x0 = clamp(x, 0, dst->y_crop_width);
+  const int y0 = clamp(y, 0, dst->y_crop_height);
+  const int x1 = clamp(x + width, 0, dst->y_crop_width);
+  const int y1 = clamp(y + height, 0, dst->y_crop_height);
+  if (x1 <= x0 || y1 <= y0) return;
+
+  const int mib_size = cm->seq_params->mib_size;
+  const int mi_width = AOMMIN(mib_size, cm->mi_params.mi_cols - mi_col);
+  const int mi_height = AOMMIN(mib_size, cm->mi_params.mi_rows - mi_row);
+  av1_ec_mark_mi_region(pbi, mi_row, mi_col, mi_width, mi_height,
+                        AV1_EC_MI_DAMAGED);
+
+  AV1EcMvCandidate candidates[AV1_EC_MAX_MV_CANDIDATES];
+  int candidate_count = 0;
+  const AV1EcMvCandidate *best = NULL;
+  if (use_reference) {
+    candidate_count = av1_ec_add_neighbor_mvs(pbi, candidates, candidate_count,
+                                              mi_row, mi_col);
+    candidate_count = av1_ec_add_previous_mvs(cm, candidates, candidate_count,
+                                              mi_row, mi_col);
+    candidate_count =
+        av1_ec_add_mean_mvs(cm, candidates, candidate_count, candidate_count);
+    candidate_count =
+        av1_ec_add_default_mvs(cm, candidates, candidate_count, mi_row, mi_col);
+    best = av1_ec_pick_mv_candidate(pbi, candidates, candidate_count, mi_row,
+                                    mi_col, mi_width, mi_height, x0, y0, x1,
+                                    y1);
+  }
+
+  const BLOCK_SIZE bsize = av1_ec_get_region_bsize(width, height);
+  av1_ec_store_concealed_mbmi(pbi, dcb, mi_row, mi_col, bsize, best);
+
+  const int num_planes = av1_num_planes(cm);
+  for (int plane = 0; plane < num_planes; ++plane) {
+    const int ss_x = plane > 0 ? dst->subsampling_x : 0;
+    const int ss_y = plane > 0 ? dst->subsampling_y : 0;
+    const int is_uv = plane > 0;
+    const int plane_x0 = x0 >> ss_x;
+    const int plane_y0 = y0 >> ss_y;
+    const int plane_x1 =
+        AOMMIN((x1 + (1 << ss_x) - 1) >> ss_x, dst->crop_widths[is_uv]);
+    const int plane_y1 =
+        AOMMIN((y1 + (1 << ss_y) - 1) >> ss_y, dst->crop_heights[is_uv]);
+    av1_ec_directional_fill_plane(pbi, dst, plane, mi_row, mi_col, mi_width,
+                                  mi_height, plane_x0, plane_y0, plane_x1,
+                                  plane_y1, best);
+    av1_ec_blend_plane_boundaries(pbi, dst, plane, mi_row, mi_col, mi_width,
+                                  mi_height, plane_x0, plane_y0, plane_x1,
+                                  plane_y1);
+  }
+
+  ++pbi->ec_path_directional_fill;
+  if (best != NULL) {
+    ++pbi->ec_path_degraded_mv_hint;
+    if (best->path == AV1_EC_PATH_GLOBAL_MV) {
+      ++pbi->ec_path_global_mv;
+    } else if (best->path == AV1_EC_PATH_ZERO_MV) {
+      ++pbi->ec_path_zero_mv;
+    } else if (best->path == AV1_EC_PATH_PREV_MV) {
+      ++pbi->ec_path_prev_mv;
+    } else {
+      ++pbi->ec_path_mv;
+    }
+  } else {
+    if (x0 == 0 && y0 == 0 && av1_ec_find_ref_frame(cm) == NULL)
+      ++pbi->ec_path_gray;
+    else
+      ++pbi->ec_path_edge_fill;
+  }
+
+  av1_ec_mark_mi_region(pbi, mi_row, mi_col, mi_width, mi_height,
+                        AV1_EC_MI_CONCEALED);
+}
+
+static void av1_ec_conceal_tile_suffix(AV1Decoder *pbi, DecoderCodingBlock *dcb,
+                                       int tile_row, int tile_col, int mi_row,
+                                       int mi_col, int use_reference) {
+  AV1_COMMON *const cm = &pbi->common;
+  TileInfo tile_info;
+  av1_tile_set_row(&tile_info, cm, tile_row);
+  av1_tile_set_col(&tile_info, cm, tile_col);
+
+  mi_row =
+      av1_ec_align_mi_to_sb(cm, mi_row, tile_info.mi_row_start,
+                            tile_info.mi_row_end);
+  mi_col =
+      av1_ec_align_mi_to_sb(cm, mi_col, tile_info.mi_col_start,
+                            tile_info.mi_col_end);
+
+  const int mib_size = cm->seq_params->mib_size;
+  for (int row = mi_row; row < tile_info.mi_row_end; row += mib_size) {
+    const int start_col = row == mi_row ? mi_col : tile_info.mi_col_start;
+    if (start_col >= tile_info.mi_col_end) continue;
+    for (int col = start_col; col < tile_info.mi_col_end; col += mib_size) {
+      const int x = col * MI_SIZE;
+      const int y = row * MI_SIZE;
+      const int width = AOMMIN(mib_size, tile_info.mi_col_end - col) * MI_SIZE;
+      const int height =
+          AOMMIN(mib_size, tile_info.mi_row_end - row) * MI_SIZE;
+      av1_ec_copy_or_fill_region(pbi, dcb, row, col, x, y, width, height,
+                                 use_reference);
+      ++pbi->ec_concealed_sbs;
+    }
+  }
+
+  pbi->ec_active = 1;
+  aom_merge_corrupted_flag(&pbi->dcb.corrupted, 1);
+  if (cm->cur_frame != NULL) cm->cur_frame->buf.corrupted = 1;
+}
+
+static int av1_ec_should_force_loss_region(const AV1Decoder *pbi) {
+  return pbi->error_concealment_enabled && !pbi->ec_active &&
+         pbi->ec_zero_run_found &&
+         pbi->ec_zero_run_length >= AV1_EC_FORCED_ZERO_RUN_MIN &&
+         pbi->ec_est_tile_row >= 0 && pbi->ec_est_tile_col >= 0 &&
+         av1_ec_find_ref_frame(&pbi->common) != NULL;
+}
+
+static void av1_ec_setup_concealment_dcb(AV1Decoder *pbi, ThreadData *td,
+                                         int tile_row, int tile_col) {
+  AV1_COMMON *const cm = &pbi->common;
+  CommonTileParams *const tiles = &cm->tiles;
+  TileDataDec *const tile_data =
+      pbi->tile_data + tile_row * tiles->cols + tile_col;
+
+  td->dcb.corrupted = 0;
+  av1_tile_init(&td->dcb.xd.tile, cm, tile_row, tile_col);
+  td->dcb.xd.current_base_qindex = cm->quant_params.base_qindex;
+  av1_init_macroblockd(cm, &td->dcb.xd);
+  av1_init_above_context(&cm->above_contexts, av1_num_planes(cm), tile_row,
+                         &td->dcb.xd);
+  tile_data->tctx = *cm->fc;
+  td->dcb.xd.tile_ctx = &tile_data->tctx;
+}
+
+static void av1_ec_force_loss_region(AV1Decoder *pbi, ThreadData *td,
+                                     int start_tile, int end_tile,
+                                     int tile_rows_start, int tile_rows_end,
+                                     int tile_cols_start, int tile_cols_end) {
+  if (!av1_ec_should_force_loss_region(pbi)) return;
+
+  AV1_COMMON *const cm = &pbi->common;
+  CommonTileParams *const tiles = &cm->tiles;
+  const int tile_row = pbi->ec_est_tile_row;
+  const int tile_col = pbi->ec_est_tile_col;
+  const int tile = tile_row * tiles->cols + tile_col;
+  if (tile_row < tile_rows_start || tile_row >= tile_rows_end ||
+      tile_col < tile_cols_start || tile_col >= tile_cols_end ||
+      tile < start_tile || tile > end_tile) {
+    return;
+  }
+
+  av1_ec_setup_concealment_dcb(pbi, td, tile_row, tile_col);
+  av1_ec_record_damage(pbi, tile_row, tile_col, pbi->ec_est_mi_row,
+                       pbi->ec_est_mi_col);
+  av1_ec_conceal_tile_suffix(pbi, &td->dcb, tile_row, tile_col,
+                             pbi->ec_est_mi_row, pbi->ec_est_mi_col, 1);
+}
+
+static void av1_ec_record_damage(AV1Decoder *pbi, int tile_row, int tile_col,
+                                 int mi_row, int mi_col) {
+  if (pbi->ec_damage_tile_row >= 0) return;
+  pbi->ec_damage_tile_row = tile_row;
+  pbi->ec_damage_tile_col = tile_col;
+  pbi->ec_damage_mi_row = mi_row;
+  pbi->ec_damage_mi_col = mi_col;
+}
+
+static void av1_ec_set_estimated_sb(AV1Decoder *pbi, int tile_row, int tile_col,
+                                    double tile_fraction) {
+  AV1_COMMON *const cm = &pbi->common;
+  TileInfo tile_info;
+  av1_tile_set_row(&tile_info, cm, tile_row);
+  av1_tile_set_col(&tile_info, cm, tile_col);
+
+  const int sb_rows = AOMMAX(1, av1_get_sb_rows_in_tile(cm, &tile_info));
+  const int sb_cols = AOMMAX(1, av1_get_sb_cols_in_tile(cm, &tile_info));
+  const int sb_count = sb_rows * sb_cols;
+  const int sb_index =
+      clamp((int)(tile_fraction * sb_count), 0, sb_count - 1);
+  int sb_row = sb_index / sb_cols;
+  int sb_col = sb_index % sb_cols;
+  if (tile_fraction > 0.72 && tile_fraction < 0.94 && sb_row > 0) --sb_row;
+  const int mib_size = cm->seq_params->mib_size;
+
+  pbi->ec_est_tile_row = tile_row;
+  pbi->ec_est_tile_col = tile_col;
+  pbi->ec_est_mi_row =
+      AOMMIN(tile_info.mi_row_start + sb_row * mib_size,
+             tile_info.mi_row_end - 1);
+  pbi->ec_est_mi_col =
+      AOMMIN(tile_info.mi_col_start + sb_col * mib_size,
+             tile_info.mi_col_end - 1);
+}
+
+static void av1_ec_estimate_tile_damage(
+    AV1Decoder *pbi, TileBufferDec (*const tile_buffers)[MAX_TILE_COLS],
+    int start_tile, int end_tile) {
+  if (!pbi->error_concealment_enabled || !pbi->ec_zero_run_found ||
+      pbi->ec_pkt_data == NULL || pbi->ec_pkt_size == 0) {
+    return;
+  }
+
+  AV1_COMMON *const cm = &pbi->common;
+  CommonTileParams *const tiles = &cm->tiles;
+  const uintptr_t zero_pos =
+      (uintptr_t)(pbi->ec_pkt_data + pbi->ec_zero_run_start);
+
+  for (int tile = start_tile; tile <= end_tile; ++tile) {
+    const int row = tile / tiles->cols;
+    const int col = tile % tiles->cols;
+    const TileBufferDec *const buf = &tile_buffers[row][col];
+    if (buf->data == NULL || buf->size == 0) continue;
+
+    const uintptr_t tile_start = (uintptr_t)buf->data;
+    const uintptr_t tile_end = tile_start + buf->size;
+    if (zero_pos >= tile_start && zero_pos < tile_end) {
+      const double tile_fraction =
+          (double)(zero_pos - tile_start) / (double)buf->size;
+      av1_ec_set_estimated_sb(pbi, row, col, tile_fraction);
+      return;
+    }
+  }
+
+  const int tile_count = end_tile - start_tile + 1;
+  if (tile_count <= 0) return;
+  const double packet_fraction =
+      (double)pbi->ec_zero_run_start / (double)pbi->ec_pkt_size;
+  const double scaled = packet_fraction * tile_count;
+  const int tile_offset = clamp((int)scaled, 0, tile_count - 1);
+  const int tile = start_tile + tile_offset;
+  const double tile_fraction = scaled - tile_offset;
+  av1_ec_set_estimated_sb(pbi, tile / tiles->cols, tile % tiles->cols,
+                          tile_fraction);
+}
+
+static void av1_ec_choose_damage_sb(AV1Decoder *pbi, int tile_row,
+                                    int tile_col, int *mi_row, int *mi_col) {
+  AV1_COMMON *const cm = &pbi->common;
+  TileInfo tile_info;
+  av1_tile_set_row(&tile_info, cm, tile_row);
+  av1_tile_set_col(&tile_info, cm, tile_col);
+
+  if (pbi->ec_est_tile_row == tile_row && pbi->ec_est_tile_col == tile_col) {
+    *mi_row = pbi->ec_est_mi_row;
+    *mi_col = pbi->ec_est_mi_col;
+  } else if (pbi->ec_cur_tile_row == tile_row &&
+             pbi->ec_cur_tile_col == tile_col) {
+    *mi_row = pbi->ec_cur_mi_row;
+    *mi_col = pbi->ec_cur_mi_col;
+  } else {
+    *mi_row = tile_info.mi_row_start;
+    *mi_col = tile_info.mi_col_start;
+  }
+
+  *mi_row =
+      av1_ec_align_mi_to_sb(cm, *mi_row, tile_info.mi_row_start,
+                            tile_info.mi_row_end);
+  *mi_col =
+      av1_ec_align_mi_to_sb(cm, *mi_col, tile_info.mi_col_start,
+                            tile_info.mi_col_end);
+}
