+static void av1_ec_find_zero_run(const uint8_t *source, size_t size,
+                                 int *found, size_t *start, size_t *length) {
+  *found = 0;
+  *start = 0;
+  *length = 0;
+  if (source == NULL || size == 0) return;
+
+  size_t best_start = 0;
+  size_t best_len = 0;
+  for (size_t i = 0; i < size;) {
+    if (source[i] != 0) {
+      ++i;
+      continue;
+    }
+
+    const size_t run_start = i;
+    while (i < size && source[i] == 0) ++i;
+    if (i - run_start > best_len) {
+      best_start = run_start;
+      best_len = i - run_start;
+    }
+  }
+
+  if (best_len >= 64) {
+    *found = 1;
+    *start = best_start;
+    *length = best_len;
+  }
+}
