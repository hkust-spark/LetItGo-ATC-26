+static inline int av1_ec_align_mi_to_sb(const AV1_COMMON *const cm,
+                                        const int mi, const int mi_start,
+                                        const int mi_end) {
+  const int mib_size = cm->seq_params->mib_size;
+  const int clipped = clamp(mi, mi_start, mi_end - 1);
+  return mi_start + ((clipped - mi_start) / mib_size) * mib_size;
+}
