+static int av1_ec_ref_matches_cur(const YV12_BUFFER_CONFIG *const cur,
+                                  const YV12_BUFFER_CONFIG *const ref) {
+  return ref->y_crop_width == cur->y_crop_width &&
+         ref->y_crop_height == cur->y_crop_height &&
+         ref->uv_crop_width == cur->uv_crop_width &&
+         ref->uv_crop_height == cur->uv_crop_height &&
+         ref->subsampling_x == cur->subsampling_x &&
+         ref->subsampling_y == cur->subsampling_y &&
+         ref->bit_depth == cur->bit_depth &&
+         !((ref->flags ^ cur->flags) & YV12_FLAG_HIGHBITDEPTH);
+}
+
+static const YV12_BUFFER_CONFIG *av1_ec_get_ref_frame(
+    const AV1_COMMON *const cm, MV_REFERENCE_FRAME frame) {
+  if (cm->cur_frame == NULL) return NULL;
+
+  const RefCntBuffer *const ref_buf = get_ref_frame_buf(cm, frame);
+  if (ref_buf == NULL || ref_buf->buf.corrupted) return NULL;
+
+  const YV12_BUFFER_CONFIG *const cur = &cm->cur_frame->buf;
+  const YV12_BUFFER_CONFIG *const ref = &ref_buf->buf;
+  return av1_ec_ref_matches_cur(cur, ref) ? ref : NULL;
+}
+
+static const YV12_BUFFER_CONFIG *av1_ec_find_ref_frame(
+    const AV1_COMMON *const cm) {
+  if (cm->cur_frame == NULL) return NULL;
+
+  for (int frame = LAST_FRAME; frame <= ALTREF_FRAME; ++frame) {
+    const YV12_BUFFER_CONFIG *const ref =
+        av1_ec_get_ref_frame(cm, (MV_REFERENCE_FRAME)frame);
+    if (ref != NULL) return ref;
+  }
+  return NULL;
+}
