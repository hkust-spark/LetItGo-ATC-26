+static inline void av1_ec_note_sb(AV1Decoder *pbi, int tile_row, int tile_col,
+                                  int mi_row, int mi_col) {
+  if (!pbi->error_concealment_enabled) return;
+  pbi->ec_cur_tile_row = tile_row;
+  pbi->ec_cur_tile_col = tile_col;
+  pbi->ec_cur_mi_row = mi_row;
+  pbi->ec_cur_mi_col = mi_col;
+}
