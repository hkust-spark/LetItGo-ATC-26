+static void av1_ec_ensure_mi_status_map(AV1Decoder *pbi) {
+  if (!pbi->error_concealment_enabled) return;
+
+  AV1_COMMON *const cm = &pbi->common;
+  const int rows = cm->mi_params.mi_rows;
+  const int cols = cm->mi_params.mi_cols;
+  const int required_size = rows * cols;
+  if (required_size <= 0) return;
+
+  if (pbi->ec_mi_status_alloc_size < required_size) {
+    aom_free(pbi->ec_mi_status);
+    CHECK_MEM_ERROR(cm, pbi->ec_mi_status,
+                    (uint8_t *)aom_malloc(required_size));
+    pbi->ec_mi_status_alloc_size = required_size;
+  }
+
+  pbi->ec_mi_status_rows = rows;
+  pbi->ec_mi_status_cols = cols;
+  memset(pbi->ec_mi_status, AV1_EC_MI_UNKNOWN, required_size);
+}
+
+static void av1_ec_mark_mi_region(AV1Decoder *pbi, int mi_row, int mi_col,
+                                  int mi_width, int mi_height, uint8_t status) {
+  if (!pbi->error_concealment_enabled || pbi->ec_mi_status == NULL) return;
+
+  const int row0 = clamp(mi_row, 0, pbi->ec_mi_status_rows);
+  const int col0 = clamp(mi_col, 0, pbi->ec_mi_status_cols);
+  const int row1 = clamp(mi_row + mi_height, 0, pbi->ec_mi_status_rows);
+  const int col1 = clamp(mi_col + mi_width, 0, pbi->ec_mi_status_cols);
+  if (row1 <= row0 || col1 <= col0) return;
+
+  for (int row = row0; row < row1; ++row) {
+    memset(pbi->ec_mi_status + row * pbi->ec_mi_status_cols + col0, status,
+           col1 - col0);
+  }
+}
+
+static inline uint8_t av1_ec_mi_status_at(const AV1Decoder *pbi, int mi_row,
+                                          int mi_col) {
+  if (pbi->ec_mi_status == NULL || mi_row < 0 || mi_col < 0 ||
+      mi_row >= pbi->ec_mi_status_rows || mi_col >= pbi->ec_mi_status_cols) {
+    return AV1_EC_MI_UNKNOWN;
+  }
+  return pbi->ec_mi_status[mi_row * pbi->ec_mi_status_cols + mi_col];
+}
+
+static inline int av1_ec_status_is_known(uint8_t status) {
+  return status == AV1_EC_MI_CLEAN || status == AV1_EC_MI_CONCEALED;
+}
+
+static int av1_ec_region_has_known_mi(const AV1Decoder *pbi, int mi_row,
+                                      int mi_col, int mi_width,
+                                      int mi_height) {
+  if (pbi->ec_mi_status == NULL) return 1;
+
+  const int row0 = clamp(mi_row, 0, pbi->ec_mi_status_rows);
+  const int col0 = clamp(mi_col, 0, pbi->ec_mi_status_cols);
+  const int row1 = clamp(mi_row + mi_height, 0, pbi->ec_mi_status_rows);
+  const int col1 = clamp(mi_col + mi_width, 0, pbi->ec_mi_status_cols);
+  if (row1 <= row0 || col1 <= col0) return 0;
+
+  for (int row = row0; row < row1; ++row) {
+    const uint8_t *const status =
+        pbi->ec_mi_status + row * pbi->ec_mi_status_cols + col0;
+    for (int col = 0; col < col1 - col0; ++col) {
+      if (av1_ec_status_is_known(status[col])) return 1;
+    }
+  }
+  return 0;
+}
