+    pbi->ec_pending_mi_row = pbi->ec_est_mi_row;
+    pbi->ec_pending_mi_col = pbi->ec_est_mi_col;
+  } else {
+    pbi->ec_pending_mi_row = 0;
+    pbi->ec_pending_mi_col = 0;
+  }
+  pbi->ec_pending_zero_run_start = pbi->ec_zero_run_start;
